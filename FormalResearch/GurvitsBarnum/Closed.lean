module

public import FormalResearch.GurvitsBarnum.Basic
public import FormalResearch.ConvexGeometry.ClosedHull

/-!
# The separable cone is closed (plan lemma D1)

Source: L. Gurvits and H. Barnum, *Largest separable balls around the maximally mixed bipartite
quantum state*, Phys. Rev. A 66, 062311 (2002); plan lemma D1.

`IsSeparable` is the cone generated by the compact set `K0` of unit product rank-ones, all with
`Re tr = 1`.  Every separable matrix is `s • h` with `s ≥ 0`, `h ∈ conv K0`; `conv K0` is compact
(`isCompact_convexHull_of_isCompact`), and the trace bounds `s`, whence closedness.
The topology on `Matrix` is Mathlib's global (Pi) topology instance.
-/

@[expose] public section


namespace FormalResearch.GurvitsBarnum

set_option linter.unusedSectionVars false

open Matrix Set

noncomputable section

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- Real part of the trace. -/
def trRe (X : Matrix (ι × κ) (ι × κ) ℂ) : ℝ := (trace X).re

theorem trRe_add (X Y : Matrix (ι × κ) (ι × κ) ℂ) : trRe (X + Y) = trRe X + trRe Y := by
  simp [trRe, trace_add]

theorem trRe_smul (r : ℝ) (X : Matrix (ι × κ) (ι × κ) ℂ) : trRe (r • X) = r * trRe X := by
  simp [trRe, trace_smul]

theorem continuous_trRe : Continuous (trRe : Matrix (ι × κ) (ι × κ) ℂ → ℝ) := by
  unfold trRe trace
  refine Complex.continuous_re.comp (continuous_finsetSum _ fun p _ => ?_)
  exact continuous_id.matrix_elem p p

theorem continuous_prodRankOne :
    Continuous fun p : (ι → ℂ) × (κ → ℂ) => prodRankOne p.1 p.2 := by
  refine continuous_matrix fun ⟨i, k⟩ ⟨j, l⟩ => ?_
  simp only [prodRankOne, kronecker_apply, vecMulVec_apply, Pi.star_apply]
  fun_prop

theorem prodRankOne_smul_smul (r t : ℝ) (a : ι → ℂ) (b : κ → ℂ) :
    prodRankOne (r • a) (t • b) = (r ^ 2 * t ^ 2) • prodRankOne a b := by
  ext ⟨p, k⟩ ⟨q, l⟩
  simp [prodRankOne, vecMulVec_apply]
  ring

/-- Unit product rank-ones. -/
def unitProd (ι κ : Type*) [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] :
    Set (Matrix (ι × κ) (ι × κ) ℂ) :=
  (fun p : EuclideanSpace ℂ ι × EuclideanSpace ℂ κ => prodRankOne p.1.ofLp p.2.ofLp) ''
    (Metric.sphere 0 1 ×ˢ Metric.sphere 0 1)

theorem isCompact_unitProd : IsCompact (unitProd ι κ) :=
  ((isCompact_sphere _ _).prod (isCompact_sphere _ _)).image
    (continuous_prodRankOne.comp ((PiLp.continuous_ofLp 2 _).prodMap (PiLp.continuous_ofLp 2 _)))

theorem trace_prodRankOne (a : ι → ℂ) (b : κ → ℂ) :
    trace (prodRankOne a b) = (a ⬝ᵥ star a) * (b ⬝ᵥ star b) := by
  simp [prodRankOne, trace_kronecker]

theorem dotProduct_star_self_eq (a : ι → ℂ) :
    a ⬝ᵥ star a = ((‖(WithLp.toLp 2 a : EuclideanSpace ℂ ι)‖ : ℝ) : ℂ) ^ 2 := by
  rw [← EuclideanSpace.inner_toLp_toLp, inner_self_eq_norm_sq_to_K]
  simp

theorem trRe_of_mem_unitProd {P : Matrix (ι × κ) (ι × κ) ℂ} (hP : P ∈ unitProd ι κ) :
    trRe P = 1 := by
  obtain ⟨⟨u, v⟩, ⟨hu, hv⟩, rfl⟩ := hP
  simp only [mem_sphere_iff_norm, sub_zero] at hu hv
  simp only [trRe, trace_prodRankOne]
  have h1 := dotProduct_star_self_eq u.ofLp
  have h2 := dotProduct_star_self_eq v.ofLp
  simp only [WithLp.toLp_ofLp, hu, hv] at h1 h2
  simp [h1, h2]

theorem unitProd_nonempty [Nonempty ι] [Nonempty κ] : (unitProd ι κ).Nonempty := by
  obtain ⟨i⟩ := ‹Nonempty ι›
  obtain ⟨k⟩ := ‹Nonempty κ›
  exact ⟨_, (EuclideanSpace.single i (1 : ℂ), EuclideanSpace.single k (1 : ℂ)),
    ⟨by simp, by simp⟩, rfl⟩

/-- Every product rank-one is a nonnegative multiple of a unit one. -/
theorem exists_smul_mem_unitProd [Nonempty ι] [Nonempty κ] (a : ι → ℂ) (b : κ → ℂ) :
    ∃ s : ℝ, 0 ≤ s ∧ ∃ P ∈ unitProd ι κ, prodRankOne a b = s • P := by
  by_cases h : a = 0 ∨ b = 0
  · obtain ⟨P, hP⟩ := unitProd_nonempty (ι := ι) (κ := κ)
    refine ⟨0, le_rfl, P, hP, ?_⟩
    rcases h with rfl | rfl <;> simp [prodRankOne]
  push Not at h
  obtain ⟨ha, hb⟩ := h
  set ea : EuclideanSpace ℂ ι := WithLp.toLp 2 a with hea
  set eb : EuclideanSpace ℂ κ := WithLp.toLp 2 b with heb
  have hna : 0 < ‖ea‖ := norm_pos_iff.2 (by simpa [hea] using ha)
  have hnb : 0 < ‖eb‖ := norm_pos_iff.2 (by simpa [heb] using hb)
  refine ⟨‖ea‖ ^ 2 * ‖eb‖ ^ 2, by positivity,
    prodRankOne (‖ea‖⁻¹ • a) (‖eb‖⁻¹ • b), ⟨(‖ea‖⁻¹ • ea, ‖eb‖⁻¹ • eb), ⟨?_, ?_⟩, rfl⟩, ?_⟩
  · simp [norm_smul, hna.ne']
  · simp [norm_smul, hnb.ne']
  · have ha' : a = ‖ea‖ • (‖ea‖⁻¹ • a) := by rw [smul_smul, mul_inv_cancel₀ hna.ne', one_smul]
    have hb' : b = ‖eb‖ • (‖eb‖⁻¹ • b) := by rw [smul_smul, mul_inv_cancel₀ hnb.ne', one_smul]
    rw [← prodRankOne_smul_smul]
    exact congrArg₂ prodRankOne ha' hb'

theorem convex_isSeparable : Convex ℝ {X : Matrix (ι × κ) (ι × κ) ℂ | IsSeparable X} := by
  intro x hx y hy a b ha hb _
  exact (hx.smul_nonneg ha).add (hy.smul_nonneg hb)

theorem unitProd_subset : unitProd ι κ ⊆ {X | IsSeparable X} := by
  rintro _ ⟨p, _, rfl⟩
  exact isSeparable_prodRankOne _ _

theorem convexHull_unitProd_subset : convexHull ℝ (unitProd ι κ) ⊆ {X | IsSeparable X} :=
  convexHull_min unitProd_subset convex_isSeparable

theorem trRe_of_mem_convexHull {h : Matrix (ι × κ) (ι × κ) ℂ}
    (hh : h ∈ convexHull ℝ (unitProd ι κ)) : trRe h = 1 := by
  have hconv : Convex ℝ {X : Matrix (ι × κ) (ι × κ) ℂ | trRe X = 1} := by
    intro x hx y hy a b ha hb hab
    simp only [mem_ofPred_eq] at *
    rw [trRe_add, trRe_smul, trRe_smul, hx, hy]
    linarith
  exact convexHull_min (fun P hP => trRe_of_mem_unitProd hP) hconv hh

theorem IsSeparable.exists_smul_mem_hull [Nonempty ι] [Nonempty κ]
    {X : Matrix (ι × κ) (ι × κ) ℂ} (hX : IsSeparable X) :
    ∃ s : ℝ, 0 ≤ s ∧ ∃ h ∈ convexHull ℝ (unitProd ι κ), X = s • h := by
  obtain ⟨N, a, b, rfl⟩ := hX
  have := fun i => exists_smul_mem_unitProd (a i) (b i)
  choose s hs P hP hsP using this
  simp_rw [hsP]
  set S := ∑ i, s i with hSdef
  have hS0 : 0 ≤ S := Finset.sum_nonneg fun i _ => hs i
  by_cases hS : S = 0
  · have hz : ∀ i, s i = 0 := fun i =>
      (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => hs i)).1 hS i (Finset.mem_univ _)
    obtain ⟨P0, hP0⟩ := unitProd_nonempty (ι := ι) (κ := κ)
    exact ⟨0, le_rfl, P0, subset_convexHull ℝ _ hP0, by simp [hz]⟩
  · refine ⟨S, hS0, ∑ i, (s i / S) • P i, ?_, ?_⟩
    · exact (convex_convexHull ℝ _).sum_mem (fun i _ => div_nonneg (hs i) hS0)
        (by rw [← Finset.sum_div, div_self hS])
        (fun i _ => subset_convexHull ℝ _ (hP i))
    · rw [Finset.smul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_smul]
      congr 1
      field_simp

/-- **Plan lemma D1.**  The cone of separable matrices is closed (Gurvits–Barnum, PRA 66, 062311
(2002); proved here in all finite dimensions via Carathéodory compactness of `conv K0`). -/
theorem isClosed_isSeparable_of_nonempty [Nonempty ι] [Nonempty κ] :
    IsClosed {X : Matrix (ι × κ) (ι × κ) ℂ | IsSeparable X} := by
  set H := convexHull ℝ (unitProd ι κ) with hHdef
  have hH : IsCompact H := FormalResearch.ConvexGeometry.isCompact_convexHull_of_isCompact isCompact_unitProd
  set Q : ℝ → Set (Matrix (ι × κ) (ι × κ) ℂ) :=
    fun T => (fun p : ℝ × Matrix (ι × κ) (ι × κ) ℂ => p.1 • p.2) '' (Icc 0 T ×ˢ H) with hQdef
  have hQ : ∀ T, IsCompact (Q T) := fun T =>
    (isCompact_Icc.prod hH).image (continuous_fst.smul continuous_snd)
  refine isClosed_of_closure_subset fun X hX => ?_
  have hmem : X ∈ closure (Q (trRe X + 1)) := by
    rw [mem_closure_iff]
    intro V hV hXV
    obtain ⟨Y, ⟨hYV, hYT⟩, hYsep⟩ := mem_closure_iff.1 hX (V ∩ {Y | trRe Y < trRe X + 1})
      (hV.inter (isOpen_lt continuous_trRe continuous_const)) ⟨hXV, by simp⟩
    obtain ⟨s, hs, h, hh, rfl⟩ := IsSeparable.exists_smul_mem_hull hYsep
    refine ⟨s • h, hYV, ⟨(s, h), ⟨⟨hs, ?_⟩, hh⟩, rfl⟩⟩
    simp only [mem_ofPred_eq, trRe_smul, trRe_of_mem_convexHull hh, mul_one] at hYT
    exact hYT.le
  rw [(hQ _).isClosed.closure_eq] at hmem
  obtain ⟨⟨s, h⟩, ⟨⟨hs, _⟩, hh⟩, hXeq⟩ := hmem
  rw [← hXeq]
  exact (convexHull_unitProd_subset hh).smul_nonneg hs

/-- **Plan lemma D1** (all finite index types).  `{X | IsSeparable X}` is closed in the matrix
topology.  Gurvits–Barnum, PRA 66, 062311 (2002). -/
theorem isClosed_isSeparable : IsClosed {X : Matrix (ι × κ) (ι × κ) ℂ | IsSeparable X} := by
  rcases isEmpty_or_nonempty ι with hι | hι
  · have : Subsingleton (Matrix (ι × κ) (ι × κ) ℂ) :=
      ⟨fun X Y => by ext p; exact isEmptyElim p.1⟩
    exact Set.Subsingleton.isClosed (Set.subsingleton_of_subsingleton)
  rcases isEmpty_or_nonempty κ with hκ | hκ
  · have : Subsingleton (Matrix (ι × κ) (ι × κ) ℂ) :=
      ⟨fun X Y => by ext p; exact isEmptyElim p.2⟩
    exact Set.Subsingleton.isClosed (Set.subsingleton_of_subsingleton)
  exact isClosed_isSeparable_of_nonempty

end

/-- info: 'FormalResearch.GurvitsBarnum.isClosed_isSeparable' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms isClosed_isSeparable

end FormalResearch.GurvitsBarnum
