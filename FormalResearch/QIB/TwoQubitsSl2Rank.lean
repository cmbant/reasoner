import Mathlib
import FormalResearch.QIB.TwoQubitsSl2Kernel
import FormalResearch.QIB.BlockExamples

/-!
# The stabiliser reduction of `prop:twoqubits`, up to representation-theoretic data

Namespace `FormalResearch.QIB`.  Claim class: **proved** (finite linear algebra).

Source: `QI-B/paper/invariant_discrimination_exponents.tex`, `prop:twoqubits` (two qubits under collective
`SU(2)`: every multiplicity block has rank at most one).

`TwoQubitsSl2Kernel.lean` proves the kernel lemma for an irreducible `sl₂` module.  This file packages it
into the stabiliser argument of the paper, in the isotypic coordinates of `QIB.BlockDecomp`:

* `MatTriple`, `MatIrr`, `kernel_sl2_matrix`: matrix form of the kernel lemma.
* `blk`, `blk_mulVec`, `blk_mul`, ...: a matrix `K` on `Idx A B` commuting with every `blockOp A X`
  (this holds for every `K` in the algebra generated by `G` when `IsotypicInvariants A G`) has the form
  `⊕_λ K_λ ⊗ I_{B λ}`, and `K ↦ K_λ` is an algebra homomorphism.
* `rank_tau_le_one_of_stabiliser`: if three matrices `𝓗, 𝓔, 𝓕` on `Idx A B` commuting with every
  `blockOp A X` satisfy the `sl₂` relations, the sector-`λ` carrier is irreducible for them, and some nonzero
  `α𝓗 + β𝓔 + γ𝓕` kills `v`, then `(tau v λ).rank ≤ 1`.

The concrete statement (collective `SU(2)` on `(ℂ²⊗ℂ²)^{⊗d}`) is assembled in `TwoQubitsProp.lean`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
open Matrix
open scoped Kronecker

namespace FormalResearch.QIB

/-! ## Matrix form of the kernel lemma -/

namespace Sl2Kernel

section MatrixForm

variable {A : Type*} [Fintype A] [DecidableEq A]

/-- The `sl₂` relations for matrices. -/
structure MatTriple (H E F : Matrix A A ℂ) : Prop where
  HE : H * E - E * H = (2 : ℂ) • E
  HF : H * F - F * H = -((2 : ℂ) • F)
  EF : E * F - F * E = H

/-- Irreducibility for matrices: only `⊥` and `⊤` are invariant subspaces of `A → ℂ`. -/
def MatIrr (H E F : Matrix A A ℂ) : Prop :=
  ∀ W : Submodule ℂ (A → ℂ), (∀ w ∈ W, H *ᵥ w ∈ W) → (∀ w ∈ W, E *ᵥ w ∈ W) →
    (∀ w ∈ W, F *ᵥ w ∈ W) → W = ⊥ ∨ W = ⊤

variable {H E F : Matrix A A ℂ}

theorem MatTriple.toTriple (h : MatTriple H E F) :
    Triple (Matrix.toLin' H) (Matrix.toLin' E) (Matrix.toLin' F) where
  HE x := by
    have e : H * E = E * H + (2 : ℂ) • E := by rw [← h.HE]; abel
    simp only [Matrix.toLin'_apply, Matrix.mulVec_mulVec, e, Matrix.add_mulVec, Matrix.smul_mulVec]
  HF x := by
    have e : H * F = F * H - (2 : ℂ) • F := by
      have := h.HF
      rw [sub_eq_iff_eq_add] at this
      rw [this]; abel
    simp only [Matrix.toLin'_apply, Matrix.mulVec_mulVec, e, Matrix.sub_mulVec, Matrix.smul_mulVec]
  EF x := by
    have e : E * F = F * E + H := by rw [← h.EF]; abel
    simp only [Matrix.toLin'_apply, Matrix.mulVec_mulVec, e, Matrix.add_mulVec]

theorem MatIrr.toIrr (h : MatIrr H E F) :
    Irr (Matrix.toLin' H) (Matrix.toLin' E) (Matrix.toLin' F) := by
  intro W hH hE hF
  exact h W (fun w hw => by simpa using hH w hw) (fun w hw => by simpa using hE w hw)
    (fun w hw => by simpa using hF w hw)

/-- **Kernel lemma, matrix form.**  For a nonzero finite-dimensional irreducible `sl₂`-module given by
matrices, the kernel of any nonzero element `αH + βE + γF` is a line (or zero). -/
theorem kernel_sl2_matrix [Nonempty A] (h : MatTriple H E F) (hirr : MatIrr H E F) (α β γ : ℂ)
    (hne : α ≠ 0 ∨ β ≠ 0 ∨ γ ≠ 0) :
    ∃ k : A → ℂ, ∀ u : A → ℂ, (α • H + β • E + γ • F) *ᵥ u = 0 → ∃ c : ℂ, u = c • k := by
  have : Nontrivial (A → ℂ) := inferInstance
  obtain ⟨k, hk⟩ := kernel_sl2 h.toTriple hirr.toIrr α β γ hne
  refine ⟨k, fun u hu => hk u ?_⟩
  simpa [Matrix.add_mulVec, Matrix.smul_mulVec] using hu

end MatrixForm

end Sl2Kernel

/-! ## Block form of matrices commuting with the commutant -/

section BlockForm

variable {Λ : Type*} [Fintype Λ] [DecidableEq Λ] {A B : Λ → Type*}
  [∀ l, Fintype (A l)] [∀ l, DecidableEq (A l)] [∀ l, Fintype (B l)] [∀ l, DecidableEq (B l)]

/-- `blockOp` with the matrix unit `|b⟩⟨b'|` in sector `l` and zero elsewhere. -/
noncomputable def unitOp (A : Λ → Type*) [∀ l, Fintype (A l)] [∀ l, DecidableEq (A l)]
    {B : Λ → Type*} [∀ l, Fintype (B l)] [∀ l, DecidableEq (B l)] (l : Λ) (b b' : B l) :
    Matrix (Idx A B) (Idx A B) ℂ :=
  blockOp A (Function.update (fun l' => (0 : Matrix (B l') (B l') ℂ)) l (Matrix.single b b' 1))

theorem unitOp_mulVec_same (l : Λ) (b b' : B l) (w : Idx A B → ℂ) (a : A l) (c : B l) :
    (unitOp A l b b' *ᵥ w) ⟨l, (a, c)⟩ = if c = b then w ⟨l, (a, b')⟩ else 0 := by
  unfold unitOp
  rw [blockOp_mulVec_apply, Function.update_self, Matrix.single_mulVec_eq]
  simp [slice, Pi.single_apply]

theorem unitOp_mulVec_ne {l l1 : Λ} (h : l1 ≠ l) (b b' : B l) (w : Idx A B → ℂ) (a : A l1)
    (c : B l1) : (unitOp A l b b' *ᵥ w) ⟨l1, (a, c)⟩ = 0 := by
  unfold unitOp
  rw [blockOp_mulVec_apply, Function.update_of_ne h]
  simp

theorem unitOp_basis (l : Λ) (b b' : B l) (α : A l) :
    unitOp A l b b' *ᵥ (Pi.single (⟨l, (α, b')⟩ : Idx A B) (1 : ℂ)) = Pi.single ⟨l, (α, b)⟩ 1 := by
  ext ⟨l1, a1, c1⟩
  by_cases h : l1 = l
  · subst h
    rw [unitOp_mulVec_same]
    simp only [Pi.single_apply, Sigma.mk.inj_iff, heq_eq_eq, Prod.mk.injEq, true_and]
    by_cases h1 : c1 = b <;> by_cases h2 : a1 = α <;> simp [h1, h2]
  · rw [unitOp_mulVec_ne h]
    simp [Pi.single_apply, Sigma.mk.inj_iff, h]

/-- `K` commutes with every `blockOp A X` (so it lies in the double commutant of an isotypic group). -/
def Comm (A : Λ → Type*) [∀ l, Fintype (A l)] [∀ l, DecidableEq (A l)]
    {B : Λ → Type*} [∀ l, Fintype (B l)] [∀ l, DecidableEq (B l)]
    (K : Matrix (Idx A B) (Idx A B) ℂ) : Prop :=
  ∀ X : ∀ l, Matrix (B l) (B l) ℂ, K * blockOp A X = blockOp A X * K

variable {K K' : Matrix (Idx A B) (Idx A B) ℂ}

theorem Comm.add (h : Comm A K) (h' : Comm A K') : Comm A (K + K') := fun X => by
  rw [add_mul, mul_add, h X, h' X]

theorem Comm.smul (c : ℂ) (h : Comm A K) : Comm A (c • K) := fun X => by
  rw [smul_mul_assoc, mul_smul_comm, h X]

theorem Comm.neg (h : Comm A K) : Comm A (-K) := fun X => by
  rw [neg_mul, mul_neg, h X]

theorem Comm.mul (h : Comm A K) (h' : Comm A K') : Comm A (K * K') := fun X => by
  rw [Matrix.mul_assoc, h' X, ← Matrix.mul_assoc, h X, Matrix.mul_assoc]

theorem commute_col (hK : Comm A K) (l : Λ) (b b' : B l) (α : A l) (r : Idx A B) :
    K r ⟨l, (α, b)⟩ = (unitOp A l b b' *ᵥ (K *ᵥ Pi.single ⟨l, (α, b')⟩ 1)) r := by
  have hc : K * unitOp A l b b' = unitOp A l b b' * K := hK _
  calc K r ⟨l, (α, b)⟩ = (K *ᵥ Pi.single (⟨l, (α, b)⟩ : Idx A B) (1 : ℂ)) r := by
        simp [Matrix.mulVec_single_one]
    _ = (K *ᵥ (unitOp A l b b' *ᵥ Pi.single (⟨l, (α, b')⟩ : Idx A B) (1 : ℂ))) r := by
        rw [unitOp_basis]
    _ = ((K * unitOp A l b b') *ᵥ Pi.single (⟨l, (α, b')⟩ : Idx A B) (1 : ℂ)) r := by
        rw [Matrix.mulVec_mulVec]
    _ = ((unitOp A l b b' * K) *ᵥ Pi.single (⟨l, (α, b')⟩ : Idx A B) (1 : ℂ)) r := by rw [hc]
    _ = _ := by rw [← Matrix.mulVec_mulVec]

theorem col_same (hK : Comm A K) (l : Λ) (a1 : A l) (c1 : B l) (α : A l) (b b' : B l) :
    K ⟨l, (a1, c1)⟩ ⟨l, (α, b)⟩ = if c1 = b then K ⟨l, (a1, b')⟩ ⟨l, (α, b')⟩ else 0 := by
  rw [commute_col hK l b b' α, unitOp_mulVec_same]
  simp [Matrix.mulVec_single_one]

theorem col_ne (hK : Comm A K) {l l1 : Λ} (h : l1 ≠ l) (a1 : A l1) (c1 : B l1) (α : A l) (b : B l) :
    K ⟨l1, (a1, c1)⟩ ⟨l, (α, b)⟩ = 0 := by
  rw [commute_col hK l b b α, unitOp_mulVec_ne h]

/-- The sector-`l` block of `K`, read in the slice `b`. -/
def blk (K : Matrix (Idx A B) (Idx A B) ℂ) (l : Λ) (b : B l) : Matrix (A l) (A l) ℂ :=
  fun a a' => K ⟨l, (a, b)⟩ ⟨l, (a', b)⟩

theorem blk_indep (hK : Comm A K) (l : Λ) (b b' : B l) : blk K l b = blk K l b' := by
  ext a a'
  simp only [blk]
  rw [col_same hK l a b a' b b']
  simp

/-- A matrix commuting with every `blockOp A X` acts as `⊕_λ K_λ ⊗ I`. -/
theorem blk_mulVec (hK : Comm A K) (w : Idx A B → ℂ) (l : Λ) (a : A l) (b : B l) :
    (K *ᵥ w) ⟨l, (a, b)⟩ = (blk K l b *ᵥ fun α' => w ⟨l, (α', b)⟩) a := by
  simp only [Matrix.mulVec, dotProduct, Fintype.sum_sigma, Fintype.sum_prod_type, blk]
  rw [Finset.sum_eq_single l]
  · refine Finset.sum_congr rfl fun α' _ => ?_
    rw [Finset.sum_eq_single b]
    · intro c _ hcb
      rw [col_same hK l a b α' c c]
      simp [Ne.symm hcb]
    · intro hb; exact absurd (Finset.mem_univ b) hb
  · intro l' _ hl'
    refine Finset.sum_eq_zero fun α' _ => Finset.sum_eq_zero fun c _ => ?_
    rw [col_ne hK (Ne.symm hl'), zero_mul]
  · intro hl; exact absurd (Finset.mem_univ l) hl

theorem blk_add (l : Λ) (b : B l) : blk (K + K') l b = blk K l b + blk K' l b := by
  ext a a'; simp [blk]

theorem blk_sub (l : Λ) (b : B l) : blk (K - K') l b = blk K l b - blk K' l b := by
  ext a a'; simp [blk]

theorem blk_smul (c : ℂ) (l : Λ) (b : B l) : blk (c • K) l b = c • blk K l b := by
  ext a a'; simp [blk]

theorem blk_neg (l : Λ) (b : B l) : blk (-K) l b = -blk K l b := by
  ext a a'; simp [blk]

theorem blk_mul (hK : Comm A K) (l : Λ) (b : B l) (K' : Matrix (Idx A B) (Idx A B) ℂ) :
    blk (K * K') l b = blk K l b * blk K' l b := by
  ext a a'
  have h2 := blk_mulVec hK (K' *ᵥ Pi.single (⟨l, (a', b)⟩ : Idx A B) (1 : ℂ)) l a b
  have h3 : (fun α' => (K' *ᵥ Pi.single (⟨l, (a', b)⟩ : Idx A B) (1 : ℂ)) ⟨l, (α', b)⟩)
      = fun α' => blk K' l b α' a' := by
    funext α'
    simp [Matrix.mulVec_single_one, blk]
  calc blk (K * K') l b a a'
      = ((K * K') *ᵥ Pi.single (⟨l, (a', b)⟩ : Idx A B) (1 : ℂ)) ⟨l, (a, b)⟩ := by
        simp [Matrix.mulVec_single_one, blk]
    _ = (K *ᵥ (K' *ᵥ Pi.single (⟨l, (a', b)⟩ : Idx A B) (1 : ℂ))) ⟨l, (a, b)⟩ := by
        rw [Matrix.mulVec_mulVec]
    _ = (blk K l b *ᵥ fun α' => blk K' l b α' a') a := by rw [h2, h3]
    _ = (blk K l b * blk K' l b) a a' := by
        simp [Matrix.mulVec, dotProduct, Matrix.mul_apply]

theorem blk_one (l : Λ) (b : B l) : blk (1 : Matrix (Idx A B) (Idx A B) ℂ) l b = 1 := by
  ext a a'
  simp [blk, Matrix.one_apply, Sigma.mk.inj_iff]

open scoped ComplexOrder in
/-- A line-supported multiplicity block is `|u⟩⟨u|`: from `τ = ‖k‖² |c⟩⟨c|` take `u = ‖k‖ c`. -/
theorem exists_vecMulVec_of_kernel (v : Idx A B → ℂ) (l : Λ) (K : Matrix (A l) (A l) ℂ) (k : A l → ℂ)
    (hker : ∀ u : A l → ℂ, K *ᵥ u = 0 → ∃ c : ℂ, u = c • k)
    (hv : ∀ b : B l, K *ᵥ (fun α => v ⟨l, (α, b)⟩) = 0) :
    ∃ u : B l → ℂ, tau v l = Matrix.vecMulVec u (star u) := by
  obtain ⟨c, hc⟩ := exists_coeff_of_kernel v l K k hker hv
  rw [tau_eq_smul_vecMulVec_of_kernel v l k c hc]
  obtain ⟨hre, him⟩ := Complex.nonneg_iff.1 (dotProduct_star_self_nonneg k)
  have hs : star k ⬝ᵥ k = (((star k ⬝ᵥ k).re : ℝ) : ℂ) := Complex.ext (by simp) (by simp [← him])
  refine ⟨(Real.sqrt (star k ⬝ᵥ k).re : ℂ) • c, ?_⟩
  rw [hs]
  ext b b'
  simp only [Matrix.smul_apply, Matrix.vecMulVec_apply, Pi.smul_apply, Pi.star_apply, star_smul,
    smul_eq_mul, Complex.star_def, Complex.conj_ofReal]
  have hsq : (Real.sqrt (star k ⬝ᵥ k).re : ℂ) * (Real.sqrt (star k ⬝ᵥ k).re : ℂ)
      = (((star k ⬝ᵥ k).re : ℝ) : ℂ) := by
    rw [← Complex.ofReal_mul, Real.mul_self_sqrt hre]
  linear_combination (c b * (starRingEnd ℂ) (c b')) * (-hsq)

/-- **The stabiliser reduction of `prop:twoqubits`, product form.**  Let `𝓗, 𝓔, 𝓕` be matrices on `Idx A B` commuting
with every `blockOp A X` (e.g. elements of the algebra generated by a group with `IsotypicInvariants`),
satisfying the `sl₂` relations, and suppose the sector-`l` carrier is irreducible for their blocks.  If
some nonzero `α𝓗 + β𝓔 + γ𝓕` kills `v`, then the multiplicity block is `τ_l(v) = |u⟩⟨u|` for some `u`
(so it has rank at most one). -/
theorem exists_vecMulVec_of_stabiliser
    {𝓗 𝓔 𝓕 : Matrix (Idx A B) (Idx A B) ℂ} (hH : Comm A 𝓗) (hE : Comm A 𝓔) (hF : Comm A 𝓕)
    (hHE : 𝓗 * 𝓔 - 𝓔 * 𝓗 = (2 : ℂ) • 𝓔) (hHF : 𝓗 * 𝓕 - 𝓕 * 𝓗 = -((2 : ℂ) • 𝓕))
    (hEF : 𝓔 * 𝓕 - 𝓕 * 𝓔 = 𝓗)
    (l : Λ) (b0 : B l) [Nonempty (A l)]
    (hirr : Sl2Kernel.MatIrr (blk 𝓗 l b0) (blk 𝓔 l b0) (blk 𝓕 l b0))
    (α β γ : ℂ) (hne : α ≠ 0 ∨ β ≠ 0 ∨ γ ≠ 0)
    (v : Idx A B → ℂ) (hv : (α • 𝓗 + β • 𝓔 + γ • 𝓕) *ᵥ v = 0) :
    ∃ u : B l → ℂ, tau v l = Matrix.vecMulVec u (star u) := by
  have htrip : Sl2Kernel.MatTriple (blk 𝓗 l b0) (blk 𝓔 l b0) (blk 𝓕 l b0) := by
    refine ⟨?_, ?_, ?_⟩
    · have := congrArg (fun M => blk M l b0) hHE
      simpa only [blk_sub, blk_smul, blk_mul hH, blk_mul hE] using this
    · have := congrArg (fun M => blk M l b0) hHF
      simpa only [blk_sub, blk_smul, blk_neg, blk_mul hH, blk_mul hF] using this
    · have := congrArg (fun M => blk M l b0) hEF
      simpa only [blk_sub, blk_mul hE, blk_mul hF] using this
  obtain ⟨k, hk⟩ := Sl2Kernel.kernel_sl2_matrix htrip hirr α β γ hne
  refine exists_vecMulVec_of_kernel v l (α • blk 𝓗 l b0 + β • blk 𝓔 l b0 + γ • blk 𝓕 l b0) k hk ?_
  intro b
  have hK : Comm A (α • 𝓗 + β • 𝓔 + γ • 𝓕) :=
    ((hH.smul α).add (hE.smul β)).add (hF.smul γ)
  funext a
  have h1 := blk_mulVec hK v l a b
  rw [hv] at h1
  have h2 : blk (α • 𝓗 + β • 𝓔 + γ • 𝓕) l b
      = α • blk 𝓗 l b0 + β • blk 𝓔 l b0 + γ • blk 𝓕 l b0 := by
    rw [blk_add, blk_add, blk_smul, blk_smul, blk_smul, blk_indep hH l b b0, blk_indep hE l b b0,
      blk_indep hF l b b0]
  rw [h2] at h1
  simpa using h1.symm


/-- **The stabiliser reduction of `prop:twoqubits`, rank form.** -/
theorem rank_tau_le_one_of_stabiliser
    {𝓗 𝓔 𝓕 : Matrix (Idx A B) (Idx A B) ℂ} (hH : Comm A 𝓗) (hE : Comm A 𝓔) (hF : Comm A 𝓕)
    (hHE : 𝓗 * 𝓔 - 𝓔 * 𝓗 = (2 : ℂ) • 𝓔) (hHF : 𝓗 * 𝓕 - 𝓕 * 𝓗 = -((2 : ℂ) • 𝓕))
    (hEF : 𝓔 * 𝓕 - 𝓕 * 𝓔 = 𝓗)
    (l : Λ) (b0 : B l) [Nonempty (A l)]
    (hirr : Sl2Kernel.MatIrr (blk 𝓗 l b0) (blk 𝓔 l b0) (blk 𝓕 l b0))
    (α β γ : ℂ) (hne : α ≠ 0 ∨ β ≠ 0 ∨ γ ≠ 0)
    (v : Idx A B → ℂ) (hv : (α • 𝓗 + β • 𝓔 + γ • 𝓕) *ᵥ v = 0) :
    (tau v l).rank ≤ 1 := by
  obtain ⟨u, hu⟩ := exists_vecMulVec_of_stabiliser hH hE hF hHE hHF hEF l b0 hirr α β γ hne v hv
  rw [hu]
  exact Matrix.rank_vecMulVec_le _ _

end BlockForm

end FormalResearch.QIB
