import Mathlib

namespace FormalResearch.QIC

abbrev Fin8 := Fin 8
abbrev Fin9 := Fin 9
abbrev P9 := Fin9 → Int

def pZero : P9 := fun _ => 0
def lin (a b : Int) : P9 := fun k =>
  if k = 0 then a else if k = 1 then b else 0
def poly8 (a0 a1 a2 a3 a4 a5 a6 a7 : Int) : P9 :=
  ![a0, a1, a2, a3, a4, a5, a6, a7, 0]
def pAdd (p q : P9) : P9 := fun k => p k + q k
def pMul (p q : P9) : P9 := fun k =>
  ∑ i : Fin9,
    if i.val ≤ k.val then
      p i * q ⟨k.val - i.val, Nat.lt_of_le_of_lt (Nat.sub_le _ _) k.isLt⟩
    else 0
def pScale (a : Int) (p : P9) : P9 := fun k => a * p k

def matMul (A B : Matrix Fin8 Fin8 P9) : Matrix Fin8 Fin8 P9 :=
  fun i j => ∑ k : Fin8, pMul (A i k) (B k j)

def scalarMat (d : P9) : Matrix Fin8 Fin8 P9 :=
  fun i j => if i = j then d else pZero

