module

public import Mathlib
public import FormalResearch.ConvexGeometry.ClosedHull

/-!
# Conic Carathéodory bound and closedness of a cone over a compact set

Generic finite-dimensional statements used for the "at most 25 terms" and "the cone is closed"
clauses of `thm:ppt3-universal-moments` (`relaxations_and_scope.tex`, proof in
`appendix_moment_cone.tex`).

Let `E` be a finite-dimensional real topological vector space, `S ⊆ E`, and `ℓ : E →ₗ[ℝ] ℝ` a linear
functional that is positive on `S`.  Write `ConeRep S n x` for "`x` is a sum of `n` terms
`w i • s i` with `w i ≥ 0` and `s i ∈ S`", and `PointedCone.hull ℝ S` for the cone generated by `S`.

* `exists_coneRep_card_le` (conic Carathéodory): every `x` in the cone is a sum of at most
  `finrank ℝ V` such terms, for any subspace `V ⊇ S`.  (Mathlib has Carathéodory only for convex
  hulls, which would give one more term; the normalisation `s ↦ s / ℓ s` onto the affine hyperplane
  `ℓ = 1` removes it.)
* `isClosed_hull_of_isCompact`: if `S` is compact, the cone `PointedCone.hull ℝ S` is closed.
-/

@[expose] public section

namespace FormalResearch.ConvexGeometry

open Set Finset

noncomputable section

namespace ConeCar

universe u

variable {E : Type u} [AddCommGroup E] [Module ℝ E]

/-- `x` is a sum of `n` terms `w i • s i`, `w i ≥ 0`, `s i ∈ S`. -/
def ConeRep (S : Set E) (n : ℕ) (x : E) : Prop :=
  ∃ (w : Fin n → ℝ) (s : Fin n → E), (∀ i, 0 ≤ w i) ∧ (∀ i, s i ∈ S) ∧ x = ∑ i, w i • s i

theorem coneRep_add {S : Set E} {n m : ℕ} {x y : E} (hx : ConeRep S n x) (hy : ConeRep S m y) :
    ConeRep S (n + m) (x + y) := by
  obtain ⟨w, s, hw, hs, rfl⟩ := hx
  obtain ⟨w', s', hw', hs', rfl⟩ := hy
  refine ⟨Fin.append w w', Fin.append s s', ?_, ?_, ?_⟩
  · intro i
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;> simp [hw, hw']
  · intro i
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;> simp [hs, hs']
  · rw [Fin.sum_univ_add]
    simp

theorem coneRep_zero (S : Set E) : ConeRep S 0 0 := ⟨Fin.elim0, Fin.elim0, fun i => i.elim0,
  fun i => i.elim0, by simp⟩

theorem coneRep_smul {S : Set E} {n : ℕ} {x : E} (hx : ConeRep S n x) {r : ℝ} (hr : 0 ≤ r) :
    ConeRep S n (r • x) := by
  obtain ⟨w, s, hw, hs, rfl⟩ := hx
  refine ⟨fun i => r * w i, s, fun i => mul_nonneg hr (hw i), hs, ?_⟩
  rw [Finset.smul_sum]
  simp [smul_smul]

theorem coneRep_single {S : Set E} {s : E} (hs : s ∈ S) {r : ℝ} (hr : 0 ≤ r) :
    ConeRep S 1 (r • s) :=
  ⟨fun _ => r, fun _ => s, fun _ => hr, fun _ => hs, by simp⟩

/-- Membership in the cone generated by `S` is the existence of a finite conic combination. -/
theorem mem_hull_iff {S : Set E} {x : E} :
    x ∈ PointedCone.hull ℝ S ↔ ∃ n, ConeRep S n x := by
  constructor
  · intro hx
    rw [PointedCone.mem_hull_set] at hx
    obtain ⟨c, hcS, hc0, rfl⟩ := hx
    classical
    set e := c.support.equivFin with he
    refine ⟨c.support.card, fun i => c (e.symm i), fun i => ((e.symm i : c.support) : E),
      fun i => hc0 _, fun i => hcS (e.symm i).2, ?_⟩
    rw [Finsupp.sum, ← Finset.sum_coe_sort c.support (fun y => c y • y)]
    exact (Fintype.sum_equiv e.symm _ _ (fun i => rfl)).symm
  · rintro ⟨n, w, s, hw, hs, rfl⟩
    exact (PointedCone.hull ℝ S).sum_mem fun i _ =>
      PointedCone.smul_mem _ (hw i) (PointedCone.subset_hull (hs i))

/-- **Conic Carathéodory.**  If `ℓ` is positive on `S ⊆ V`, every conic combination of elements of
`S` is a conic combination of at most `finrank ℝ V` elements of `S`. -/
theorem exists_coneRep_card_le {S : Set E} (ℓ : E →ₗ[ℝ] ℝ) (hℓ : ∀ s ∈ S, 0 < ℓ s)
    (V : Submodule ℝ E) [FiniteDimensional ℝ V] (hV : S ⊆ V) {x : E} {n : ℕ}
    (hx : ConeRep S n x) : ∃ m ≤ Module.finrank ℝ V, ConeRep S m x := by
  classical
  obtain ⟨w, s, hw, hs, rfl⟩ := hx
  set t : ℝ := ∑ i, w i * ℓ (s i) with ht
  have hterm : ∀ i, 0 ≤ w i * ℓ (s i) := fun i => mul_nonneg (hw i) (hℓ _ (hs i)).le
  by_cases ht0 : t = 0
  · have hz : ∀ i, w i = 0 := fun i => by
      have h1 := (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => hterm i)).1 ht0 i (mem_univ i)
      exact (mul_eq_zero.1 h1).resolve_right (hℓ _ (hs i)).ne'
    refine ⟨0, Nat.zero_le _, ?_⟩
    have : ∑ i, w i • s i = 0 := Finset.sum_eq_zero fun i _ => by rw [hz i, zero_smul]
    rw [this]; exact coneRep_zero S
  have htpos : 0 < t := lt_of_le_of_ne (Finset.sum_nonneg fun i _ => hterm i) (Ne.symm ht0)
  set Z : Set E := {z | ∃ y ∈ S, z = (ℓ y)⁻¹ • y} with hZ
  have hexpr : ∑ i, (w i * ℓ (s i) / t) • ((ℓ (s i))⁻¹ • s i) = t⁻¹ • ∑ i, w i • s i := by
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [smul_smul, smul_smul]
    congr 1
    have := (hℓ _ (hs i)).ne'
    field_simp
  have hmem : ∑ i, (w i * ℓ (s i) / t) • ((ℓ (s i))⁻¹ • s i) ∈ convexHull ℝ Z := by
    apply (convex_convexHull ℝ Z).sum_mem
    · intro i _; exact div_nonneg (hterm i) htpos.le
    · rw [← Finset.sum_div, ← ht, div_self ht0]
    · intro i _; exact subset_convexHull ℝ Z ⟨s i, hs i, rfl⟩
  obtain ⟨ι, _, z, lam, hzZ, hind, hpos, h1, hsum⟩ := eq_pos_convex_span_of_mem_convexHull hmem
  choose y hyS hyz using fun i => hzZ ⟨i, rfl⟩
  have hℓz : ∀ i, ℓ (z i) = 1 := fun i => by
    rw [hyz i, map_smul, smul_eq_mul, inv_mul_cancel₀ (hℓ _ (hyS i)).ne']
  have hli : LinearIndependent ℝ z := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    have h0 : ∑ i, g i = 0 := by
      have := congrArg ℓ hg
      simpa [map_sum, hℓz] using this
    exact fun i => hind.eq_zero_of_sum_eq_zero (s := univ) h0 hg i (mem_univ i)
  have hzV : ∀ i, z i ∈ V := fun i => by
    rw [hyz i]; exact V.smul_mem _ (hV (hyS i))
  have hli' : LinearIndependent ℝ (fun i => (⟨z i, hzV i⟩ : V)) :=
    LinearIndependent.of_comp V.subtype hli
  have hcard : Fintype.card ι ≤ Module.finrank ℝ V := hli'.fintype_card_le_finrank
  refine ⟨Fintype.card ι, hcard, ?_⟩
  have hxeq : ∑ i, w i • s i = ∑ i, (t * lam i * (ℓ (y i))⁻¹) • y i := by
    have h2 : ∑ i, w i • s i = t • ∑ i, lam i • z i := by
      rw [hsum, hexpr, smul_smul, mul_inv_cancel₀ ht0, one_smul]
    rw [h2, Finset.smul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hyz i, smul_smul, smul_smul]
  rw [hxeq]
  set e := Fintype.equivFin ι with he
  refine ⟨fun j => t * lam (e.symm j) * (ℓ (y (e.symm j)))⁻¹, fun j => y (e.symm j),
    fun j => ?_, fun j => hyS _, ?_⟩
  · have := (hℓ _ (hyS (e.symm j)))
    exact mul_nonneg (mul_nonneg htpos.le (hpos _).le) (inv_nonneg.2 this.le)
  · exact (Fintype.sum_equiv e.symm _ _ (fun j => rfl)).symm

section Closed

variable [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul ℝ E] [FiniteDimensional ℝ E]
  [T2Space E]

/-- **The cone over a compact set is closed** when a continuous linear functional is positive on the
set (so `0` is not in the convex hull). -/
theorem isClosed_cone_of_isCompact {S : Set E} (hS : IsCompact S) (ℓ : E →ₗ[ℝ] ℝ)
    (hℓc : Continuous ℓ) (hℓ : ∀ s ∈ S, 0 < ℓ s) : IsClosed {x | ∃ n, ConeRep S n x} := by
  classical
  rcases S.eq_empty_or_nonempty with rfl | hne
  · have : {x : E | ∃ n, ConeRep (∅ : Set E) n x} = {0} := by
      ext x
      constructor
      · rintro ⟨n, w, s, -, hs, rfl⟩
        cases n with
        | zero => simp
        | succ n => exact absurd (hs 0) (Set.notMem_empty _)
      · rintro rfl
        exact ⟨0, coneRep_zero _⟩
    rw [this]; exact isClosed_singleton
  set Z : Set E := (fun s => (ℓ s)⁻¹ • s) '' S with hZ
  have hZc : IsCompact Z := by
    refine hS.image_of_continuousOn ?_
    exact ContinuousOn.smul (ContinuousOn.inv₀ hℓc.continuousOn fun s hs => (hℓ s hs).ne')
      continuousOn_id
  set H := convexHull ℝ Z with hH
  have hHc : IsCompact H := isCompact_convexHull_of_isCompact hZc
  have hcone_convex : Convex ℝ {x : E | ∃ n, ConeRep S n x} := by
    intro x hx y hy a b ha hb _
    obtain ⟨n, hn⟩ := hx
    obtain ⟨m, hm⟩ := hy
    exact ⟨n + m, coneRep_add (coneRep_smul hn ha) (coneRep_smul hm hb)⟩
  have hZcone : Z ⊆ {x : E | ∃ n, ConeRep S n x} := by
    rintro _ ⟨s, hs, rfl⟩
    exact ⟨1, coneRep_single hs (inv_nonneg.2 (hℓ s hs).le)⟩
  have hHcone : H ⊆ {x : E | ∃ n, ConeRep S n x} := convexHull_min hZcone hcone_convex
  have hℓH : ∀ h ∈ H, ℓ h = 1 := by
    have hconv : Convex ℝ {x : E | ℓ x = 1} := by
      intro x hx y hy a b ha hb hab
      simp only [mem_ofPred_eq] at *
      rw [map_add, map_smul, map_smul, hx, hy]
      simp only [smul_eq_mul, mul_one]; exact hab
    refine fun h hh => convexHull_min ?_ hconv hh
    rintro _ ⟨s, hs, rfl⟩
    show ℓ ((ℓ s)⁻¹ • s) = 1
    rw [map_smul, smul_eq_mul, inv_mul_cancel₀ (hℓ s hs).ne']
  obtain ⟨s0, hs0⟩ := hne
  have hH0 : H.Nonempty := ⟨_, subset_convexHull ℝ Z ⟨s0, hs0, rfl⟩⟩
  -- every element of the cone is `t • h`
  have hdecomp : ∀ x, (∃ n, ConeRep S n x) → ∃ t : ℝ, 0 ≤ t ∧ ∃ h ∈ H, x = t • h := by
    rintro x ⟨n, w, s, hw, hs, rfl⟩
    set t : ℝ := ∑ i, w i * ℓ (s i) with ht
    have hterm : ∀ i, 0 ≤ w i * ℓ (s i) := fun i => mul_nonneg (hw i) (hℓ _ (hs i)).le
    by_cases ht0 : t = 0
    · have hz : ∀ i, w i = 0 := fun i => by
        have h1 := (Finset.sum_eq_zero_iff_of_nonneg (fun i _ => hterm i)).1 ht0 i (mem_univ i)
        exact (mul_eq_zero.1 h1).resolve_right (hℓ _ (hs i)).ne'
      obtain ⟨h, hh⟩ := hH0
      refine ⟨0, le_rfl, h, hh, ?_⟩
      rw [zero_smul]
      exact Finset.sum_eq_zero fun i _ => by rw [hz i, zero_smul]
    · have htpos : 0 < t := lt_of_le_of_ne (Finset.sum_nonneg fun i _ => hterm i) (Ne.symm ht0)
      refine ⟨t, htpos.le, ∑ i, (w i * ℓ (s i) / t) • ((ℓ (s i))⁻¹ • s i), ?_, ?_⟩
      · apply (convex_convexHull ℝ Z).sum_mem
        · intro i _; exact div_nonneg (hterm i) htpos.le
        · rw [← Finset.sum_div, ← ht, div_self ht0]
        · intro i _; exact subset_convexHull ℝ Z ⟨s i, hs i, rfl⟩
      · rw [Finset.smul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [smul_smul, smul_smul]
        congr 1
        have := (hℓ _ (hs i)).ne'
        field_simp
  set Q : ℝ → Set E := fun T => (fun p : ℝ × E => p.1 • p.2) '' (Icc 0 T ×ˢ H) with hQdef
  have hQ : ∀ T, IsCompact (Q T) := fun T =>
    (isCompact_Icc.prod hHc).image (continuous_fst.smul continuous_snd)
  refine isClosed_of_closure_subset fun x hx => ?_
  have hmem : x ∈ closure (Q (ℓ x + 1)) := by
    rw [mem_closure_iff]
    intro V hV hxV
    obtain ⟨y, ⟨hyV, hyT⟩, hycone⟩ := mem_closure_iff.1 hx (V ∩ {y | ℓ y < ℓ x + 1})
      (hV.inter (isOpen_lt hℓc continuous_const)) ⟨hxV, by simp⟩
    obtain ⟨t, ht0, h, hh, rfl⟩ := hdecomp y hycone
    refine ⟨t • h, hyV, ⟨(t, h), ⟨⟨ht0, ?_⟩, hh⟩, rfl⟩⟩
    simp only [mem_ofPred_eq, map_smul, hℓH h hh, smul_eq_mul, mul_one] at hyT
    exact hyT.le
  rw [(hQ _).isClosed.closure_eq] at hmem
  obtain ⟨⟨t, h⟩, ⟨⟨ht0, _⟩, hh⟩, rfl⟩ := hmem
  obtain ⟨n, hn⟩ := hHcone hh
  exact ⟨n, coneRep_smul hn ht0⟩

end Closed

end ConeCar

end

/-- info: 'FormalResearch.ConvexGeometry.ConeCar.exists_coneRep_card_le' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms FormalResearch.ConvexGeometry.ConeCar.exists_coneRep_card_le

/-- info: 'FormalResearch.ConvexGeometry.ConeCar.isClosed_cone_of_isCompact' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms FormalResearch.ConvexGeometry.ConeCar.isClosed_cone_of_isCompact

end FormalResearch.ConvexGeometry
