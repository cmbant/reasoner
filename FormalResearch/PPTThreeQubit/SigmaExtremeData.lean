def fin3 (n : ℕ) : Fin 3 := ⟨n % 3, Nat.mod_lt _ (by norm_num)⟩
def fin5 (n : ℕ) : Fin 5 := ⟨n % 5, Nat.mod_lt _ (by norm_num)⟩
def fin8 (n : ℕ) : Fin 8 := ⟨n % 8, Nat.mod_lt _ (by norm_num)⟩

/-- The coefficient of `Y a b` in a selected row: direct (`f = 0`) or adjoint (`f ≠ 0`). -/
def rowCoef (key : ℕ × ℕ × ℕ × ℕ) (a b : Fin 5) : Kω :=
  if key.1 = 0 then
    coefD (fin3 key.2.1) Bω (kerV (fin3 key.2.1) (fin3 key.2.2.1)) (fin8 key.2.2.2) a b
  else star (coefD (fin3 key.2.1) Bω (kerV (fin3 key.2.1) (fin3 key.2.2.1)) (fin8 key.2.2.2) b a)

def selRow (r : Fin 24) : ℕ × ℕ × ℕ × ℕ := selRows.getD r.val (0, 0, 0, 0)

def lamK (t r : Fin 24) : Kω := (lamTab.getD t.val []).getD r.val 0

/-- The target functional `x₀₀ Y_{t+1} - x_{t+1} Y₀₀`, coefficients on `Y a b`. -/
def tgtK (t : Fin 24) (a b : Fin 5) : Kω :=
  (if a.val * 5 + b.val = t.val + 1 then Xω 0 0 else 0) -
    (if a = 0 ∧ b = 0 then Xω (fin5 ((t.val + 1) / 5)) (fin5 (t.val + 1)) else 0)

theorem cert : ∀ t : Fin 24, ∀ a b : Fin 5,
    ∑ r : Fin 24, lamK t r * rowCoef (selRow r) a b = tgtK t a b := by decide +kernel

theorem kernel_check : ∀ c κ : Fin 3, ptG c (Bω * Xω * Bωᴴ) *ᵥ kerV c κ = 0 := by decide +kernel

end FormalResearch.PPTThreeQubit
