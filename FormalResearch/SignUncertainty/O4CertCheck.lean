module

public import FormalResearch.SignUncertainty.O4CertEval
public import FormalResearch.SignUncertainty.O4CertData

/-!
# The box test of the `O4QuotientBound` certificate

`boxInp i j` is the ball input of the box `(i, j)`: `L ∈ [2i/(1000 NL), 2(i+1)/(1000 NL)]` (`L ≤ 0.002`), `t ∈ [j/NT, (j+1)/NT]`,
`s ∈ [1 - Lhi/8, 1 + 0.606 Lhi]` (paper (ii)), `a ∈ [Llo, Lhi (1 + Lhi/4)]` (paper (i)), `π ∈ [3.14159265358979323846, 3.14159265358979323847]`,
the tail error balls `(0, tailR)` and the Horner coefficients of `O4CertData`.  `checkBox i j` is the kernel test `hi(10000 |num|²) ≤ lo(169 |den|²)`
(division-free form of `|F| ≤ 0.13`), and `checkRange i0 i1` runs it over the boxes `i0 ≤ i < i1`, `0 ≤ j < NT`.

The data `NL, NT, tailR, csData` are generated by `gen_o4_boxes.py emit`; the same script re-runs the check in exact integer arithmetic mirroring these definitions.

Status: definitions.  The runs and the soundness theorem are in `O4CertRun*.lean`, `O4CertSound.lean`.
-/

@[expose] public section

namespace FormalResearch.SignUncertainty.O4Cert

/-- The ball of `π` from `Real.pi_gt_d20`, `Real.pi_lt_d20`. -/
def piB : Ball := Ball.hullQ 314159265358979323846 (10 ^ 20) 314159265358979323847 (10 ^ 20)

def boxInp (i j : ℕ) : Inp Ball :=
  let t : Ball := Ball.hullQ (j : ℤ) NT ((j : ℤ) + 1) NT
  { L := Ball.hullQ (2 * (i : ℤ)) (1000 * NL) (2 * ((i : ℤ) + 1)) (1000 * NL)
    s := Ball.hullQ (4000 * (NL : ℤ) - ((i : ℤ) + 1)) (4000 * NL) (500000 * (NL : ℤ) + 606 * ((i : ℤ) + 1)) (500000 * NL)
    a := Ball.hullQ (2 * (i : ℤ)) (1000 * NL) (((i : ℤ) + 1) * (2000 * (NL : ℤ) + ((i : ℤ) + 1))) (1000000 * NL * NL)
    t := t
    u := Ball.inv (ic 1 + t * t)
    pi := piB
    ipi := Ball.inv piB
    ipi2 := Ball.inv (piB * piB)
    q14 := Ball.rat 1 4
    q136 := Ball.rat 1 36
    er := ⟨0, tailR, true⟩
    ei := ⟨0, tailR, true⟩
    cs := csData.map fun pq => Ball.rat pq.1 pq.2 }

/-- The box test. -/
def checkBox (i j : ℕ) : Bool :=
  let e := boxEval (boxInp i j)
  Ball.leMul 1 (boxSq e.1 10000) (boxSq e.2 169)

/-- All boxes `i0 ≤ i < i1`, `j < NT`. -/
def checkRange (i0 i1 : ℕ) : Bool :=
  (List.range' i0 (i1 - i0)).all fun i => (List.range NT).all fun j => checkBox i j

end FormalResearch.SignUncertainty.O4Cert
