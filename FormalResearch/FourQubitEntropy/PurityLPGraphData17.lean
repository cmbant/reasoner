/-- Neighbourhood bitmasks of `C_17(1,3,4,5)` on 17 vertices (hexadecimal / list form). -/
def adj17L : List ℕ := [94266, 57461, 114922, 98773, 66475, 1879, 3758, 7516, 15032, 30064, 60128, 120256, 109441, 87811, 44551, 89102, 47133]

/-- The adjacency function of `C_17(1,3,4,5)` on 17 vertices. -/
def adj17 : Fin 17 → ℕ := fun i => adj17L.getD i.1 0

theorem adj17_spec : ∀ i j : Fin 17, (adj17 i).testBit j = decide ((i : ℕ) ≠ j ∧ (((j : ℕ) + 17 - i) % 17 ∈ ([1, 3, 4, 5] : List ℕ) ∨ ((i : ℕ) + 17 - j) % 17 ∈ ([1, 3, 4, 5] : List ℕ))) := by
  decide +kernel

theorem adj17_symm : ∀ i j : Fin 17, (adj17 i).testBit j = (adj17 j).testBit i := by
  decide +kernel

theorem adj17_irrefl : ∀ i : Fin 17, (adj17 i).testBit i = false := by
  decide +kernel

/-- Generators of the dihedral group of the circulant: the rotation `i ↦ i + 1` and the reflection `i ↦ n - 1 - i`. -/
def symGens17 : List (Equiv.Perm (Fin 17)) := [Equiv.addRight (1 : Fin 17), Fin.revPerm]

/-- The generators are automorphisms of the graph. -/
theorem symAut17 : ∀ x ∈ symGens17, ∀ i j : Fin 17, (adj17 (x i)).testBit (x j) = (adj17 i).testBit j := by
  intro x hx
  simp only [symGens17, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl <;> decide +kernel

