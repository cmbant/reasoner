/-- Neighbourhood bitmasks of the spin-flip extension of the 13-vertex graph of `verify_spinflip_tradeoff.py` (hexadecimal rows) on 14 vertices (all degrees odd). -/
def adjT14L : List ℕ := [14416, 5548, 11618, 13330, 15977, 11414, 2325, 15906, 14918, 9616, 702, 12789, 2459, 3005]

/-- The adjacency function of the spin-flip extension of the 13-vertex graph of `verify_spinflip_tradeoff.py` (hexadecimal rows) on 14 vertices. -/
def adjT14 : Fin 14 → ℕ := fun i => adjT14L.getD i.1 0

theorem adjT14_symm : ∀ i j : Fin 14, (adjT14 i).testBit j = (adjT14 j).testBit i := by
