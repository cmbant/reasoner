/-!
# Sharpness witnesses of the even-`n` purity--spin-flip tradeoff: n = 8, 10, 14

GENERATED by `gen_spinflip_tradeoff_even.py`; do not edit.  Source: `spinflip_tradeoff.tex`,
`thm:purity-spinflip-tradeoff` (sharpness clause), `code/verify_spinflip_tradeoff.py` (ST-2--ST-6).

The graph is given by its neighbourhood bitmasks `adjT<n>` (bit `j` of `adjT<n> i` is set iff `i ~ j`);
`adjT<n>_symm`, `adjT<n>_irrefl`, `adjT<n>_odd` check by `decide +kernel` that it is simple and that **every vertex has
odd degree**, so that `tau (gsn Γ) = 1` (`tau_gsn_eq_one`).  `rankSumT<n>` is the kernel-checked sum
`Σ_{|S| = k} 2^{k - rk_2 Γ[S,S^c]}` (bitmask recursion `maskSum`; for `n >= 14` over the cuts containing the last vertex
only, by complement symmetry, `sum_cuts_half`), and `piMean_graphT<n>` the resulting `π_k = L_n + c_n`.
Claim class: exact finite certificate (`decide +kernel`).
-/

@[expose] public section

open scoped BigOperators
open FormalResearch.NQubit

-- one kernel evaluation at a time: the kernel's cache grows with the number of cuts evaluated
set_option Elab.async false

namespace FormalResearch.FourQubitEntropy.PurityLP

open FormalResearch.NQubit.Pauli FormalResearch.NQubit.Reduced FormalResearch.NQubit.TimeReversal FormalResearch.NQubit.Shadow
open FormalResearch.FourQubitEntropy.SpinFlip

/-- Neighbourhood bitmasks of the spin-flip extension of the cycle `C_7` (the wheel `W_7`) on 8 vertices (all degrees odd). -/
def adjT8L : List ℕ := [194, 133, 138, 148, 168, 208, 161, 127]

/-- The adjacency function of the spin-flip extension of the cycle `C_7` (the wheel `W_7`) on 8 vertices. -/
def adjT8 : Fin 8 → ℕ := fun i => adjT8L.getD i.1 0

theorem adjT8_symm : ∀ i j : Fin 8, (adjT8 i).testBit j = (adjT8 j).testBit i := by
  decide +kernel

theorem adjT8_irrefl : ∀ i : Fin 8, (adjT8 i).testBit i = false := by
  decide +kernel

/-- Every vertex has odd degree. -/
theorem adjT8_odd : ∀ i : Fin 8, Odd (Finset.univ.filter fun j => adjGraph adjT8 i j = true).card := by
  decide +kernel

theorem rankSumT8 : ∑ S ∈ ((Finset.univ : Finset (Fin 8)).powersetCard 4), gK 4 (cutRankN adjT8 S) = 112 := by
  rw [sum_cuts_eq_maskSum (gK 4) 8 adjT8L adjT8 (fun i => rfl) (2 ^ 8 - 1) rfl 4]
  decide +kernel

/-- The graph state of the spin-flip extension of the cycle `C_7` (the wheel `W_7`) has `π_4 = L_8 + c_8 = 1/10` (rank histogram of the cuts, checked by the generator: rank 3 on 42 cuts, rank 4 on 28 cuts). -/
theorem piMean_graphT8 : meanRdmPurity (gsn (adjGraph adjT8)) 4 = 1 / 10 := by
  rw [piMean_gsn adjT8 adjT8_symm 4 112 (by norm_num) rankSumT8]
  norm_num [Nat.choose]

