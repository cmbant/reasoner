/-- Neighbourhood bitmasks of the circulant `C_20(3, 4, 5, 10)` on 20 vertices (all degrees odd). -/
def adjT20L : List ℕ := [230456, 460912, 921824, 795073, 541571, 34567, 69134, 138268, 276536, 553072, 57569, 115138, 230276, 460552, 921104, 793633, 538691, 28807, 57614, 115228]

/-- The adjacency function of the circulant `C_20(3, 4, 5, 10)` on 20 vertices. -/
def adjT20 : Fin 20 → ℕ := fun i => adjT20L.getD i.1 0

theorem adjT20_symm : ∀ i j : Fin 20, (adjT20 i).testBit j = (adjT20 j).testBit i := by
  decide +kernel

theorem adjT20_irrefl : ∀ i : Fin 20, (adjT20 i).testBit i = false := by
  decide +kernel

/-- Every vertex has odd degree. -/
theorem adjT20_odd : ∀ i : Fin 20, Odd (Finset.univ.filter fun j => adjGraph adjT20 i j = true).card := by
  decide +kernel

/-- Generators of the dihedral group of the circulant: the rotation `i ↦ i + 1` and the reflection `i ↦ n - 1 - i`. -/
def symGens20 : List (Equiv.Perm (Fin 20)) := [Equiv.addRight (1 : Fin 20), Fin.revPerm]

/-- The generators are automorphisms of the graph. -/
theorem symAut20 : ∀ x ∈ symGens20, ∀ i j : Fin 20, (adjT20 (x i)).testBit (x j) = (adjT20 i).testBit j := by
  intro x hx
  simp only [symGens20, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl <;> decide +kernel

