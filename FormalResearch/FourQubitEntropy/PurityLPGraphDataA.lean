/-- Neighbourhood bitmasks of path `P_4` (linear cluster) on 4 vertices. -/
def adj4 : Fin 4 → ℕ := fun i => ([2, 5, 10, 4] : List ℕ).getD i.1 0

theorem adj4_spec : ∀ i j : Fin 4, (adj4 i).testBit j = decide (((i : ℕ), (j : ℕ)) ∈ ([(0, 1), (1, 2), (2, 3)] : List (ℕ × ℕ)) ∨ ((j : ℕ), (i : ℕ)) ∈ ([(0, 1), (1, 2), (2, 3)] : List (ℕ × ℕ))) := by
  decide +kernel

theorem adj4_symm : ∀ i j : Fin 4, (adj4 i).testBit j = (adj4 j).testBit i := by
  decide +kernel

theorem adj4_irrefl : ∀ i : Fin 4, (adj4 i).testBit i = false := by
  decide +kernel

theorem rankSum4 : ∑ S ∈ ((Finset.univ : Finset (Fin 4)).powersetCard 2), 2 ^ (2 - cutRankN adj4 S) = 8 := by
  decide +kernel

/-- The rank histogram of `tab:graphs` / the theorem: rank 1 on 2 cuts, rank 2 on 4 cuts (and no other rank). -/
theorem rankHist4 :
    (((Finset.univ : Finset (Fin 4)).powersetCard 2).filter fun S => cutRankN adj4 S = 1).card = 2 ∧
    (((Finset.univ : Finset (Fin 4)).powersetCard 2).filter fun S => cutRankN adj4 S = 2).card = 4 ∧
    (((Finset.univ : Finset (Fin 4)).powersetCard 2).filter fun S => cutRankN adj4 S = 1 ∨ cutRankN adj4 S = 2).card = 6 := by
  decide +kernel

/-- The graph state of path `P_4` (linear cluster) has `π_2 = 1/3`. -/
theorem piMean_graph4 : piMean (gsn (adjGraph adj4)) 2 = 1 / 3 := by
  rw [piMean_gsn adj4 adj4_symm 2 8 (by norm_num) rankSum4]
  norm_num [Nat.choose]

