  x ^ 3 * (((931569 / 500000 : ℝ) + (-(128245999 / 125000000) : ℝ) * v + (181211596587 / 125000000000 : ℝ) * v ^ 2) + x * ((181211596587 / 125000000000 : ℝ) / 4 + (-(145754527521477 / 62500000000000) : ℝ) * v)) ^ 4 / 4 -
  ((63574592989 / 156250000000 : ℝ)) * (((89727 / 20000 : ℝ)) - ((1404 / 625 : ℝ)) * v - ((2247 / 2000 : ℝ)) * x)

