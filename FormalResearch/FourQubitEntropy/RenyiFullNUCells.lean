theorem nuG_nonneg {x v : ℝ} (hx0 : 0 ≤ x) (hx1 : x ≤ 1 / 25) (hv0 : -(3 / 25) ≤ v) (hv1 : v ≤ 3 / 25) :
    0 ≤ nuG x v := by
  by_cases hxa : x ≤ 1 / 50
  · exact nuG_cell0 (by linarith) (by linarith) (by linarith) (by linarith)
  · push Not at hxa
    by_cases hva : v ≤ 0
    · exact nuG_cell1 (by linarith) (by linarith) (by linarith) (by linarith)
    · push Not at hva
      by_cases hxb : x ≤ 3 / 100
      · exact nuG_cell2 (by linarith) (by linarith) (by linarith) (by linarith)
      · push Not at hxb
        by_cases hvb : v ≤ 3 / 50
        · exact nuG_cell3 (by linarith) (by linarith) (by linarith) (by linarith)
        · push Not at hvb
          exact nuG_cell4 (by linarith) (by linarith) (by linarith) (by linarith)

