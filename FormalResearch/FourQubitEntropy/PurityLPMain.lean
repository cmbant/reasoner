/-- **Exact minimum of `π_2` for `n = 4` qubits**: `min π_2 = 1/3`, attained by path `P_4` (linear cluster). -/
theorem minPurity4 :
    IsLeast {x : ℝ | ∃ ψ : Ψ 4, nsq ψ = 1 ∧ meanRdmPurity ψ 2 = x} (1 / 3) :=
  ⟨⟨gsn (adjGraph adj4), nsq_gsn _, piMean_graph4⟩, fun _ ⟨ψ, hψ, hx⟩ => hx ▸ lpBound4 ψ hψ⟩

/-- info: 'FormalResearch.FourQubitEntropy.PurityLP.minPurity4' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms minPurity4

