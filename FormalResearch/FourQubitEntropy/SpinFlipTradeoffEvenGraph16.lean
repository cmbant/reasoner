/-!
# Sharpness witnesses of the even-`n` purity--spin-flip tradeoff: n = 16

GENERATED by `gen_spinflip_tradeoff_even.py`; do not edit.  Source: `spinflip_tradeoff.tex`,
`thm:purity-spinflip-tradeoff` (sharpness clause), `code/verify_spinflip_tradeoff.py` (ST-2--ST-6).

The graph is given by its neighbourhood bitmasks `adjT<n>` (bit `j` of `adjT<n> i` is set iff `i ~ j`);
`adjT<n>_symm`, `adjT<n>_irrefl`, `adjT<n>_odd` check by `decide +kernel` that it is simple and that **every vertex has
odd degree**, so that `tau (gsn Γ) = 1` (`tau_gsn_eq_one`).  `rankSumT<n>` is the kernel-checked sum
`Σ_{|S| = k} 2^{k - rk_2 Γ[S,S^c]}` (bitmask recursion `maskSum`; for `n >= 14` over the cuts containing the last vertex
only, by complement symmetry, `sum_cuts_half`), and `piMean_graphT<n>` the resulting `π_k = L_n + c_n`.
Claim class: exact finite certificate (`decide +kernel`).
-/

@[expose] public section

open scoped BigOperators
open FormalResearch.NQubit

-- one kernel evaluation at a time: the kernel's cache grows with the number of cuts evaluated
set_option Elab.async false

namespace FormalResearch.FourQubitEntropy.PurityLP

open FormalResearch.NQubit.Pauli FormalResearch.NQubit.Reduced FormalResearch.NQubit.TimeReversal FormalResearch.NQubit.Shadow
open FormalResearch.FourQubitEntropy.SpinFlip

/-- Neighbourhood bitmasks of the circulant `C_16(2, 3, 4, 8)` on 16 vertices (all degrees odd). -/
def adjT16L : List ℕ := [28956, 57912, 50289, 35043, 4551, 9102, 18204, 36408, 7281, 14562, 29124, 58248, 50961, 36387, 7239, 14478]

/-- The adjacency function of the circulant `C_16(2, 3, 4, 8)` on 16 vertices. -/
def adjT16 : Fin 16 → ℕ := fun i => adjT16L.getD i.1 0

theorem adjT16_symm : ∀ i j : Fin 16, (adjT16 i).testBit j = (adjT16 j).testBit i := by
  decide +kernel

theorem adjT16_irrefl : ∀ i : Fin 16, (adjT16 i).testBit i = false := by
  decide +kernel

/-- Every vertex has odd degree. -/
theorem adjT16_odd : ∀ i : Fin 16, Odd (Finset.univ.filter fun j => adjGraph adjT16 i j = true).card := by
  decide +kernel

theorem leafT16_0 : maskSum (gK 8) 16 adjT16L (2 ^ 16 - 1) 13 7 (2 ^ 15) = 3060 := by
  decide +kernel

theorem leafT16_1 : maskSum (gK 8) 16 adjT16L (2 ^ 16 - 1) 13 6 (2 ^ 15 + 2 ^ 13) = 3060 := by
  decide +kernel

theorem leafT16_2 : maskSum (gK 8) 16 adjT16L (2 ^ 16 - 1) 13 6 (2 ^ 15 + 2 ^ 14) = 3060 := by
  decide +kernel

theorem leafT16_3 : maskSum (gK 8) 16 adjT16L (2 ^ 16 - 1) 13 5 (2 ^ 15 + 2 ^ 14 + 2 ^ 13) = 2340 := by
  decide +kernel

theorem rankSumT16 : ∑ S ∈ ((Finset.univ : Finset (Fin 16)).powersetCard 8), gK 8 (cutRankN adjT16 S) = 23040 := by
  refine (sum_cuts_half (gK 8) 16 8 15 7 rfl rfl rfl adjT16L adjT16 (fun i => rfl) adjT16_symm (2 ^ 16 - 1) rfl).trans ?_
  rw [maskSum_split (gK 8) 16 adjT16L (2 ^ 16 - 1) 14 15 7 6 (2 ^ 15) rfl rfl, maskSum_split (gK 8) 16 adjT16L (2 ^ 16 - 1) 13 14 7 6 (2 ^ 15) rfl rfl, maskSum_split (gK 8) 16 adjT16L (2 ^ 16 - 1) 13 14 6 5 (2 ^ 15 + 2 ^ 14) rfl rfl, leafT16_0, leafT16_1, leafT16_2, leafT16_3]

/-- The graph state of the circulant `C_16(2, 3, 4, 8)` has `π_8 = L_16 + c_16 = 1/143` (rank histogram of the cuts, checked by the generator: rank 6 on 1096 cuts, rank 7 on 6882 cuts, rank 8 on 4892 cuts). -/
theorem piMean_graphT16 : meanRdmPurity (gsn (adjGraph adjT16)) 8 = 1 / 143 := by
  rw [piMean_gsn adjT16 adjT16_symm 8 23040 (by norm_num) rankSumT16]
  norm_num [Nat.choose]


end FormalResearch.FourQubitEntropy.PurityLP
