def adj15L : List ℕ := [16852, 14268, 32203, 27286, 22539, 26434, 17957, 29455, 5799, 18922, 14694, 1564, 1430, 1198, 765]

/-- The adjacency function of the 56-edge graph of `thm:fourteenfifteen` (hexadecimal rows) on 15 vertices. -/
