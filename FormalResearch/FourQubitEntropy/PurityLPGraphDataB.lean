/-!
# Graph-state witnesses of the purity minima: n = 14, 15

GENERATED by `gen_lp_graphs.py`; do not edit.  Sources: `even_qubit_purity_minima.tex` (`thm:lptable`(2),
`tab:graphs`, `thm:fourteenfifteen`, `thm:sixteenseventeen`), `balanced_purity_18.tex` (`thm:eighteen`).

For each `n` the graph is given by its neighbourhood bitmasks `adj<n>` (bit `j` of `adj<n> i` set iff `i ~ j`);
`adj<n>_spec` checks that they are the stated circulant / edge list (where the paper gives one),
`adj<n>_symm`, `adj<n>_irrefl` that the graph is simple.  `rankSum<n>` is the kernel-checked sum
`Σ_{|S| = k} 2^{k - rk_2 Γ[S,S^c]}` and `piMean_graph<n>` the resulting value of `π_k` of the (normalised) graph
state `gsn`, which equals the Rains-LP value.  Claim class: exact finite certificate (`decide +kernel`).
-/

open scoped BigOperators
open FormalResearch.FrameFree.NQubit

namespace FormalResearch.FourQubitEntropy.PurityLP

/-- Neighbourhood bitmasks of the 47-edge graph of `thm:fourteenfifteen` (hexadecimal rows) on 14 vertices. -/
def adj14 : Fin 14 → ℕ := fun i => ([14568, 7152, 3432, 14421, 14858, 1159, 12687, 9571, 10950, 5394, 12964, 287, 9819, 5593] : List ℕ).getD i.1 0

theorem adj14_symm : ∀ i j : Fin 14, (adj14 i).testBit j = (adj14 j).testBit i := by
  decide +kernel

theorem adj14_irrefl : ∀ i : Fin 14, (adj14 i).testBit i = false := by
  decide +kernel

theorem rankSum14 : ∑ S ∈ ((Finset.univ : Finset (Fin 14)).powersetCard 7), 2 ^ (7 - cutRankN adj14 S) = 5296 := by
  decide +kernel

/-- The rank histogram of `tab:graphs` / the theorem: rank 5 on 60 cuts, rank 6 on 1684 cuts, rank 7 on 1688 cuts (and no other rank). -/
theorem rankHist14 :
    (((Finset.univ : Finset (Fin 14)).powersetCard 7).filter fun S => cutRankN adj14 S = 5).card = 60 ∧
    (((Finset.univ : Finset (Fin 14)).powersetCard 7).filter fun S => cutRankN adj14 S = 6).card = 1684 ∧
    (((Finset.univ : Finset (Fin 14)).powersetCard 7).filter fun S => cutRankN adj14 S = 7).card = 1688 ∧
    (((Finset.univ : Finset (Fin 14)).powersetCard 7).filter fun S => cutRankN adj14 S = 5 ∨ cutRankN adj14 S = 6 ∨ cutRankN adj14 S = 7).card = 3432 := by
  decide +kernel

/-- The graph state of the 47-edge graph of `thm:fourteenfifteen` (hexadecimal rows) has `π_7 = 331/27456`. -/
theorem piMean_graph14 : piMean (gsn (adjGraph adj14)) 7 = 331 / 27456 := by
  rw [piMean_gsn adj14 adj14_symm 7 5296 (by norm_num) rankSum14]
  norm_num [Nat.choose]

