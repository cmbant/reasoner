import FormalResearch.FourQubitEntropy.FlipGradientCertSs
import FormalResearch.FourQubitEntropy.Defect

/-!
# The spin-flip gradient identity (`lem:fqe-flip-gradient`, FGI/FG)

For `H = F - (3/4) n W₁` (`Hval = 4H`) the derivative along the spin-flip pencil
`s ↦ ψ + s ψ̃` at `s = 0` is
`d/ds Hval(ψ + s ψ̃) = (1/4) Re Σᵢ Yᵢ + Re s · (16 n² + 14 W₁ - 16 |s|²)`, `s = ψᵀ ε^{⊗4} ψ`,
where `Yᵢ = Σ_{idx} sgn(idx) Rᵢ(idx) Rᵢ(1 - idx)` is the pairing of the site tensor
`Rᵢ = 6 (Vᵢ - 8Uᵢ)` (`resTensor`) with its spin flip (`Ysum`). With `Rᵢ = 6 Xᵢ` this is
`d/dt H(z + t z̃) = (9/4) Re Σ Xᵢᵀ ε^{⊗6} Xᵢ + Re s (4 n² - 4|s|² + (7/2) W₁)` of `eq:fqe-flip-gradient`.

Proof. The polynomial identity `8 · H4dual z w = Rg z w + Rg w z` (`flipGradDefect_check`) is checked by
the kernel in pieces (`FlipGradientCert*.lean`, generated by `gen_flipgrad_certificate.py`):
`H4dual` is the `ε`-part of `4F - 3 n W₁` at the dual numbers `(z + ε z̃, w + ε ẑ)`, the *polarization*
of the identity (`DualJet.lean`), assembled from its blocks `n`, `P`, `T₁₂`, `T₁₃`, `T₁₄`, `W₁`
(`W₁` has zero `ε`-part, the Bloch vectors of the pencil being `(1 - s²)` times those of `ψ`). The
identity is the exact complex form `(4,2)` / `(2,4)` of FGI. It is transferred to every complex state by
`OpsHom`, and `hasDerivAt_generic` turns `H4dual` into the derivative.

Machine requirements: see `THEOREM_MAP.md` (the `FlipGradientCert*.lean` files take 20-61 s each, at most
8.3 GB resident including 6.3 GB of mapped `.olean` files).
-/

open scoped ComplexConjugate
open scoped FormalResearch.FourQubitEntropy.GenericOps

namespace FormalResearch.FourQubitEntropy

theorem Dual.ext' {p : Dual SP} {x y : SP} (ha : p.a = x) (hb : p.b = y) : p = ⟨x, y⟩ := by
  cases p; simp_all

theorem normD_eq : normG (dualZ zSP wSP) (dualW zSP wSP) = ⟨flipCertNa, flipCertNb⟩ :=
  Dual.ext' flipCertNa_eq flipCertNb_eq

theorem PD_eq : Pgen (dualZ zSP wSP) (dualW zSP wSP) = ⟨flipCertPa, flipCertPb⟩ :=
  Dual.ext' flipCertPa_eq flipCertPb_eq

theorem WD_eq : W1gen (dualZ zSP wSP) (dualW zSP wSP) = ⟨flipCertWa, flipCertWb⟩ :=
  Dual.ext' flipCertWa_eq flipCertWb_eq

theorem T12D_eq : T12gen (dualZ zSP wSP) (dualW zSP wSP) = ⟨flipCertT12a, flipCertT12b⟩ :=
  Dual.ext' flipCertT12a_eq flipCertT12b_eq

theorem T13D_eq : T13gen (dualZ zSP wSP) (dualW zSP wSP) = ⟨flipCertT13a, flipCertT13b⟩ :=
  Dual.ext' flipCertT13a_eq flipCertT13b_eq

theorem T14D_eq : T14gen (dualZ zSP wSP) (dualW zSP wSP) = ⟨flipCertT14a, flipCertT14b⟩ :=
  Dual.ext' flipCertT14a_eq flipCertT14b_eq

/-- The flip-gradient identity as an identity of polynomials in the 32 variables. -/
theorem flipGradDefect_check : flipGradDefect zSP wSP = [] := by
  unfold flipGradDefect Rg H4dual Ysum
  rw [H4gen_blocks, normD_eq, PD_eq, WD_eq, T12D_eq, T13D_eq, T14D_eq, flipCertY0_eq,
    flipCertY1_eq, flipCertY2_eq, flipCertY3_eq, flipCertYs0_eq, flipCertYs1_eq, flipCertYs2_eq,
    flipCertYs3_eq, flipCertS_eq, flipCertSs_eq]
  decide +kernel

/-- `8 · H4dual z w = Rg z w + Rg w z` for all complex `z`, `w`. -/
theorem flipGradDefect_zero (z w : State ℂ) : flipGradDefect z w = 0 := by
  have h := (opsHom_evSP (varValues z w)).flipGradDefect zSP wSP
  rw [map_zSP, map_wSP, flipGradDefect_check] at h
  exact h.symm

end FormalResearch.FourQubitEntropy
