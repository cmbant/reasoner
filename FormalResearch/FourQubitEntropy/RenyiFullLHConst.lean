import FormalResearch.FourQubitEntropy.RenyiFullLHLog

/-!
# Rational enclosures of the constants of the large-head dual (generated by `gen_lh_consts.py`)

`lhU = 1/((q-1) ln 2)`, `lhR = (127/73)^q`, `H0t = h(127/200, 3/4)`, `Hlt = h(1/2, 3/4)` at `q = q_s`, each
within `2·10⁻⁸` of the paper's rounded value (`(LH2)`).  The logarithms come from `artanh_enc`.
-/

namespace FormalResearch.FourQubitEntropy.RenyiFull

open Finset

noncomputable def lhU : ℝ := 1 / ((qS - 1) * Real.log 2)
noncomputable def lhR : ℝ := (127 / 73 : ℝ) ^ qS
noncomputable def H0t : ℝ := hfun qS (3 / 4) (127 / 200)
noncomputable def Hlt : ℝ := hfun qS (3 / 4) (1 / 2)

theorem log2_d9 : (6931471803 / 10000000000 : ℝ) < Real.log 2 ∧ Real.log 2 < 6931471808 / 10000000000 := by
  have h1 := Real.log_two_gt_d9
  have h2 := Real.log_two_lt_d9
  constructor <;> norm_num at h1 h2 ⊢ <;> linarith

theorem lhU_enc : (6144357 / 2500000 : ℝ) ≤ lhU ∧ lhU ≤ (61443571 / 25000000 : ℝ) := by
  have h := log2_d9
  have hq : qS = 1587 / 1000 := rfl
  unfold lhU
  rw [hq]
  have hp : 0 < ((1587 / 1000 : ℝ) - 1) * Real.log 2 := by
    have : 0 < Real.log 2 := by linarith [h.1]
    positivity
  constructor
  · rw [le_div_iff₀ hp]; nlinarith [h.1, h.2]
  · rw [div_le_iff₀ hp]; nlinarith [h.1, h.2]

theorem lhR_enc : (15049537 / 6250000 : ℝ) ≤ lhR ∧ lhR ≤ (60198149 / 25000000 : ℝ) := by
  unfold lhR
  constructor
  · have := le_rpow_qS_Q (x := (127 / 73 : ℚ)) (b := (240792594467 / 100000000000 : ℚ)) (by norm_num) (by norm_num) (by decide +kernel)
    simp at this; linarith
  · have := rpow_qS_le_Q (x := (127 / 73 : ℚ)) (b := (24079259447 / 10000000000 : ℚ)) (by norm_num) (by norm_num) (by decide +kernel)
    simp at this; linarith

theorem H0t_enc : (110489071 / 100000000 : ℝ) ≤ H0t ∧ H0t ≤ (4419563 / 4000000 : ℝ) := by
  have h := log2_d9
  have hq : qS = 1587 / 1000 := rfl
  have e1 : (1 - 127 / 200 : ℝ) = 73 / 200 := by norm_num
  have p1 := le_rpow_qS_Q (x := (127 / 200 : ℚ)) (b := (9728186719 / 20000000000 : ℚ)) (by norm_num) (by norm_num) (by decide +kernel)
  have p2 := rpow_qS_le_Q (x := (127 / 200 : ℚ)) (b := (24320466799 / 50000000000 : ℚ)) (by norm_num) (by norm_num) (by decide +kernel)
  have p3 := le_rpow_qS_Q (x := (73 / 200 : ℚ)) (b := (5050086123 / 25000000000 : ℚ)) (by norm_num) (by norm_num) (by decide +kernel)
  have p4 := rpow_qS_le_Q (x := (73 / 200 : ℚ)) (b := (4040068899 / 20000000000 : ℚ)) (by norm_num) (by norm_num) (by decide +kernel)
  simp at p1 p2 p3 p4
  have hZ : lhZ qS (3 / 4) (127 / 200) = (127 / 200 : ℝ) ^ qS + 3 / 4 * (73 / 200 : ℝ) ^ qS := by
    unfold lhZ; rw [e1]
  have hZ1 : (15947797991 / 25000000000 : ℝ) ≤ lhZ qS (3 / 4) (127 / 200) := by rw [hZ]; linarith
  have hZ2 : lhZ qS (3 / 4) (127 / 200) ≤ (255164767877 / 400000000000 : ℝ) := by rw [hZ]; linarith
  have hpos : 0 < lhZ qS (3 / 4) (127 / 200) := lt_of_lt_of_le (by norm_num) hZ1
  have l1 := neglog_enc_ge (Z := (255164767877 / 400000000000 : ℝ)) (y := (144835232123 / 655164767877 : ℝ)) (by norm_num) (by norm_num) (by norm_num) 6
  have l2 := neglog_enc_le (Z := (15947797991 / 25000000000 : ℝ)) (y := (9052202009 / 40947797991 : ℝ)) (by norm_num) (by norm_num) (by norm_num) 6
  have m1 : Real.log (lhZ qS (3 / 4) (127 / 200)) ≤ Real.log (255164767877 / 400000000000 : ℝ) := Real.log_le_log hpos hZ2
  have m2 : Real.log (15947797991 / 25000000000 : ℝ) ≤ Real.log (lhZ qS (3 / 4) (127 / 200)) := Real.log_le_log (by norm_num) hZ1
  norm_num [artS, artT, Finset.sum_range_succ] at l1 l2
  unfold H0t hfun
  have hr : qS - 1 = 587 / 1000 := by rw [hq]; norm_num
  rw [hr]
  have hc : 0 < (587 / 1000 : ℝ) * Real.log 2 := by
    have : 0 < Real.log 2 := by linarith [h.1]
    positivity
  constructor
  · rw [le_div_iff₀ hc]; nlinarith [h.1, h.2]
  · rw [div_le_iff₀ hc]; nlinarith [h.1, h.2]

theorem Hlt_enc : (6640929 / 5000000 : ℝ) ≤ Hlt ∧ Hlt ≤ (16602323 / 12500000 : ℝ) := by
  have h := log2_d9
  have hq : qS = 1587 / 1000 := rfl
  have l1 := log_enc_ge (Z := (7 / 4 : ℝ)) (y := 3 / 11) (by norm_num) (by norm_num) (by norm_num) 7
  have l2 := log_enc_le (Z := (7 / 4 : ℝ)) (y := 3 / 11) (by norm_num) (by norm_num) (by norm_num) 7
  norm_num [artS, artT, Finset.sum_range_succ] at l1 l2
  have e : hfun qS (3 / 4) (1 / 2) = (qS * Real.log 2 - Real.log (7 / 4)) / ((qS - 1) * Real.log 2) := by
    unfold hfun lhZ
    have e1 : (1 - 1 / 2 : ℝ) = 1 / 2 := by norm_num
    rw [e1]
    have e2 : ((1 / 2 : ℝ) ^ qS + 3 / 4 * (1 / 2 : ℝ) ^ qS) = (1 / 2 : ℝ) ^ qS * (7 / 4) := by ring
    rw [e2, Real.log_mul (by positivity) (by norm_num), Real.log_rpow (by norm_num)]
    have : Real.log (1 / 2 : ℝ) = -Real.log 2 := by rw [one_div, Real.log_inv]
    rw [this]
    ring
  unfold Hlt
  rw [e]
  have hr : qS - 1 = 587 / 1000 := by rw [hq]; norm_num
  rw [hr, hq]
  have hc : 0 < (587 / 1000 : ℝ) * Real.log 2 := by
    have : 0 < Real.log 2 := by linarith [h.1]
    positivity
  constructor
  · rw [le_div_iff₀ hc]; nlinarith [h.1, h.2]
  · rw [div_le_iff₀ hc]; nlinarith [h.1, h.2]

end FormalResearch.FourQubitEntropy.RenyiFull
