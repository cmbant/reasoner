module

public import FormalResearch.FourQubitEntropy.PurityLPMaskSum
public import FormalResearch.NQubit.Graph.Symmetry

/-!
# Rank sums over orbit representatives (kernel form)

`sum_cuts_reps`: for a graph with a group of automorphisms generated by `gens`, the rank sum
`Σ_{|S| = k} g(rk_2 Γ[S,S^c])` equals `Σ_r w_r · maskVal g n L full m_r` over a list `R = [(m_r, w_r)]` of orbit
representatives with orbit sizes (`FormalResearch.NQubit.Graph.sum_rankFn_eq_reps`), the hypotheses being cheap decidable checks on lists.
The data modules (`SpinFlipTradeoffEvenGraph16/20`) check them by `decide +kernel` and evaluate `maskVal` only at the
representatives.
-/

@[expose] public section

open scoped BigOperators

namespace FormalResearch.FourQubitEntropy.PurityLP

open FormalResearch.NQubit.Graph

theorem twoPow_filter_testBit (n m : ℕ) (hm : m < 2 ^ n) :
    twoPow ((Finset.range n).filter fun i => m.testBit i) = m := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [testBit_twoPow]
  by_cases hj : j < n
  · by_cases h : m.testBit j = true <;> simp [hj, h]
  · have : m.testBit j = false :=
      Nat.testBit_lt_two_pow (lt_of_lt_of_le hm (Nat.pow_le_pow_right (by norm_num) (not_lt.mp hj)))
    simp [hj, this]

theorem maskVal_unmask (g : ℕ → ℕ) (n : ℕ) (L : List ℕ) (adj : Fin n → ℕ) (hadj : ∀ i, adj i = L.getD i.1 0)
    (full : ℕ) (hf : full = 2 ^ n - 1) (m : ℕ) (hm : m < 2 ^ n) :
    maskVal g n L full m = g (graphCutRankBits adj (unmask n m)) := by
  have h := maskVal_twoPow g n L adj hadj full hf ((Finset.range n).filter fun i => m.testBit i)
    (fun x hx => (Finset.mem_filter.mp hx).1)
  rw [twoPow_filter_testBit n m hm] at h
  rw [h]
  congr 2
  ext i
  simp [mem_unmask]

/-- **Rank sum over orbit representatives** (`FormalResearch.NQubit.Graph.sum_rankFn_eq_reps`, with the cut ranks read off by
`maskVal`). -/
theorem sum_cuts_reps (g : ℕ → ℕ) (n : ℕ) (L : List ℕ) (adj : Fin n → ℕ) (hadj : ∀ i, adj i = L.getD i.1 0)
    (full : ℕ) (hf : full = 2 ^ n - 1) (gens : List (Equiv.Perm (Fin n)))
    (hgens : ∀ x ∈ gens, ∀ i j, (adj (x i)).testBit (x j) = (adj i).testBit j) (k : ℕ)
    (GLs : List (List ℕ)) (hGL : GLs = genLists gens) (GS : List ℕ)
    (hGS : ∀ j < GLs.length, GS.getD j 0 < n ∧ (GS.getD j 0 = 0 ∨ GLs.getD j [] = rotList n (GS.getD j 0)))
    (D : List (Bool × ℕ)) (hD : ∀ e ∈ D, e.2 < GLs.length) (Q : List (List ℕ)) (hQ : Q = derivQ n GLs D)
    (hnd : Q.Nodup) (hclosed : ∀ q ∈ Q, ∀ gl ∈ GLs, compL q gl ∈ Q)
    (R : List (ℕ × ℕ)) (hlt : incrB R = true)
    (hR : R.all (repOK n k GLs GS D) = true) (hsum : (R.map Prod.snd).sum = Nat.choose n k) :
    ∑ S ∈ (Finset.univ : Finset (Fin n)).powersetCard k, g (graphCutRankBits adj S)
      = (R.map fun p => p.2 * maskVal g n L full p.1).sum := by
  rw [sum_rankFn_eq_reps gens adj hgens g k GLs hGL GS hGS D hD Q hQ hnd hclosed R hlt hR hsum]
  congr 1
  refine List.map_congr_left fun p hp => ?_
  have h1 : p.1 < 2 ^ n := by
    have h := (List.all_eq_true.mp hR) p hp
    unfold repOK at h
    cases hs : scanImgs p.1 (imgs n GLs GS D p.1) with
    | mk b c =>
      rw [hs] at h
      simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      exact h.1.1.1
  rw [maskVal_unmask g n L adj hadj full hf p.1 h1]

end FormalResearch.FourQubitEntropy.PurityLP
