/-- `∂M/∂ξ ≥ 0` for `0 ≤ s < 1`, `s ≤ ξ ≤ 1` (BQ-4 at `q_s`). -/
theorem bqdM_nonneg {s xi : ℝ} (hs0 : 0 ≤ s) (hs1 : s < 1) (hxs : s ≤ xi) (hx1 : xi ≤ 1) :
    0 ≤ bqdM s xi := by
  have h1s : 0 < 1 - s := by linarith
  obtain ⟨tau, ht0, ht1, hxi⟩ : ∃ tau : ℝ, 0 ≤ tau ∧ tau ≤ 1 ∧ xi = s + tau * (1 - s) :=
    ⟨(xi - s) / (1 - s), div_nonneg (by linarith) h1s.le,
      by rw [div_le_one h1s]; linarith, by field_simp; ring⟩
  subst hxi
  have box : ∀ lo d : ℝ, 0 < d → lo ≤ s → s ≤ lo + d → ∃ w : ℝ, 0 ≤ w ∧ w ≤ 1 ∧ s = lo + d * w :=
    fun lo d hd a b => ⟨(s - lo) / d, div_nonneg (by linarith) hd.le,
      by rw [div_le_one hd]; linarith, by field_simp; ring⟩
  by_cases ha0 : s ≤ (1 / 2 : ℝ)
  · obtain ⟨w, hw0, hw1, hw⟩ := box (0 : ℝ) (1 / 2 : ℝ) (by norm_num) hs0 (by linarith)
    exact bqdM_cell0 hw hw0 hw1 ht0 ht1
  · push Not at ha0
    by_cases ha1 : s ≤ (3 / 4 : ℝ)
    · obtain ⟨w, hw0, hw1, hw⟩ := box (1 / 2 : ℝ) (1 / 4 : ℝ) (by norm_num) ha0.le (by linarith)
      exact bqdM_cell1 hw hw0 hw1 ht0 ht1
    · push Not at ha1
      by_cases ha2 : s ≤ (7 / 8 : ℝ)
      · obtain ⟨w, hw0, hw1, hw⟩ := box (3 / 4 : ℝ) (1 / 8 : ℝ) (by norm_num) ha1.le (by linarith)
        exact bqdM_cell2 hw hw0 hw1 ht0 ht1
      · push Not at ha2
        obtain ⟨w, hw0, hw1, hw⟩ := box (7 / 8 : ℝ) (1 / 8 : ℝ) (by norm_num) ha2.le (by linarith)
        exact bqdM_cell3 hw hw0 hw1 ht0 ht1

