      (2259007561 / 1000000000 : ℝ) * (s1 ^ 1 * (1 - s1) ^ 1) * (s2 ^ 0 * (1 - s2) ^ 1) +
      (2039338187 / 2000000000 : ℝ) * (s1 ^ 1 * (1 - s1) ^ 1) * (s2 ^ 1 * (1 - s2) ^ 0) +
      (498161109 / 500000000 : ℝ) * (s1 ^ 2 * (1 - s1) ^ 0) * (s2 ^ 0 * (1 - s2) ^ 1) +
