module

public import FormalResearch.FourQubitEntropy.RenyiFullSliverCells
public import FormalResearch.FourQubitEntropy.RenyiFullRpow

/-!
# The concavity / endpoint argument of `lem:fqe-cluster-sliver` (generated by `gen_sliver_core.py`)

Paper E, `sup_renyi.tex`, proof of `lem:fqe-cluster-sliver`, paragraphs *Removing ε* and *One-variable signs*:

* `yL1`, `yL2`, `yL3`: lower bounds for `y = u^{8/5}` (`≥ (12/5)u²` on `[0,1/16]`, `≥ (357/50)u²` on `[0,1/140]`,
  `≥ Q(u)` on `[0,(23/40)^5]` by the Hermite identity `slQ_identity`);
* `chord`: `P` is concave in `v` (`f ≤ 0`), so `P(u, v) ≥` the chord through `v = 0` and `v = v_m`;
* `end_Sm`, `end_Sp`: `P(u,v₀) + (5/2) y ≥ 0` for `0 ≤ v₀ ≤ min(2(u-u²), V(u))`, strictly if `u > 0`;
* `core_Sm`, `core_Sp`: removing `ε` (`v - v₀ ≤ 21ε/10`), giving `(9/10) ε ≤ P + (5/2) y + ε (A + B v)`.
-/

@[expose] public section

namespace FormalResearch.FourQubitEntropy.RenyiFull

set_option exponentiation.threshold 5000

theorem rpow_mul_two_fifths {u : ℝ} (hu : 0 < u) : u ^ (8 / 5 : ℝ) * u ^ (2 / 5 : ℝ) = u ^ 2 := by
  rw [← Real.rpow_add hu, show (8 / 5 : ℝ) + 2 / 5 = (2 : ℕ) by norm_num, Real.rpow_natCast]

theorem yL_aux {u : ℝ} (hu : 0 ≤ u) {b : ℝ} (hb : 0 < b) (h : u ^ (2 / 5 : ℝ) ≤ b) :
    u ^ 2 / b ≤ u ^ (8 / 5 : ℝ) := by
  rcases hu.eq_or_lt with h0 | h0
  · subst h0; rw [Real.zero_rpow (by norm_num)]; norm_num
  · rw [div_le_iff₀ hb, ← rpow_mul_two_fifths h0]
    exact mul_le_mul_of_nonneg_left h (Real.rpow_nonneg hu _)

theorem yL1 {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ 1 / 16) : 12 / 5 * u ^ 2 ≤ u ^ (8 / 5 : ℝ) := by
  have h1 : u ^ (2 / 5 : ℝ) ≤ (1 / 16 : ℝ) ^ (2 / 5 : ℝ) := Real.rpow_le_rpow hu0 hu1 (by norm_num)
  have h2 := rpow_le_of_le_pow (x := (1 / 16 : ℝ)) (b := 5 / 12) (m := 2) (n := 5)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  have h3 : ((2 : ℕ) : ℝ) / ((5 : ℕ) : ℝ) = (2 : ℝ) / 5 := by norm_num
  rw [h3] at h2
  have := yL_aux hu0 (by norm_num : (0 : ℝ) < 5 / 12) (by linarith)
  calc 12 / 5 * u ^ 2 = u ^ 2 / (5 / 12) := by ring
    _ ≤ _ := this

theorem yL2 {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ 1 / 140) : 357 / 50 * u ^ 2 ≤ u ^ (8 / 5 : ℝ) := by
  have h1 : u ^ (2 / 5 : ℝ) ≤ (1 / 140 : ℝ) ^ (2 / 5 : ℝ) := Real.rpow_le_rpow hu0 hu1 (by norm_num)
  have h2 := rpow_le_of_le_pow (x := (1 / 140 : ℝ)) (b := 50 / 357) (m := 2) (n := 5)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  have h3 : ((2 : ℕ) : ℝ) / ((5 : ℕ) : ℝ) = (2 : ℝ) / 5 := by norm_num
  rw [h3] at h2
  have := yL_aux hu0 (by norm_num : (0 : ℝ) < 50 / 357) (by linarith)
  calc 357 / 50 * u ^ 2 = u ^ 2 / (50 / 357) := by ring
    _ ≤ _ := this

theorem yL3 {u : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ (6436343 / 102400000 : ℝ)) : slQ u ≤ u ^ (8 / 5 : ℝ) := by
  set x := u ^ ((1 : ℝ) / 5) with hx
  have hx0 : 0 ≤ x := Real.rpow_nonneg hu0 _
  have hx5 : x ^ 5 = u := by
    rw [hx, ← Real.rpow_natCast, ← Real.rpow_mul hu0]; norm_num
  have hx8 : x ^ 8 = u ^ (8 / 5 : ℝ) := by
    rw [hx, ← Real.rpow_natCast, ← Real.rpow_mul hu0]; norm_num
  have hxZ : x ≤ 23 / 40 := by
    by_contra hlt
    push Not at hlt
    have := pow_lt_pow_left₀ hlt (by norm_num) (by norm_num : (5 : ℕ) ≠ 0)
    rw [hx5] at this
    norm_num at this hu1
    linarith
  have hid := slQ_identity x
  have hQ : slQ (x ^ 5) = slQ u := by rw [hx5]
  have hS := slQ_S_nonneg hx0
  have : 0 ≤ (x - 2 / 5) ^ 2 * (23 / 40 - x) * _ :=
    mul_nonneg (mul_nonneg (sq_nonneg _) (by linarith)) hS
  linarith [hid, hQ, hx8]

/-- `P` is concave in `v`: the chord inequality. -/
theorem chord {a b c d f g u v vm C : ℝ} (hf : f ≤ 0) (hv0 : 0 ≤ v) (hv : v ≤ vm) :
    (vm - v) * (slP a b c d f g u 0 + C) + v * (slP a b c d f g u vm + C) ≤
      vm * (slP a b c d f g u v + C) := by
  have h := mul_nonneg (mul_nonneg (mul_nonneg (neg_nonneg.2 hf) hv0) (le_trans hv0 hv)) (sub_nonneg.2 hv)
  have key : vm * (slP a b c d f g u v + C) - ((vm - v) * (slP a b c d f g u 0 + C) +
      v * (slP a b c d f g u vm + C)) = (-f) * v * vm * (vm - v) := by
    unfold slP; ring
  linarith

/-- From the chord and positivity of both endpoints. -/
theorem chord_pos {a b c d f g u v vm C : ℝ} (hf : f ≤ 0) (hv0 : 0 ≤ v) (hv : v ≤ vm) (hvm : 0 < vm)
    (h0 : 0 < slP a b c d f g u 0 + C) (h1 : 0 < slP a b c d f g u vm + C) :
    0 < slP a b c d f g u v + C := by
  have h := chord (a := a) (b := b) (c := c) (d := d) (g := g) (C := C) (u := u) hf hv0 hv
  set m := min (slP a b c d f g u 0 + C) (slP a b c d f g u vm + C) with hm
  have hmpos : 0 < m := lt_min h0 h1
  have m0 : m ≤ slP a b c d f g u 0 + C := min_le_left _ _
  have m1 : m ≤ slP a b c d f g u vm + C := min_le_right _ _
  have e1 := mul_le_mul_of_nonneg_left m0 (sub_nonneg.2 hv)
  have e2 := mul_le_mul_of_nonneg_left m1 hv0
  have : 0 < vm * (slP a b c d f g u v + C) := by nlinarith
  exact (mul_pos_iff_of_pos_left hvm).1 this

/-- Endpoint analysis for row `Sm`: `P(u,v₀) + (5/2) y ≥ 0` (strict for `u > 0`) when
`0 ≤ v₀ ≤ min (2(u-u²)) (V u)`. -/
theorem end_Sm {u v y : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ 1 / 16) (hv0 : 0 ≤ v)
    (hva : v ≤ 2 * (u - u ^ 2)) (hvb : v ≤ slV u) (hy1 : 12 / 5 * u ^ 2 ≤ y)
    (hy2 : u ≤ 1 / 140 → 357 / 50 * u ^ 2 ≤ y) (hy3 : 1 / 140 ≤ u → slQ u ≤ y) :
    0 ≤ slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u v + 5 / 2 * y ∧
      (0 < u → 0 < slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u v + 5 / 2 * y) := by
  rcases hu0.eq_or_lt with h0 | h0
  · subst h0
    have hv : v = 0 := by nlinarith
    subst hv
    have : 0 ≤ y := by nlinarith
    refine ⟨?_, fun h => absurd h (lt_irrefl _)⟩
    unfold slP; nlinarith
  · have hg0 : 0 < slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u 0 + 5 / 2 * y := by
      unfold slP; nlinarith [mul_pos h0 h0]
    have hu_w : 0 < u - u ^ 2 := by nlinarith
    have hpos : 0 < slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u v + 5 / 2 * y := by
      rcases le_or_gt u (1 / 140) with hs | hs
      · have hy := hy2 hs
        have hm : 0 < slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u (2 * (u - u ^ 2)) + 5 / 2 * y := by
          have hq : 0 < u * (-581 * u^3/25 + 1027 * u^2/25 - 716 * u/125 + 11/250) := by
            apply mul_pos h0
            nlinarith [mul_pos h0 h0, mul_pos (mul_pos h0 h0) h0]
          have e : slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u (2 * (u - u ^ 2)) + 5 / 2 * (357 / 50 * u ^ 2) = u * (-581 * u^3/25 + 1027 * u^2/25 - 716 * u/125 + 11/250) := by
            unfold slP; ring
          linarith
        exact chord_pos (by norm_num) hv0 hva (by linarith) hg0 hm
      · have hy := hy3 hs.le
        have hm := slC_Sm (u := u) hs.le (by linarith)
        have hVpos : 0 < slV u := by
          unfold slV
          apply div_pos (by nlinarith)
          linarith
        have hm' : 0 < slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u (slV u) + 5 / 2 * y := by linarith
        exact chord_pos (by norm_num) hv0 hvb hVpos hg0 hm'
    exact ⟨hpos.le, fun _ => hpos⟩

/-- Removing `ε` for the row `Sm`: if `v - v₀ ≤ 21ε/10`, then `P(u,v) + ε (A + B v) ≥ P(u,v₀) + 9ε/10`. -/
theorem core_Sm {u v v0 e : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ 1 / 16) (hv0 : 0 ≤ v0) (hv : v0 ≤ v)
    (hv1 : v ≤ 1 / 20) (he0 : 0 ≤ e) (hd : v - v0 ≤ 21 / 10 * e) :
    slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u v0 + 9 / 10 * e ≤ slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u v + e * ((37 / 20 : ℝ) + (8 : ℝ) * v) := by
  have hΔ0 : 0 ≤ v - v0 := by linarith
  have key : slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u v = slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-(571 / 100) : ℝ) (-(33 / 10) : ℝ) (-(281 / 100) : ℝ) (6 : ℝ) u v0 +
      (v - v0) * ((7 / 500 : ℝ) + (-(33 / 10) : ℝ) * u + (6 : ℝ) * u ^ 2 + (-(281 / 100) : ℝ) * (v + v0)) := by
    unfold slP; ring
  have hbr : -(769 / 4000 : ℝ) + 2 * (-(281 / 100) : ℝ) * v ≤ (7 / 500 : ℝ) + (-(33 / 10) : ℝ) * u + (6 : ℝ) * u ^ 2 + (-(281 / 100) : ℝ) * (v + v0) := by
    nlinarith [mul_nonneg hu0 hu0]
  have hneg : -(769 / 4000 : ℝ) + 2 * (-(281 / 100) : ℝ) * v ≤ 0 := by nlinarith
  have h1 := mul_le_mul_of_nonneg_left hbr hΔ0
  have h2 := mul_le_mul_of_nonneg_right hd (by linarith : 0 ≤ (769 / 4000 : ℝ) - 2 * (-(281 / 100) : ℝ) * v)
  have h3 : 0 ≤ e * ((37 / 20 : ℝ) - 21 / 10 * (769 / 4000 : ℝ) + ((8 : ℝ) + 21 / 5 * (-(281 / 100) : ℝ)) * v - 9 / 10) := by
    apply mul_nonneg he0
    nlinarith
  nlinarith [h1, h2, h3]

/-- Endpoint analysis for row `Sp`: `P(u,v₀) + (5/2) y ≥ 0` (strict for `u > 0`) when
`0 ≤ v₀ ≤ min (2(u-u²)) (V u)`. -/
theorem end_Sp {u v y : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ 1 / 16) (hv0 : 0 ≤ v)
    (hva : v ≤ 2 * (u - u ^ 2)) (hvb : v ≤ slV u) (hy1 : 12 / 5 * u ^ 2 ≤ y)
    (hy2 : u ≤ 1 / 140 → 357 / 50 * u ^ 2 ≤ y) (hy3 : 1 / 140 ≤ u → slQ u ≤ y) :
    0 ≤ slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u v + 5 / 2 * y ∧
      (0 < u → 0 < slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u v + 5 / 2 * y) := by
  rcases hu0.eq_or_lt with h0 | h0
  · subst h0
    have hv : v = 0 := by nlinarith
    subst hv
    have : 0 ≤ y := by nlinarith
    refine ⟨?_, fun h => absurd h (lt_irrefl _)⟩
    unfold slP; nlinarith
  · have hg0 : 0 < slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u 0 + 5 / 2 * y := by
      unfold slP; nlinarith [mul_pos h0 h0]
    have hu_w : 0 < u - u ^ 2 := by nlinarith
    have hpos : 0 < slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u v + 5 / 2 * y := by
      rcases le_or_gt u (1 / 140) with hs | hs
      · have hy := hy2 hs
        have hm : 0 < slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u (2 * (u - u ^ 2)) + 5 / 2 * y := by
          have hq : 0 < u * (-103 * u^3/5 + 961 * u^2/25 - 3009 * u/500 + 11/250) := by
            apply mul_pos h0
            nlinarith [mul_pos h0 h0, mul_pos (mul_pos h0 h0) h0]
          have e : slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u (2 * (u - u ^ 2)) + 5 / 2 * (357 / 50 * u ^ 2) = u * (-103 * u^3/5 + 961 * u^2/25 - 3009 * u/500 + 11/250) := by
            unfold slP; ring
          linarith
        exact chord_pos (by norm_num) hv0 hva (by linarith) hg0 hm
      · have hy := hy3 hs.le
        have hm := slC_Sp (u := u) hs.le (by linarith)
        have hVpos : 0 < slV u := by
          unfold slV
          apply div_pos (by nlinarith)
          linarith
        have hm' : 0 < slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u (slV u) + 5 / 2 * y := by linarith
        exact chord_pos (by norm_num) hv0 hvb hVpos hg0 hm'
    exact ⟨hpos.le, fun _ => hpos⟩

/-- Removing `ε` for the row `Sp`: if `v - v₀ ≤ 21ε/10`, then `P(u,v) + ε (A + B v) ≥ P(u,v₀) + 9ε/10`. -/
theorem core_Sp {u v v0 e : ℝ} (hu0 : 0 ≤ u) (_hu1 : u ≤ 1 / 16) (hv0 : 0 ≤ v0) (hv : v0 ≤ v)
    (hv1 : v ≤ 1 / 20) (he0 : 0 ≤ e) (hd : v - v0 ≤ 21 / 10 * e) :
    slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u v0 + 9 / 10 * e ≤ slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u v + e * ((147 / 100 : ℝ) + (16 : ℝ) * v) := by
  have hΔ0 : 0 ≤ v - v0 := by linarith
  have key : slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u v = slP (2 / 125 : ℝ) (7 / 500 : ℝ) (-6 : ℝ) (69 / 50 : ℝ) (-(103 / 20) : ℝ) (0 : ℝ) u v0 +
      (v - v0) * ((7 / 500 : ℝ) + (69 / 50 : ℝ) * u + (0 : ℝ) * u ^ 2 + (-(103 / 20) : ℝ) * (v + v0)) := by
    unfold slP; ring
  have hbr : -(0 : ℝ) + 2 * (-(103 / 20) : ℝ) * v ≤ (7 / 500 : ℝ) + (69 / 50 : ℝ) * u + (0 : ℝ) * u ^ 2 + (-(103 / 20) : ℝ) * (v + v0) := by
    nlinarith [mul_nonneg hu0 hu0]
  have hneg : -(0 : ℝ) + 2 * (-(103 / 20) : ℝ) * v ≤ 0 := by nlinarith
  have h1 := mul_le_mul_of_nonneg_left hbr hΔ0
  have h2 := mul_le_mul_of_nonneg_right hd (by linarith : 0 ≤ (0 : ℝ) - 2 * (-(103 / 20) : ℝ) * v)
  have h3 : 0 ≤ e * ((147 / 100 : ℝ) - 21 / 10 * (0 : ℝ) + ((16 : ℝ) + 21 / 5 * (-(103 / 20) : ℝ)) * v - 9 / 10) := by
    apply mul_nonneg he0
    nlinarith
  nlinarith [h1, h2, h3]

/-- Chart `B`, row `Bm`: `P(u,v) + (5/2) y ≥ 0` (strict for `u > 0`) for `0 ≤ v ≤ u²`, `u ≤ 1/30`. -/
theorem coreB_Bm {u v y : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ 1 / 30) (hv0 : 0 ≤ v) (hvu : v ≤ u ^ 2)
    (hy1 : 12 / 5 * u ^ 2 ≤ y) :
    0 ≤ slP (2 / 125 : ℝ) (19 / 100 : ℝ) (-6 : ℝ) (3 : ℝ) (-5 : ℝ) (0 : ℝ) u v + 5 / 2 * y ∧ (0 < u → 0 < slP (2 / 125 : ℝ) (19 / 100 : ℝ) (-6 : ℝ) (3 : ℝ) (-5 : ℝ) (0 : ℝ) u v + 5 / 2 * y) := by
  have hv1 : v ≤ 1 / 900 := by nlinarith
  have hbr : 3 / 40 ≤ (19 / 100 : ℝ) + (3 : ℝ) * u + (-5 : ℝ) * v := by nlinarith
  have h1 : 0 ≤ v * ((19 / 100 : ℝ) + (3 : ℝ) * u + (-5 : ℝ) * v) := mul_nonneg hv0 (by linarith)
  have key : slP (2 / 125 : ℝ) (19 / 100 : ℝ) (-6 : ℝ) (3 : ℝ) (-5 : ℝ) (0 : ℝ) u v = ((2 / 125 : ℝ) * u + (-6 : ℝ) * u ^ 2) + v * ((19 / 100 : ℝ) + (3 : ℝ) * u + (-5 : ℝ) * v) := by
    unfold slP; ring
  have h2 : (2 / 125 : ℝ) * u ≤ ((2 / 125 : ℝ) * u + (-6 : ℝ) * u ^ 2) + 5 / 2 * y := by nlinarith [sq_nonneg u]
  refine ⟨by nlinarith, fun h => ?_⟩
  nlinarith [mul_pos h (by norm_num : (0 : ℝ) < (2 / 125 : ℝ))]

/-- Chart `B`, row `Bp`: `P(u,v) + (5/2) y ≥ 0` (strict for `u > 0`) for `0 ≤ v ≤ u²`, `u ≤ 1/30`. -/
theorem coreB_Bp {u v y : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ 1 / 30) (hv0 : 0 ≤ v) (hvu : v ≤ u ^ 2)
    (hy1 : 12 / 5 * u ^ 2 ≤ y) :
    0 ≤ slP (2 / 125 : ℝ) (19 / 100 : ℝ) (-(571 / 100) : ℝ) (-(3 / 2) : ℝ) (-(5 / 2) : ℝ) (0 : ℝ) u v + 5 / 2 * y ∧ (0 < u → 0 < slP (2 / 125 : ℝ) (19 / 100 : ℝ) (-(571 / 100) : ℝ) (-(3 / 2) : ℝ) (-(5 / 2) : ℝ) (0 : ℝ) u v + 5 / 2 * y) := by
  have hv1 : v ≤ 1 / 900 := by nlinarith
  have hbr : 3 / 40 ≤ (19 / 100 : ℝ) + (-(3 / 2) : ℝ) * u + (-(5 / 2) : ℝ) * v := by nlinarith
  have h1 : 0 ≤ v * ((19 / 100 : ℝ) + (-(3 / 2) : ℝ) * u + (-(5 / 2) : ℝ) * v) := mul_nonneg hv0 (by linarith)
  have key : slP (2 / 125 : ℝ) (19 / 100 : ℝ) (-(571 / 100) : ℝ) (-(3 / 2) : ℝ) (-(5 / 2) : ℝ) (0 : ℝ) u v = ((2 / 125 : ℝ) * u + (-(571 / 100) : ℝ) * u ^ 2) + v * ((19 / 100 : ℝ) + (-(3 / 2) : ℝ) * u + (-(5 / 2) : ℝ) * v) := by
    unfold slP; ring
  have h2 : (2 / 125 : ℝ) * u ≤ ((2 / 125 : ℝ) * u + (-(571 / 100) : ℝ) * u ^ 2) + 5 / 2 * y := by nlinarith [sq_nonneg u]
  refine ⟨by nlinarith, fun h => ?_⟩
  nlinarith [mul_pos h (by norm_num : (0 : ℝ) < (2 / 125 : ℝ))]

