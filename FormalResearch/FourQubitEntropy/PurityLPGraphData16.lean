/-- Neighbourhood bitmasks of `C_17(1,3,4,5)` induced on the vertices `0..15` on 16 vertices. -/
def adj16 : Fin 16 → ℕ := fun i => ([28730, 57461, 49386, 33237, 939, 1879, 3758, 7516, 15032, 30064, 60128, 54720, 43905, 22275, 44551, 23566] : List ℕ).getD i.1 0

theorem adj16_spec : ∀ i j : Fin 16, (adj16 i).testBit j = decide ((i : ℕ) ≠ j ∧ (((j : ℕ) + 17 - i) % 17 ∈ ([1, 3, 4, 5] : List ℕ) ∨ ((i : ℕ) + 17 - j) % 17 ∈ ([1, 3, 4, 5] : List ℕ))) := by
  decide +kernel

theorem adj16_symm : ∀ i j : Fin 16, (adj16 i).testBit j = (adj16 j).testBit i := by
  decide +kernel

theorem adj16_irrefl : ∀ i : Fin 16, (adj16 i).testBit i = false := by
  decide +kernel

