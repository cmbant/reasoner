    have huv : Integrable (fun x => u x * v x) := huv'.const_mul (Complex.I * (q : ℂ))⁻¹ |>.congr (ae_of_all _ fun x => by dsimp [v, v']; ring)
    have hibp := integral_mul_deriv_eq_deriv_mul_of_integrable (fun x _ => ((hu.differentiable (by simp)) x).hasDerivAt) (fun x _ => ((((hasDerivAt_id' x).const_mul q).ofReal_comp.const_mul Complex.I).cexp.const_mul (Complex.I * (q : ℂ))⁻¹).congr_deriv (by dsimp [v']; field_simp [Complex.I_ne_zero, Complex.ofReal_ne_zero.mpr hq])) huv' hu' huv
    have hibp2 : ∫ x : ℝ, u x * Complex.exp (Complex.I * ((q * x : ℝ) : ℂ)) = -(Complex.I * (q : ℂ))⁻¹ * ∫ x : ℝ, _root_.deriv u x * Complex.exp (Complex.I * ((q * x : ℝ) : ℂ)) := by rw [show (fun x : ℝ => u x * Complex.exp (Complex.I * ((q * x : ℝ) : ℂ))) = fun x => u x * v' x from rfl, hibp, show (fun x => _root_.deriv u x * v x) = fun x => (Complex.I * (q : ℂ))⁻¹ * (_root_.deriv u x * Complex.exp (Complex.I * ((q * x : ℝ) : ℂ))) from funext fun x => by dsimp [v]; ring, integral_const_mul]; ring
    have hih := ih (_root_.deriv u) A ((contDiff_succ_iff_deriv.mp (hu.of_le (by norm_cast))).2.2) (fun k hk x => by rw [← iteratedDeriv_succ']; exact hbd (k + 1) (Nat.succ_le_succ hk) x) q hq
    rw [hibp2, norm_mul, norm_neg, norm_inv, norm_mul, Complex.norm_I, one_mul, Complex.norm_real, Real.norm_eq_abs]
    exact (mul_le_mul_of_nonneg_left hih (inv_nonneg.mpr (abs_nonneg _))).trans_eq (by rw [show |q|⁻¹ * (A * π * |q| ^ (-(n : ℝ))) = A * π * (|q| ^ (-1 : ℝ) * |q| ^ (-(n : ℝ))) from (by rw [← Real.rpow_neg_one]; ring), ← Real.rpow_add (abs_pos.mpr hq)]; congr 2; push_cast; ring)

private lemma schwartz_fourier_bounds :
    ∃ C > 0, ∀ {g : ℝ → ℂ} {S : ℝ}, ContDiff ℝ (13 : ℕ) g → (∀ k : ℕ, k ≤ 12 → ∀ u : ℝ, (1 + |u|) ^ 5 * ‖iteratedDeriv k g u‖ ≤ S) →
      ContDiff ℝ (3 : ℕ) (fun q : ℝ => Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ)) * ∫ u : ℝ, g u * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ))) ∧
        ∀ k ≤ 3, ∀ q : ℝ, ‖iteratedDeriv k (fun t : ℝ => Complex.exp (Complex.I * ((t ^ 3 / 12 : ℝ) : ℂ)) * ∫ u : ℝ, g u * Complex.exp (Complex.I * ((t * u : ℝ) : ℂ))) q‖ ≤ C * S * (if 1 ≤ |q| then |q| ^ (-(5 / 2 : ℝ) - (k : ℝ)) else (1 + |q| ^ 2) ^ k) := by
  let K_ibp := (2 : ℝ) ^ 12 * 13 * 6 * π + 1; let C := 8 * (max π K_ibp * 8) + 1; have h1u2 : ∀ u : ℝ, 1 + u ^ 2 ≤ (1 + |u|) ^ 2 := fun u => by nlinarith [sq_abs u, abs_nonneg u]
  have hp_ofReal : ∀ m k (u : ℝ), iteratedDeriv m (fun t : ℝ => (t : ℂ) ^ k) u = (k.descFactorial m : ℂ) * (u : ℂ) ^ (k - m) := fun m => by induction m with | zero => intro k u; simp | succ m ih => intro k u; rw [iteratedDeriv_succ, funext (ih k), ((hasDerivAt_ofReal_pow (k - m) u).const_mul _).deriv]; rcases le_or_gt m k with hmk | hmk; { rw [Nat.descFactorial_succ, Nat.sub_add_eq]; push_cast; ring }; simp [Nat.descFactorial_eq_zero_iff_lt.mpr hmk]
  have hE_cd : ContDiff ℝ (⊤ : ℕ∞) (fun q : ℝ => Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ))) := (Complex.contDiff_exp (𝕜 := ℝ)).comp (contDiff_const.mul (Complex.ofRealCLM.contDiff.comp ((contDiff_id.pow 3).div_const 12)))
  refine ⟨C, by positivity, fun {g S} hg_cd hg_bd => ?_⟩; have hS : 0 ≤ S := (mul_nonneg (by positivity) (norm_nonneg _)).trans (hg_bd 0 (by omega) 0); let I : ℕ → ℝ → ℂ := fun k q => ∫ u : ℝ, ((Complex.I * (u : ℂ)) ^ k * g u) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ))
  have hΦ_ok : ∀ k ≤ 3, Integrable (fun u : ℝ => (Complex.I * (u : ℂ)) ^ k * g u) ∧ ∀ u : ℝ, (1 + u ^ 2) * (1 + |u|) ^ (3 - k) * ‖(Complex.I * (u : ℂ)) ^ k * g u‖ ≤ S := fun k hk => by
    have hpow : ∀ u : ℝ, (1 + u ^ 2) * (1 + |u|) ^ (3 - k) * |u| ^ k ≤ (1 + |u|) ^ 5 := fun u => by
      calc (1 + u ^ 2) * (1 + |u|) ^ (3 - k) * |u| ^ k ≤ (1 + |u|) ^ 2 * (1 + |u|) ^ (3 - k) * (1 + |u|) ^ k := by gcongr; exact h1u2 u; exact le_add_of_nonneg_left zero_le_one
        _ = (1 + |u|) ^ 5 := by rw [← pow_add, ← pow_add, show 2 + (3 - k) + k = 5 by omega]
    have hpt : ∀ u : ℝ, (1 + u ^ 2) * (1 + |u|) ^ (3 - k) * ‖(Complex.I * (u : ℂ)) ^ k * g u‖ ≤ S := fun u => ((mul_le_mul_of_nonneg_right (hpow u) (norm_nonneg _)).trans (hg_bd 0 (by omega) u)).trans_eq' (by rw [iteratedDeriv_zero, norm_mul, norm_pow, norm_mul, Complex.norm_I, one_mul, Complex.norm_real, Real.norm_eq_abs]; ring)
    exact ⟨(integrable_schwartz_mul_poly (((continuous_const.mul Complex.ofRealCLM.continuous).pow k).mul hg_cd.continuous) fun u => (mul_le_mul_of_nonneg_right (le_mul_of_one_le_right (by positivity) (one_le_pow₀ (by linarith [abs_nonneg u]))) (norm_nonneg _)).trans (hpt u)).1, hpt⟩
