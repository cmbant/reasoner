/-- Lemma `GT.1s` (`cegt:GT1s`): scalar Airy symbol transfer on `[1, ∞)` for `σ ∈ {-1, 0, 1}`. -/
theorem gt1s_scalar_airy_symbol_transfer (j : ℕ) {x_min σ : ℝ} (hx_min : 0 < x_min) (hσ : σ ∈ ({-1, 0, 1} : Set ℝ)) :
    ∃ C > 0, ∀ {x₁ M : ℝ} {b : ℝ → ℂ}, x_min ≤ x₁ → 0 ≤ M → (∀ x < x₁, b x = 0) → IsAirySymbolBound (3 * j + 3) b M →
