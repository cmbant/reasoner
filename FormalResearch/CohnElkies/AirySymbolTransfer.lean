  let Fp : ℝ → ℂ := fun u => (seed.F u : ℂ) * (χ.val (u / x₀) : ℂ); let b0 := fun x => seed.b₀ x * ((1 - χ.val (-x / x₀) : ℝ) : ℂ); let b1 := fun x => seed.bPos x * ((1 - χ.val (-x / x₀) : ℝ) : ℂ); let bm1 := fun x => seed.bNeg x * ((1 - χ.val (-x / x₀) : ℝ) : ℂ)
  obtain ⟨hb0_supp, hb0_sym⟩ := htb seed.b₀ seed.sym_cd.1 (fun k hk x hx => (seed.sym_bd k hk x hx).1); obtain ⟨hb1_supp, hb1_sym⟩ := htb seed.bPos seed.sym_cd.2.1 (fun k hk x hx => (seed.sym_bd k hk x hx).2.1); obtain ⟨hbm1_supp, hbm1_sym⟩ := htb seed.bNeg seed.sym_cd.2.2 (fun k hk x hx => (seed.sym_bd k hk x hx).2.2)
  obtain ⟨hF_int, _⟩ := airyFtilde_decomp hx₀ seed hM0
  have h15 : ∀ u : ℝ, 1 + u ^ 2 ≤ (1 + |u|) ^ 5 := fun u => (by nlinarith [sq_abs u, abs_nonneg u] : 1 + u ^ 2 ≤ (1 + |u|) ^ 2).trans (pow_le_pow_right₀ (by linarith [abs_nonneg u]) (by norm_num : 2 ≤ 5))
  have hFp_i := integrable_schwartz_mul_poly seed.schwartz_cd.continuous (fun u => by simpa [iteratedDeriv_zero, Fp] using (mul_le_mul_of_nonneg_right (h15 u) (norm_nonneg _)).trans (seed.schwartz_bd 0 (by omega) u))
  have hI_b : ∀ {b : ℝ → ℂ}, (∀ x < x₀, b x = 0) → IsAirySymbolBound 12 b (K_tail * M) → Integrable (fun u : ℝ => ‖b (-u)‖) ∧ ∫ u : ℝ, ‖b (-u)‖ ≤ 2 * K_tail * M := fun {b} hbz hbs => by
    have hi0 := integrableOn_of_symbolBound (by linarith : 0 < x₀) le_rfl (mul_nonneg hK_tail.le hM0) hbz (isAirySymbolBound_to_core hbs)
    refine ⟨(integrable_indicator_iff measurableSet_Ioi |>.mpr hi0.norm).comp_neg.congr (ae_of_all _ fun u => by dsimp only [Function.comp_apply]; by_cases hu : -u ∈ Ioi (0 : ℝ); { exact Set.indicator_of_mem hu _ }; exact (Set.indicator_of_notMem hu _).trans (by rw [hbz (-u) (by linarith [not_lt.mp hu]), norm_zero])), ?_⟩
    rw [integral_neg_eq_self (fun x => ‖b x‖)]
    have hind_eq : (fun x => ‖b x‖) = (Ioi x₀).indicator (fun x => ‖b x‖) := funext fun x => by
      by_cases hx : x ∈ Ioi x₀; · rw [Set.indicator_of_mem hx]
      rw [Set.indicator_of_notMem hx]; rcases eq_or_lt_of_le (not_lt.mp hx) with heq | h; swap; · rw [hbz x h, norm_zero]
      rw [heq]; have : (𝓝[Iio x₀] x₀).NeBot := nhdsLT_neBot x₀; exact tendsto_nhds_unique (((isAirySymbolBound_to_core hbs).1.continuous.norm.continuousAt (x := x₀)).tendsto.mono_left (nhdsWithin_le_nhds (s := Iio x₀))) (tendsto_const_nhds.congr' (eventually_nhdsWithin_of_forall fun t (ht : t < x₀) => by dsimp only; rw [hbz t ht, norm_zero]))
    rw [hind_eq, integral_indicator measurableSet_Ioi]; have hri : IntegrableOn (fun x : ℝ => (K_tail * M) * x ^ (-(3 / 2 : ℝ))) (Ioi x₀) := (integrableOn_Ioi_rpow_of_lt (by norm_num) (by linarith : 0 < x₀)).const_mul _
    refine (setIntegral_mono_on (hi0.mono_set (Ioi_subset_Ioi (by linarith [hx₀] : (0 : ℝ) ≤ x₀))).norm hri measurableSet_Ioi fun x hx => by simpa using symbolBound_rpow_norm_le (isAirySymbolBound_to_core hbs) (Nat.zero_le _) (by linarith [hx₀, hx.out] : 0 < x)).trans ?_
    rw [integral_const_mul, integral_Ioi_rpow_of_lt (by norm_num) (by linarith : 0 < x₀)]; exact ((by norm_num; ring : (K_tail * M) * (-x₀ ^ (-(3 / 2 : ℝ) + 1) / (-(3 / 2 : ℝ) + 1)) = 2 * K_tail * M * x₀ ^ (-(1 / 2 : ℝ))).le.trans (mul_le_mul_of_nonneg_left (Real.rpow_le_one_of_one_le_of_nonpos hx₀ (by norm_num)) (by positivity) |>.trans_eq (mul_one _)))
  have hb0i := hI_b hb0_supp hb0_sym; have hb1i := hI_b hb1_supp hb1_sym; have hbm1i := hI_b hbm1_supp hbm1_sym
  have hpt_f : ∀ u : ℝ, ‖(seed.F u : ℂ)‖ ≤ ‖Fp u‖ + (‖b0 (-u)‖ + ‖b1 (-u)‖ + ‖bm1 (-u)‖) := fun u => by
    have hsp : (seed.F u : ℂ) = Fp u + (b0 (-u) + b1 (-u) * Complex.exp (Complex.I * ((4 / 3 : ℝ) * (-u) ^ (3 / 2 : ℝ) : ℝ)) + bm1 (-u) * Complex.exp (Complex.I * ((-1 : ℝ) * (4 / 3 : ℝ) * (-u) ^ (3 / 2 : ℝ) : ℝ))) := by
      dsimp [Fp, b0, b1, bm1]; by_cases hu : -u ≥ x₀
      · have htail := seed.tail_eq (-u) hu; rw [neg_neg] at htail; have hfc : seed.b₀ (-u) * ((1 - χ.val (-(-u) / x₀) : ℝ) : ℂ) + seed.bPos (-u) * ((1 - χ.val (-(-u) / x₀) : ℝ) : ℂ) * Complex.exp (Complex.I * ((4 / 3 : ℝ) * (-u) ^ (3 / 2 : ℝ) : ℝ)) + seed.bNeg (-u) * ((1 - χ.val (-(-u) / x₀) : ℝ) : ℂ) * Complex.exp (Complex.I * ((-1 : ℝ) * (4 / 3 : ℝ) * (-u) ^ (3 / 2 : ℝ) : ℝ)) = ((1 - χ.val (u / x₀) : ℝ) : ℂ) * (seed.F u : ℂ) := by rw [neg_neg, htail]; ring
        rw [hfc]; push_cast; ring
      · rw [χ.eq_one (u / x₀) (by rw [ge_iff_le, le_div_iff₀ (by linarith)]; linarith), χ.eq_one (-(-u) / x₀) (by rw [neg_neg, ge_iff_le, le_div_iff₀ (by linarith)]; linarith)]; simp only [sub_self, Complex.ofReal_one, Complex.ofReal_zero, mul_one, mul_zero, zero_mul, add_zero]
    rw [hsp]; refine (norm_add_le _ _).trans (add_le_add le_rfl ((norm_add_le _ _).trans (add_le_add ((norm_add_le _ _).trans (add_le_add le_rfl (by rw [norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, mul_one]))) (by rw [norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, mul_one]))))
  have ha1 := integral_add hFp_i.1.norm ((hb0i.1.add hb1i.1).add hbm1i.1); have ha2 := integral_add (hb0i.1.add hb1i.1) hbm1i.1; have ha3 := integral_add hb0i.1 hb1i.1; simp only [Pi.add_apply] at ha1 ha2 ha3
  have hsum_i : ∫ u : ℝ, ‖Fp u‖ + (‖b0 (-u)‖ + ‖b1 (-u)‖ + ‖bm1 (-u)‖) = (∫ u : ℝ, ‖Fp u‖) + ((∫ u : ℝ, ‖b0 (-u)‖) + (∫ u : ℝ, ‖b1 (-u)‖) + ∫ u : ℝ, ‖bm1 (-u)‖) := by
    dsimp only [Fp, b0, b1, bm1] at *; rw [ha1, ha2, ha3]
  exact ⟨hS0, hM0, hF_int, ((integral_mono hF_int.norm (hFp_i.1.norm.add ((hb0i.1.add hb1i.1).add hbm1i.1)) hpt_f).trans_eq hsum_i).trans ((add_le_add hFp_i.2 (add_le_add (add_le_add hb0i.2 hb1i.2) hbm1i.2)).trans_eq (by ring))⟩

private lemma holder_half_pos {A : ℝ} (hA : 0 ≤ A) {g : ℝ → ℂ} (hg : Continuous g) (hcd : ContDiffOn ℝ 1 g (Ioi 0))
    (hbd : ∀ t ∈ Ioc (0 : ℝ) 1, ‖iteratedDeriv 1 g t‖ ≤ A * t ^ (-(1 / 2 : ℝ))) : ∀ v ∈ Ioc (0 : ℝ) 1, ‖g v - g 0‖ ≤ 2 * A * v ^ (1 / 2 : ℝ) := fun v hv => by
  refine le_of_tendsto ((continuous_const.sub hg).norm.continuousAt.tendsto.mono_left nhdsWithin_le_nhds) (Filter.eventually_of_mem (Ioo_mem_nhdsGT hv.1) fun ε hε => ?_)
  have hdrv : ∀ t ∈ uIcc ε v, HasDerivAt g (iteratedDeriv 1 g t) t := fun t ht => by rw [uIcc_of_le hε.2.le] at ht; exact ((hcd.differentiableOn (by simp) t (by linarith [ht.1, hε.1] : 0 < t)).differentiableAt (isOpen_Ioi.mem_nhds (by linarith [ht.1, hε.1] : (0 : ℝ) < t))).hasDerivAt.congr_deriv (by rw [← iteratedDeriv_one])
  have hcont_d : ContinuousOn (iteratedDeriv 1 g) (Icc ε v) := by rw [iteratedDeriv_one]; exact (hcd.continuousOn_deriv_of_isOpen isOpen_Ioi le_rfl).mono fun _ ht => lt_of_lt_of_le hε.1 ht.1
  have hint : ∫ t in ε..v, ‖iteratedDeriv 1 g t‖ ≤ 2 * A * v ^ (1 / 2 : ℝ) := by
    have hp : IntervalIntegrable (fun t : ℝ => A * t ^ (-(1 / 2 : ℝ))) volume ε v := (continuousOn_const.mul (continuousOn_id.rpow_const fun t ht => Or.inl (by linarith [ht.1, hε.1] : (0 : ℝ) < t).ne')).intervalIntegrable_of_Icc hε.2.le
    refine (intervalIntegral.integral_mono_on hε.2.le (hcont_d.norm.intervalIntegrable_of_Icc hε.2.le) hp fun t ht => hbd t ⟨by linarith [ht.1, hε.1], ht.2.trans hv.2⟩).trans ?_
    rw [intervalIntegral.integral_const_mul, integral_rpow (Or.inr ⟨by norm_num, notMem_uIcc_of_lt hε.1 (hε.1.trans hε.2)⟩), show -(1 / 2 : ℝ) + 1 = 1 / 2 from by norm_num]
    exact (mul_le_mul_of_nonneg_left (by linarith [Real.rpow_nonneg hε.1.le (1 / 2 : ℝ)] : (v ^ (1 / 2 : ℝ) - ε ^ (1 / 2 : ℝ)) / (1 / 2 : ℝ) ≤ 2 * v ^ (1 / 2 : ℝ)) hA).trans_eq (by ring)
  change ‖g v - g ε‖ ≤ 2 * A * v ^ (1 / 2 : ℝ)
  rw [← intervalIntegral.integral_eq_sub_of_hasDerivAt hdrv (hcont_d.intervalIntegrable_of_Icc hε.2.le)]
  exact (intervalIntegral.norm_integral_le_integral_norm hε.2.le).trans hint

private lemma holder_half_of_deriv_bound {A : ℝ} (hA : 0 ≤ A) {W : ℝ → ℂ} (hW : Continuous W) (hcd_p : ContDiffOn ℝ 1 W (Ioi 0))
    (hcd_n : ContDiffOn ℝ 1 W (Iio 0)) (hbd : ∀ t : ℝ, t ≠ 0 → |t| ≤ 1 → ‖iteratedDeriv 1 W t‖ ≤ A * |t| ^ (-(1 / 2 : ℝ))) : ∀ v : ℝ, |v| ≤ 1 → ‖W v - W 0‖ ≤ 2 * A * |v| ^ (1 / 2 : ℝ) := fun v hv => by
  rcases lt_trichotomy v 0 with hv_neg | rfl | hv_pos
  · have hbd_n : ∀ t ∈ Ioc (0 : ℝ) 1, ‖iteratedDeriv 1 (fun s => W (-s)) t‖ ≤ A * t ^ (-(1 / 2 : ℝ)) := fun t ht => by rw [iteratedDeriv_one, show (fun s => W (-s)) = W ∘ Neg.neg from rfl, (((hcd_n.differentiableOn (by simp) (-t) (neg_lt_zero.mpr ht.1)).differentiableAt (isOpen_Iio.mem_nhds (neg_lt_zero.mpr ht.1))).hasDerivAt.scomp t (hasDerivAt_neg t)).deriv, norm_smul, Real.norm_eq_abs, abs_neg, abs_one, one_mul, ← iteratedDeriv_one]; simpa [abs_of_neg (neg_lt_zero.mpr ht.1 : -t < 0)] using hbd (-t) (neg_ne_zero.mpr ht.1.ne') (abs_le.mpr ⟨by linarith [ht.2], by linarith [ht.1]⟩)
    simpa only [Function.comp_apply, neg_neg, neg_zero, abs_of_neg hv_neg] using holder_half_pos hA (hW.comp continuous_neg) (hcd_n.comp contDiff_neg.contDiffOn fun _ h => neg_lt_zero.mpr h) hbd_n (-v) ⟨neg_pos.mpr hv_neg, by linarith [neg_le_abs v]⟩
  · simp
  · rw [abs_of_pos hv_pos]; exact holder_half_pos hA hW hcd_p (fun t ht => by simpa [abs_of_pos ht.1] using hbd t ht.1.ne' (abs_le.mpr ⟨by linarith [ht.1], ht.2⟩)) v ⟨hv_pos, by linarith [le_abs_self v]⟩

/-- Low-frequency real-axis Airy symbol transfer (`|v| ≤ 1`, uniform in `δ₀ ∈ [0, 2]`). -/
theorem gt1_low_freq (m : ℕ) (hm : 3 ≤ m) {x₀ : ℝ} (hx₀ : 1 ≤ x₀) (χ : AiryCutoff) :
    ∃ C > 0, ∀ {S M δ₀ : ℝ} (seed : AiryTailSymbolSeed x₀ χ S M), δ₀ ∈ Icc 0 2 →
      let W := airyWeightedSymbol δ₀ m seed.F
      Continuous W ∧ ‖W 0‖ ≤ C * (S + M) ∧ (∀ v : ℝ, |v| ≤ 1 → ‖W v - W 0‖ ≤ C * (S + M) * |v| ^ (1 / 2 : ℝ)) ∧
        ∀ j : ℕ, 1 ≤ j → j ≤ 3 → ContDiffOn ℝ (j : ℕ) W (Ioi 0) ∧ ContDiffOn ℝ (j : ℕ) W (Iio 0) ∧ ∀ v : ℝ, v ≠ 0 → |v| ≤ 1 → ‖iteratedDeriv j W v‖ ≤ C * (S + M) * |v| ^ ((1 / 2 : ℝ) - (j : ℝ)) := by
  obtain ⟨C_spl, hC_spl, hspl⟩ := bsplineImag_uniform_bounds m hm; obtain ⟨K_tail, hK_tail, htail_bd⟩ := seed_bTilde_symbolBound hx₀ χ; obtain ⟨K_l1, hK_l1, hL1⟩ := seed_L1_bound hx₀ χ; obtain ⟨C_schw, hC_schw, hschw⟩ := schwartz_fourier_bounds; obtain ⟨C_tr, hC_tr, htr⟩ := gt1s_three_sum (by linarith : 0 < x₀); obtain ⟨C_p1, hC_p1, hp1⟩ := airyPhaseInt_pm_low 1 (Or.inl rfl); obtain ⟨C_pm1, hC_pm1, hpm1⟩ := airyPhaseInt_pm_low (-1) (Or.inr rfl); obtain ⟨C_z0, hC_z0, hz0⟩ := airyPhaseInt_zero_low hx₀
  let Qm := ceCs + 1; have hQm1 : 1 ≤ Qm := (by linarith [ceCs_pos]); let C_G : ℝ := ceK * max (8 * C_schw) ((C_p1 + C_pm1 + C_z0) * K_tail) + 1; have hC_G : 0 < C_G := add_pos_of_nonneg_of_pos (mul_nonneg ceK_pos.le (le_max_of_le_left (mul_nonneg (by norm_num) hC_schw.le))) one_pos; let C_W1 : ℝ := 8 * C_spl * ceK * max π (6 * K_l1) + 8 * C_spl * ceCs ^ 3 * C_G
  have hC_W1_nn : 0 ≤ C_W1 := add_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hC_spl.le) ceK_pos.le) (le_max_of_le_left Real.pi_pos.le)) (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hC_spl.le) (pow_nonneg ceCs_pos.le 3)) hC_G.le); let C : ℝ := 2 * C_W1 + 1
  refine ⟨C, by positivity, fun {S M δ₀} seed hδ => ?_⟩; obtain ⟨hS0, hM0, htb⟩ := htail_bd seed; obtain ⟨_, _, hF_int, hF_bd_univ⟩ := hL1 seed
  let Fp : ℝ → ℂ := fun u => (seed.F u : ℂ) * (χ.val (u / x₀) : ℂ); let b0 := fun x => seed.b₀ x * ((1 - χ.val (-x / x₀) : ℝ) : ℂ); let b1 := fun x => seed.bPos x * ((1 - χ.val (-x / x₀) : ℝ) : ℂ); let bm1 := fun x => seed.bNeg x * ((1 - χ.val (-x / x₀) : ℝ) : ℂ)
  obtain ⟨hb0_supp, hb0_sym⟩ := htb seed.b₀ seed.sym_cd.1 (fun k hk x hx => (seed.sym_bd k hk x hx).1); obtain ⟨hb1_supp, hb1_sym⟩ := htb seed.bPos seed.sym_cd.2.1 (fun k hk x hx => (seed.sym_bd k hk x hx).2.1); obtain ⟨hbm1_supp, hbm1_sym⟩ := htb seed.bNeg seed.sym_cd.2.2 (fun k hk x hx => (seed.sym_bd k hk x hx).2.2); obtain ⟨hschw_cd, hschw_bd⟩ := hschw seed.schwartz_cd seed.schwartz_bd; obtain ⟨_, hF_eq⟩ := airyFtilde_decomp hx₀ seed hM0
  let G : ℝ → ℂ := fun v => airyFtilde (fun z : ℂ => (seed.F z.re : ℂ)) (-(ceCs * v : ℂ))
  have hG_int_eq : ∀ v : ℝ, G v = (ceK : ℂ) * Complex.exp (Complex.I * (((ceCs * v) ^ 3 / 12 : ℝ) : ℂ)) * ∫ u : ℝ, (seed.F u : ℂ) * Complex.exp (Complex.I * ((ceCs * v * u : ℝ) : ℂ)) := fun v => by dsimp [G]; unfold airyFtilde airyFhat airyPhiK ceK; congr 1; { congr 2; push_cast; ring_nf }; congr 1; funext u; simp only [Complex.ofReal_re]; congr 2; push_cast; ring
  have hG_cont : Continuous G := by rw [funext hG_int_eq]; exact (continuous_const.mul (Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp (((continuous_const.mul continuous_id).pow 3).div_const 12))))).mul (continuous_of_dominated (F := fun (v u : ℝ) => (seed.F u : ℂ) * Complex.exp (Complex.I * ((ceCs * v * u : ℝ) : ℂ))) (fun v => int_cexp_mul (ceCs * v) hF_int |>.aestronglyMeasurable) (fun v => ae_of_all _ fun u => le_of_eq (by rw [norm_mul, show Complex.I * ((ceCs * v * u : ℝ) : ℂ) = ((ceCs * v * u : ℝ) : ℂ) * Complex.I by ring, Complex.norm_exp_ofReal_mul_I, mul_one])) hF_int.norm (ae_of_all _ fun u => by fun_prop))
  have hW_cont : Continuous (airyWeightedSymbol δ₀ m seed.F) := (bsplineImag_contDiff (ceCs * δ₀ / m) m).continuous.mul hG_cont
  have hG_unif0 : ∀ v : ℝ, ‖G v‖ ≤ ceK * max π (6 * K_l1) * (S + M) := fun v => by rw [hG_int_eq v, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ceK_pos, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, mul_one]; exact (mul_le_mul_of_nonneg_left ((norm_integral_le_integral_norm _).trans ((integral_mono (int_cexp_mul (ceCs * v) hF_int).norm hF_int.norm fun u => le_of_eq (by rw [norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, mul_one])).trans hF_bd_univ)) ceK_pos.le).trans (by rw [mul_assoc ceK]; exact mul_le_mul_of_nonneg_left (by nlinarith [le_max_left π (6 * K_l1), le_max_right π (6 * K_l1), hS0, hM0]) ceK_pos.le)
  have hW0 : ‖airyWeightedSymbol δ₀ m seed.F 0‖ ≤ C * (S + M) := by change ‖bsplineImag (ceCs * δ₀ / m) m 0 * G 0‖ ≤ _; rw [norm_mul]; have hsp0 := (hspl hδ 0 (by omega) 0).1; rw [iteratedDeriv_zero] at hsp0; exact (mul_le_mul hsp0 (hG_unif0 0) (norm_nonneg _) hC_spl.le).trans ((by ring : C_spl * (ceK * max π (6 * K_l1) * (S + M)) = C_spl * ceK * max π (6 * K_l1) * (S + M)).le.trans (mul_le_mul_of_nonneg_right (by dsimp [C, C_W1]; have h1 : 0 ≤ C_spl * ceK * max π (6 * K_l1) := mul_nonneg (mul_nonneg hC_spl.le ceK_pos.le) (le_max_of_le_left Real.pi_pos.le); have h2 : 0 ≤ C_spl * ceCs ^ 3 * C_G := mul_nonneg (mul_nonneg hC_spl.le (pow_nonneg ceCs_pos.le 3)) hC_G.le; linarith) (add_nonneg hS0 hM0)))
  let I_Fp : ℝ → ℂ := fun q => Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ)) * ∫ u : ℝ, Fp u * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ))
  have hFp_bd : ∀ k ≤ 3, ∀ q : ℝ, ‖iteratedDeriv k I_Fp q‖ ≤ 8 * C_schw * S := fun k hk q => by have hq := hschw_bd k hk q; split_ifs at hq with hq1; { exact hq.trans (mul_le_mul_of_nonneg_left ((Real.rpow_le_one_of_one_le_of_nonpos hq1 (by linarith [show (0 : ℝ) ≤ k from Nat.cast_nonneg k])).trans (by norm_num : (1 : ℝ) ≤ 8)) (mul_nonneg hC_schw.le hS0) |>.trans_eq (by ring)) }; exact hq.trans (mul_le_mul_of_nonneg_left ((pow_le_pow_left₀ (by positivity) (by nlinarith [sq_abs q, abs_nonneg q, not_le.mp hq1]) k).trans ((pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hk).trans_eq (by norm_num : (2 : ℝ) ^ 3 = 8))) (mul_nonneg hC_schw.le hS0) |>.trans_eq (by ring))
