private lemma airyPhaseInt_compact_unif (σ : ℝ) :
    ∃ C > 0, ∀ {R M_a Q_max q : ℝ} {a : ℝ → ℂ}, 1 ≤ R → 0 ≤ M_a → 0 ≤ Q_max → |q| ≤ Q_max → (∀ x ≤ 1, a x = 0) → (∀ x ≥ R, a x = 0) → IsAirySymbolBoundCore 3 a M_a → ∀ k ≤ 3,
      ‖iteratedDeriv k (fun s => airyPhaseInt σ s a) q‖ ≤ C * (1 + Q_max ^ 2) ^ 3 * M_a * (if k = 0 then 1 else R ^ ((k : ℝ) - 1 / 2)) := by
  obtain ⟨C0, hC0, hp0⟩ := phasePoly_deriv_bound_univ 0 0; obtain ⟨C1, hC1, hp1⟩ := phasePoly_deriv_bound_univ 0 1; obtain ⟨C2, hC2, hp2⟩ := phasePoly_deriv_bound_univ 0 2; obtain ⟨C3, hC3, hp3⟩ := phasePoly_deriv_bound_univ 0 3
  let C := 2 * (C0 + C1 + C2 + C3) + 1; refine ⟨C, by positivity, fun {R M_a Q_max q} {a} hR1 hMa hQm hq ha_lo ha_hi ha_sym k hk => ?_⟩
  have hp_k : ∃ Ck > 0, Ck ≤ C / 2 ∧ ∀ {q x : ℝ}, 1 / 2 ≤ x → ‖phasePoly k q x‖ ≤ Ck * (1 + q ^ 2) ^ k * x ^ k := by
    rcases (by omega : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3) with rfl | rfl | rfl | rfl
    · { exact ⟨C0, hC0, by dsimp [C]; linarith, fun hx => by simpa using hp0 hx⟩ }; { exact ⟨C1, hC1, by dsimp [C]; linarith, fun hx => by simpa using hp1 hx⟩ }; { exact ⟨C2, hC2, by dsimp [C]; linarith, fun hx => by simpa using hp2 hx⟩ }; exact ⟨C3, hC3, by dsimp [C]; linarith, fun hx => by simpa using hp3 hx⟩
  obtain ⟨Ck, hCk, hCk_le, hpk⟩ := hp_k
  rw [(airyPhaseInt_compact_iteratedDeriv σ hR1 ha_sym.1.continuous (fun x hx => by rcases not_mem_Icc_iff hx with h | h; { exact ha_lo x h.le }; exact ha_hi x h.le) k).2 q]
  have heq : ∫ x in Ioi (0 : ℝ), a x * phasePoly k q x * Complex.exp (Complex.I * (airyPhase σ q x : ℝ)) = ∫ x in (1 : ℝ)..R, a x * phasePoly k q x * Complex.exp (Complex.I * (airyPhase σ q x : ℝ)) := by
    rw [intervalIntegral.integral_of_le hR1]; symm; rw [← inter_eq_right.mpr (show Ioc 1 R ⊆ Ioi 0 from fun _ hx => lt_trans zero_lt_one hx.1), ← setIntegral_indicator measurableSet_Ioc]
    refine setIntegral_congr_fun measurableSet_Ioi fun x _ => ?_; by_cases hx : x ∈ Ioc 1 R; { exact Set.indicator_of_mem hx _ }; rw [Set.indicator_of_notMem hx]; simp only [mem_Ioc, not_and_or, not_lt, not_le] at hx; rcases hx with h1 | hR; { rw [ha_lo x h1, zero_mul, zero_mul] }; rw [ha_hi x hR.le, zero_mul, zero_mul]
  have hcont : ContinuousOn (fun x => a x * phasePoly k q x * Complex.exp (Complex.I * (airyPhase σ q x : ℝ))) (Icc 1 R) := ((ha_sym.1.continuous.mul (contDiff_evalMonomList _ q).continuous).mul (airyPhase_cexp_cont σ q)).continuousOn
  have hr_cont : ContinuousOn (fun x : ℝ => Ck * (1 + Q_max ^ 2) ^ 3 * M_a * x ^ ((k : ℝ) - 3 / 2)) (Icc 1 R) := continuousOn_const.mul (continuousOn_id.rpow_const fun x hx => Or.inl (by linarith [hx.1] : (0 : ℝ) < x).ne')
  have hpt : ∀ x ∈ Icc (1 : ℝ) R, ‖a x * phasePoly k q x * Complex.exp (Complex.I * (airyPhase σ q x : ℝ))‖ ≤ Ck * (1 + Q_max ^ 2) ^ 3 * M_a * x ^ ((k : ℝ) - 3 / 2) := fun x hx => by
    have hx0 : 0 < x := (by linarith [hx.1]); have hp := hpk (q := q) (by linarith [hx.1] : 1 / 2 ≤ x)
    have hq2 : (1 + q ^ 2) ^ k ≤ (1 + Q_max ^ 2) ^ 3 := (pow_le_pow_left₀ (by positivity) (by nlinarith [sq_abs q, abs_nonneg q, hq, hQm]) k).trans (pow_le_pow_right₀ (by linarith [sq_nonneg Q_max]) hk)
    rw [norm_mul, norm_mul, mul_comm Complex.I, Complex.norm_exp_ofReal_mul_I, mul_one, show x ^ ((k : ℝ) - 3 / 2) = x ^ (-(3 / 2 : ℝ)) * x ^ k from (by rw [← Real.rpow_natCast x k, ← Real.rpow_add hx0]; congr 1; ring)]
    exact (mul_le_mul (by simpa using symbolBound_rpow_norm_le ha_sym (Nat.zero_le _) hx0) (hp.trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hq2 hCk.le) (pow_nonneg hx0.le k))) (norm_nonneg _) (by positivity)).trans_eq (by ring)
  have hk_ne : (k : ℝ) - 3 / 2 ≠ -1 := fun h => by have h2 : (2 * k : ℝ) = 1 := (by linarith); exact absurd (by exact_mod_cast h2 : 2 * k = 1) (by omega)
  have hint_le : (R ^ ((k : ℝ) - 3 / 2 + 1) - (1 : ℝ) ^ ((k : ℝ) - 3 / 2 + 1)) / ((k : ℝ) - 3 / 2 + 1) ≤ 2 * (if k = 0 then 1 else R ^ ((k : ℝ) - 1 / 2)) := by
    rcases eq_or_ne k 0 with rfl | hk0; { simp only [Nat.cast_zero, zero_sub, ↓reduceIte]; norm_num; linarith [Real.rpow_nonneg (by linarith : 0 ≤ R) (-(1 / 2 : ℝ))] }
    rw [ite_eq_right hk0, show (k : ℝ) - 3 / 2 + 1 = (k : ℝ) - 1 / 2 from (by ring), Real.one_rpow]; have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hk0
    exact (div_le_div_of_nonneg_right (by linarith : R ^ ((k : ℝ) - 1 / 2) - 1 ≤ R ^ ((k : ℝ) - 1 / 2)) (by linarith)).trans ((div_le_iff₀ (by linarith)).mpr (by nlinarith [Real.rpow_nonneg (by linarith : 0 ≤ R) ((k : ℝ) - 1 / 2)]))
  rw [heq]; refine ((intervalIntegral.norm_integral_le_integral_norm hR1).trans ((intervalIntegral.integral_mono_on hR1 (hcont.norm.intervalIntegrable_of_Icc hR1) (hr_cont.intervalIntegrable_of_Icc hR1) hpt).trans ?_))
  rw [intervalIntegral.integral_const_mul, integral_rpow (Or.inr ⟨hk_ne, notMem_uIcc_of_lt zero_lt_one (by linarith)⟩)]
  exact (mul_le_mul_of_nonneg_left hint_le (mul_nonneg (mul_nonneg hCk.le (pow_nonneg (by positivity) 3)) hMa)).trans ((by ring : Ck * (1 + Q_max ^ 2) ^ 3 * M_a * (2 * (if k = 0 then 1 else R ^ ((k : ℝ) - 1 / 2))) = (Ck * 2) * (1 + Q_max ^ 2) ^ 3 * M_a * (if k = 0 then 1 else R ^ ((k : ℝ) - 1 / 2))).le.trans (by gcongr; linarith))

private lemma airyPhaseInt_ibp_tail (j : ℕ) (hj : j ≤ 3) {σ Q_max C_θ : ℝ} (_hσ : σ ∈ ({-1, 0, 1} : Set ℝ)) (hQ : 1 ≤ Q_max) (hCθ : 0 ≤ C_θ) :
