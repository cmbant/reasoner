      have hx_inf : c_inf < x := hulo.trans_lt hx.1; have hx0 : 0 < x := by linarith [hc_inf, hx_inf]
      have hmul := xpow_iteratedDeriv_mul_bound isOpen_Ioo (he_sym.1.contDiffOn.of_le (by exact_mod_cast hm)) ((contDiff_evalMonomList (phasePolyList k) q).contDiffOn.of_le (coe_nat_le_infty m)) (M_e * x ^ (-(3 / 2 : ℝ))) (KP_all * (1 + Q_max ^ 2) ^ 3 * x ^ k) (mul_nonneg hMe (Real.rpow_nonneg hx0.le _)) hx (fun r hr => symbolBound_rpow_norm_le he_sym (hr.trans hm) hx0) fun r hr => ((Classical.choose_spec (hp r k)).2 (hc_inf.trans hx_inf.le)).trans (mul_le_mul_of_nonneg_right (mul_le_mul (by have h1 := Finset.single_le_sum (f := fun i => Classical.choose (hp i k)) (fun i _ => (Classical.choose_spec (hp i k)).1.le) (Finset.mem_range.mpr (by omega : r < 5)); have h2 := Finset.single_le_sum (f := fun l => ∑ i ∈ Finset.range 5, Classical.choose (hp i l)) (fun l _ => Finset.sum_nonneg fun i _ => (Classical.choose_spec (hp i l)).1.le) (Finset.mem_range.mpr (by omega : k < 4)); dsimp [KP_all]; linarith) ((pow_le_pow_left₀ (by positivity) (by nlinarith [sq_abs q, abs_nonneg q, hq_bd q hq, hQ]) k).trans (pow_le_pow_right₀ (by linarith [sq_nonneg Q_max]) hk)) (by positivity) (by positivity)) (pow_nonneg hx0.le k))
      exact hmul.trans ((mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num) hm : (2 : ℝ) ^ m ≤ 2 ^ 4) (mul_nonneg hMe (Real.rpow_nonneg hx0.le _))) (by positivity)).trans_eq (by rw [show (2 : ℝ) ^ 4 * (M_e * x ^ (-(3 / 2 : ℝ))) * (KP_all * (1 + Q_max ^ 2) ^ 3 * x ^ k) = K_mul * ((1 + Q_max ^ 2) ^ 3 * (M_e * (x ^ (-(3 / 2 : ℝ)) * x ^ k))) from by dsimp [K_mul]; ring, (by rw [← Real.rpow_natCast x k, ← Real.rpow_add hx0]; congr 1; ring : x ^ (-(3 / 2 : ℝ)) * x ^ k = x ^ ((k : ℝ) - 3 / 2))]))
    have hibp_res := hibp (by linarith [hc_inf, hulo]) hlc hcd (lt_add_one d') (fun x hx => (hθ q hq x (hulo.trans_lt hx.1)).1) hθ_pos (fun x hx => (hθ q hq x (hulo.trans_lt hx.1)).2) (he_sym.1.contDiffOn.mul ((contDiff_evalMonomList (phasePolyList k) q).contDiffOn.of_le (coe_nat_le_infty 4))) (fun x hx => by simp [he_supp x hx]) hap_bd (continuousOn_const.mul hAc)
    rw [(airyPhaseInt_compact_iteratedDeriv σ hcd.le he_sym.1.continuous (fun x hx => he_supp x (by rcases not_mem_Icc_iff hx with h | h; { exact Or.inl h.le }; exact Or.inr h.le)) k).2 q, (by symm; rw [← inter_eq_right.mpr (Ioo_subset_Ioi_self.trans (Ioi_subset_Ioi (by linarith [hc_inf, hulo, hlc]) : Ioi c' ⊆ Ioi 0)), ← setIntegral_indicator measurableSet_Ioo]; refine setIntegral_congr_fun measurableSet_Ioi fun x _ => ?_; by_cases hx : x ∈ Ioo c' d'; { simp [hx] }; simp only [indicator_of_notMem hx]; rw [he_supp x (not_and_or.mp hx |> fun h => h.elim (fun h1 => Or.inl (le_of_not_gt h1)) (fun h2 => Or.inr (le_of_not_gt h2))), zero_mul, zero_mul] : ∫ x in Ioi (0 : ℝ), (e x * phasePoly k q x) * Complex.exp (Complex.I * (airyPhase σ q x : ℝ)) = ∫ x in Ioo c' d', (e x * phasePoly k q x) * Complex.exp (Complex.I * (airyPhase σ q x : ℝ)))]
    exact hibp_res.trans_eq (by simp only [A, Nat.cast_ofNat, show (fun x => K_mul * ((1 + Q_max ^ 2) ^ 3 * (M_e * x ^ ((k : ℝ) - 3 / 2))) * (x * |2 * σ * Real.sqrt x - q|) ^ (-(4 : ℝ))) = fun x => (K_mul * (1 + Q_max ^ 2) ^ 3 * M_e) * (x ^ ((k : ℝ) - 3 / 2) * (x * |2 * σ * Real.sqrt x - q|) ^ (-(4 : ℝ))) from funext fun _ => by ring, integral_const_mul]; dsimp [K_mul]; ring)
  have hucauchy : ∀ k ≤ j, ∀ q' q'', q_lo < q' → q' ≤ q'' → q'' < q_hi → UniformCauchySeqOn (fun n => iteratedDeriv k (F_n n)) atTop (Icc q' q'') := fun k hk q' q'' hqq1 hqq hqq2 => by
    rw [Metric.uniformCauchySeqOn_iff]; intro ε hε; let K_u := C_ibp * K_mul * (1 + Q_max ^ 2) ^ 3 * (2 * K_b * M) * θ_min ^ (-(4 : ℝ)) * (2 / 3 : ℝ) + 1; have hK_u : 0 < K_u := by positivity
