/-! ## Section 4: Lemma `GT.1` (`cegt:GT1`, Real-Axis Airy Symbol Transfer) -/

/-- Fixed smooth right-tail cutoff `χ_+ : ℝ → ℝ` (`= 1` on `[-1, ∞)`, `= 0` on `(-∞, -2]`). -/
structure AiryCutoff where
  val : ℝ → ℝ
  contDiff : ContDiff ℝ (⊤ : ℕ∞) val
  nonneg : ∀ u, 0 ≤ val u
  le_one : ∀ u, val u ≤ 1
  eq_one : ∀ u ≥ (-1 : ℝ), val u = 1
  eq_zero : ∀ u ≤ (-2 : ℝ), val u = 0

/-- Canonical smooth cutoff built from `Real.smoothTransition`. -/
noncomputable def AiryCutoff.standard : AiryCutoff where
  val u := Real.smoothTransition (u + 2)
  contDiff := Real.smoothTransition.contDiff.comp (contDiff_id.add contDiff_const)
  nonneg u := Real.smoothTransition.nonneg _
  le_one u := Real.smoothTransition.le_one _
  eq_one _ hu := Real.smoothTransition.one_of_one_le (by linarith)
  eq_zero _ hu := Real.smoothTransition.zero_of_nonpos (by linarith)

/-- Real-axis symbol seed for Lemma `GT.1` (`cegt:GT1`), with Schwartz right/cutoff seminorms `≤ S` and negative-tail symbol bounds `≤ M` through order `12 = 3·3 + 3`. -/
structure AiryTailSymbolSeed (x₀ : ℝ) (χ : AiryCutoff) (S M : ℝ) where
  F : ℝ → ℝ
  continuous : Continuous F
  schwartz_cd : ContDiff ℝ (13 : ℕ) (fun u => (F u : ℂ) * (χ.val (u / x₀) : ℂ))
  schwartz_bd : ∀ k : ℕ, k ≤ 12 → ∀ u : ℝ, (1 + |u|) ^ 5 * ‖iteratedDeriv k (fun t => (F t : ℂ) * (χ.val (t / x₀) : ℂ)) u‖ ≤ S
  b₀ : ℝ → ℂ
  bPos : ℝ → ℂ
  bNeg : ℝ → ℂ
  sym_cd : ContDiffOn ℝ (13 : ℕ) b₀ (Ici x₀) ∧ ContDiffOn ℝ (13 : ℕ) bPos (Ici x₀) ∧ ContDiffOn ℝ (13 : ℕ) bNeg (Ici x₀)
  sym_bd : ∀ k : ℕ, k ≤ 12 → ∀ x > x₀, x ^ ((3 / 2 : ℝ) + k) * ‖iteratedDeriv k b₀ x‖ ≤ M ∧ x ^ ((3 / 2 : ℝ) + k) * ‖iteratedDeriv k bPos x‖ ≤ M ∧ x ^ ((3 / 2 : ℝ) + k) * ‖iteratedDeriv k bNeg x‖ ≤ M
  tail_eq : ∀ x ≥ x₀, (F (-x) : ℂ) = b₀ x + bPos x * Complex.exp (Complex.I * ((4 / 3 : ℝ) * x ^ (3 / 2 : ℝ) : ℝ)) + bNeg x * Complex.exp (Complex.I * ((-1 : ℝ) * (4 / 3 : ℝ) * x ^ (3 / 2 : ℝ) : ℝ))

/-- Non-vacuity witness for `AiryTailSymbolSeed` (`F = 0`, `S = M = 0`). -/
theorem airyTailSymbolSeed_nonvacuous : Nonempty (AiryTailSymbolSeed 1 AiryCutoff.standard 0 0) :=
  ⟨⟨fun _ => 0, continuous_const, by simp [contDiff_const], fun _ _ _ => by simp, fun _ => 0, fun _ => 0, fun _ => 0,
    ⟨contDiffOn_const, contDiffOn_const, contDiffOn_const⟩, fun _ _ _ _ => by simp, fun _ _ => by simp⟩⟩

/-- Weighted Airy multiplier-symbol `W_F(i v) = M_ψ(i v) F̃(-c_s v)`. -/
noncomputable def airyWeightedSymbol (δ₀ : ℝ) (m : ℕ) (F : ℝ → ℝ) (v : ℝ) : ℂ :=
  bsplineImag (ceCs * δ₀ / m) m v * airyFtilde (fun z : ℂ => (F z.re : ℂ)) (-(ceCs * v : ℂ))

