private lemma coe_nat_le_infty (k : ℕ) : ((k : ℕ) : ℕ∞ω) ≤ (⊤ : ℕ∞) := by exact_mod_cast (le_top : (k : ℕ∞) ≤ ⊤)
private lemma not_mem_Icc_iff {x a b : ℝ} (hx : x ∉ Icc a b) : x < a ∨ b < x := (lt_or_ge x a).elim Or.inl fun h => Or.inr (lt_of_not_ge fun h' => hx ⟨h, h'⟩)
private lemma sum_range_shift_mul (a b : ℕ → ℂ) (k : ℕ) : ∑ m ∈ Finset.range (k + 1), a m * b (m + 1) = ∑ m ∈ Finset.range (k + 2), (if 1 ≤ m then a (m - 1) else 0) * b m := by
  symm; rw [Finset.sum_range_succ' _ (k + 1)]; simp
private lemma sum_range_le_extend (g : ℕ → ℂ) (k : ℕ) : ∑ m ∈ Finset.range (k + 1), g m = ∑ m ∈ Finset.range (k + 2), if m ≤ k then g m else 0 := by
  symm; rw [Finset.sum_range_succ]; simp only [Nat.not_succ_le_self, ↓reduceIte, add_zero]
  exact Finset.sum_congr rfl fun m hm => by simp [Nat.lt_succ_iff.mp (Finset.mem_range.mp hm)]
private lemma deriv_eq_zero_of_const_Iic {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {f : ℝ → E} {a x : ℝ} (hd : DifferentiableAt ℝ f x) (hf : ∀ y ≤ a, f y = f a) (hx : x ≤ a) : _root_.deriv f x = 0 :=
  ((uniqueDiffWithinAt_Iic x).eq_deriv (Iic x) ((hasDerivWithinAt_const x (Iic x) (f x)).congr (fun y hy => (hf y (hy.trans hx)).trans (hf x hx).symm) rfl) hd.hasDerivAt.hasDerivWithinAt).symm
private lemma deriv_eq_zero_of_const_Ici {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {f : ℝ → E} {b x : ℝ} (hd : DifferentiableAt ℝ f x) (hf : ∀ y ≥ b, f y = f b) (hx : b ≤ x) : _root_.deriv f x = 0 :=
  ((uniqueDiffWithinAt_Ici x).eq_deriv (Ici x) ((hasDerivWithinAt_const x (Ici x) (f x)).congr (fun y hy => (hf y (hx.trans hy)).trans (hf x hx).symm) rfl) hd.hasDerivAt.hasDerivWithinAt).symm
private lemma diffAt_of_contDiffOn {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {f : ℝ → E} {U : Set ℝ} (hU : IsOpen U) {n : ℕ} (hn : 1 ≤ n) (hf : ContDiffOn ℝ (n : ℕ) f U) {x : ℝ} (hx : x ∈ U) : DifferentiableAt ℝ f x :=
  ((hf x hx).differentiableWithinAt (by exact_mod_cast (by omega : n ≠ 0))).differentiableAt (hU.mem_nhds hx)
private lemma contDiffOn_iteratedDeriv {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {f : ℝ → E} {U : Set ℝ} (hU : IsOpen U) {n m : ℕ} (hm : m ≤ n) (hf : ContDiffOn ℝ (n : ℕ) f U) : ContDiffOn ℝ (n - m : ℕ) (iteratedDeriv m f) U := by
  induction m with | zero => simpa using hf | succ m ih => rw [iteratedDeriv_succ]; exact (ih (by omega)).deriv_of_isOpen hU (by norm_cast; omega)
private lemma hasDerivAt_iteratedDeriv_of_contDiffOn {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {f : ℝ → E} {U : Set ℝ} (hU : IsOpen U) {n m : ℕ} (hm : m < n) (hf : ContDiffOn ℝ (n : ℕ) f U) {x : ℝ} (hx : x ∈ U) : HasDerivAt (iteratedDeriv m f) (iteratedDeriv (m + 1) f x) x := by
  rw [iteratedDeriv_succ]; exact (diffAt_of_contDiffOn hU (by omega : 1 ≤ n - m) (contDiffOn_iteratedDeriv hU hm.le hf) hx).hasDerivAt
private lemma contDiff_iteratedDeriv_infty {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {f : ℝ → E} (hf : ContDiff ℝ (⊤ : ℕ∞) f) (k : ℕ) : ContDiff ℝ (⊤ : ℕ∞) (iteratedDeriv k f) := by
  induction k with | zero => simpa using hf | succ _ ih => rw [iteratedDeriv_succ]; exact (contDiff_infty_iff_deriv.mp ih).2
private lemma hasDerivAt_ofReal_pow (k : ℕ) (x : ℝ) : HasDerivAt (fun t : ℝ => (t : ℂ) ^ k) ((k : ℂ) * (x : ℂ) ^ (k - 1)) x := by
  rcases k with _ | k; { simpa using hasDerivAt_const x (1 : ℂ) }; exact ((Complex.ofRealCLM.hasDerivAt (x := x)).pow (k + 1)).congr_deriv (by simp)
private lemma xpow_iteratedDeriv_mul_bound {f g : ℝ → ℂ} {U : Set ℝ} (hU : IsOpen U) {k : ℕ} (hf : ContDiffOn ℝ (k : ℕ) f U) (hg : ContDiffOn ℝ (k : ℕ) g U)
    (A B : ℝ) (hA : 0 ≤ A) {x : ℝ} (hx : x ∈ U) (h1 : ∀ r ≤ k, ‖(x : ℂ) ^ r * iteratedDeriv r f x‖ ≤ A) (h2 : ∀ r ≤ k, ‖(x : ℂ) ^ r * iteratedDeriv r g x‖ ≤ B) : ‖(x : ℂ) ^ k * iteratedDeriv k (fun t => f t * g t) x‖ ≤ 2 ^ k * A * B := by
  rw [iteratedDeriv_fun_mul ((hf x hx).contDiffAt (hU.mem_nhds hx)) ((hg x hx).contDiffAt (hU.mem_nhds hx)), Finset.mul_sum]
  calc ‖∑ r ∈ Finset.range (k + 1), (x : ℂ) ^ k * ((k.choose r : ℂ) * iteratedDeriv r f x * iteratedDeriv (k - r) g x)‖
      ≤ ∑ r ∈ Finset.range (k + 1), (k.choose r : ℝ) * A * B := (norm_sum_le _ _).trans (Finset.sum_le_sum fun r hr => by
        have hrk := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr); rw [show (x : ℂ) ^ k * ((k.choose r : ℂ) * iteratedDeriv r f x * iteratedDeriv (k - r) g x) = (k.choose r : ℂ) * ((x : ℂ) ^ r * iteratedDeriv r f x) * ((x : ℂ) ^ (k - r) * iteratedDeriv (k - r) g x) from (by rw [show (x : ℂ) ^ k = (x : ℂ) ^ r * (x : ℂ) ^ (k - r) from (by rw [← pow_add, Nat.add_sub_of_le hrk])]; ring), norm_mul, norm_mul, Complex.norm_natCast]
        exact mul_le_mul (mul_le_mul_of_nonneg_left (h1 r hrk) (Nat.cast_nonneg _)) (h2 (k - r) (Nat.sub_le k r)) (norm_nonneg _) (by positivity))
    _ = 2 ^ k * A * B := by rw [← Finset.sum_mul, ← Finset.sum_mul, show (∑ r ∈ Finset.range (k + 1), (k.choose r : ℝ)) = 2 ^ k from by exact_mod_cast Nat.sum_range_choose k]
private lemma xpow_iteratedDeriv_bounded_of_const_tails {f : ℝ → ℂ} (hf : ContDiff ℝ (⊤ : ℕ∞) f) {a b : ℝ} (ha : ∀ y ≤ a, f y = f a) (hb : ∀ y ≥ b, f y = f b) (k : ℕ) :
    ∃ C > 0, ∀ y : ℝ, ‖(y : ℂ) ^ k * iteratedDeriv k f y‖ ≤ C := by
  rcases k with _ | k
  · obtain ⟨M, hM⟩ := (isCompact_Icc (a := a) (b := b)).exists_bound_of_continuousOn hf.continuous.continuousOn
    refine ⟨max (max M ‖f a‖) ‖f b‖ + 1, by positivity, fun y => ?_⟩; simp only [pow_zero, iteratedDeriv_zero, one_mul]
    rcases le_or_gt y a with h1 | h1; { rw [ha y h1]; exact (le_max_right _ _).trans ((le_max_left _ _).trans (by linarith)) }
    rcases le_or_gt b y with h2 | h2; { rw [hb y h2]; exact (le_max_right _ _).trans (by linarith) }
    exact (hM y ⟨h1.le, h2.le⟩).trans ((le_max_left _ _).trans ((le_max_left _ _).trans (by linarith)))
  · have hzero : ∀ m : ℕ, (∀ y ≤ a, iteratedDeriv (m + 1) f y = 0) ∧ (∀ y ≥ b, iteratedDeriv (m + 1) f y = 0) := fun m => by
      induction m with | zero => exact ⟨fun y hy => by simpa [iteratedDeriv_one] using deriv_eq_zero_of_const_Iic (hf.differentiable (by simp) y) ha hy, fun y hy => by simpa [iteratedDeriv_one] using deriv_eq_zero_of_const_Ici (hf.differentiable (by simp) y) hb hy⟩ | succ m ihm =>
        have hcd := contDiff_iteratedDeriv_infty hf (m + 1); exact ⟨fun y hy => by rw [iteratedDeriv_succ]; exact deriv_eq_zero_of_const_Iic (hcd.differentiable (by simp) y) (fun z hz => by rw [ihm.1 z hz, ihm.1 a le_rfl]) hy, fun y hy => by rw [iteratedDeriv_succ]; exact deriv_eq_zero_of_const_Ici (hcd.differentiable (by simp) y) (fun z hz => by rw [ihm.2 z hz, ihm.2 b le_rfl]) hy⟩
    obtain ⟨M, hM⟩ := (isCompact_Icc (a := a) (b := b)).exists_bound_of_continuousOn (((Complex.ofRealCLM.contDiff.pow (k + 1)).mul (contDiff_iteratedDeriv_infty hf (k + 1))).continuous.continuousOn)
    refine ⟨max M 0 + 1, by positivity, fun y => ?_⟩
    rcases le_or_gt y a with h1 | h1; { rw [(hzero k).1 y h1, mul_zero, norm_zero]; positivity }
    rcases le_or_gt b y with h2 | h2; { rw [(hzero k).2 y h2, mul_zero, norm_zero]; positivity }
    exact (hM y ⟨h1.le, h2.le⟩).trans (by linarith [le_max_left M 0])
private noncomputable def eulerOp (f : ℝ → ℂ) (x : ℝ) : ℂ := (x : ℂ) * _root_.deriv f x
private lemma eulerOp_contDiffOn {f : ℝ → ℂ} {U : Set ℝ} (hU : IsOpen U) (hf : ContDiffOn ℝ (⊤ : ℕ∞) f U) : ∀ k : ℕ, ContDiffOn ℝ (⊤ : ℕ∞) (eulerOp^[k] f) U := fun k => by
  induction k with | zero => simpa using hf | succ k ih => rw [congrFun (Function.iterate_succ' eulerOp k) f]; exact Complex.ofRealCLM.contDiff.contDiffOn.mul (contDiffOn_infty.mpr fun n => (ih.of_le (coe_nat_le_infty (n + 1))).deriv_of_isOpen hU (by norm_cast))
private lemma eulerOp_congr {f g : ℝ → ℂ} {U : Set ℝ} (hU : IsOpen U) (hfg : EqOn f g U) : ∀ k : ℕ, EqOn (eulerOp^[k] f) (eulerOp^[k] g) U := fun k => by
  induction k with | zero => exact hfg | succ k ih => intro x hx; simp only [Function.iterate_succ_apply', eulerOp]; rw [(ih.eventuallyEq_of_mem (hU.mem_nhds hx)).deriv_eq]
private lemma eulerOp_linear_iterate {f₁ f₂ : ℝ → ℂ} (c₁ c₂ : ℂ) {U : Set ℝ} (hU : IsOpen U) (h1 : ContDiffOn ℝ (⊤ : ℕ∞) f₁ U) (h2 : ContDiffOn ℝ (⊤ : ℕ∞) f₂ U) :
    ∀ k : ℕ, ∀ x ∈ U, eulerOp^[k] (fun t => c₁ * f₁ t + c₂ * f₂ t) x = c₁ * eulerOp^[k] f₁ x + c₂ * eulerOp^[k] f₂ x := fun k => by
  induction k generalizing f₁ f₂ with | zero => intro x _; simp | succ k ih =>
    intro x hx; have heq : EqOn (eulerOp (fun t => c₁ * f₁ t + c₂ * f₂ t)) (fun t => c₁ * eulerOp f₁ t + c₂ * eulerOp f₂ t) U := fun y hy => by
      dsimp only [eulerOp]; rw [(((diffAt_of_contDiffOn hU le_rfl (h1.of_le (coe_nat_le_infty 1)) hy).hasDerivAt.const_mul c₁).fun_add ((diffAt_of_contDiffOn hU le_rfl (h2.of_le (coe_nat_le_infty 1)) hy).hasDerivAt.const_mul c₂)).deriv]; ring
    rw [congrFun (Function.iterate_succ eulerOp k) _, congrFun (Function.iterate_succ eulerOp k) f₁, congrFun (Function.iterate_succ eulerOp k) f₂]; dsimp only [Function.comp_def]; rw [eulerOp_congr hU heq k hx]; exact ih (eulerOp_contDiffOn hU h1 1) (eulerOp_contDiffOn hU h2 1) x hx
private lemma eulerOp_contDiffOn_nat (m : ℕ) (f : ℝ → ℂ) (U : Set ℝ) (hU : IsOpen U) {N : ℕ} (hm : m ≤ N) (hf : ContDiffOn ℝ (N : ℕ) f U) : ContDiffOn ℝ (N - m : ℕ) (eulerOp^[m] f) U := by
  induction m generalizing f N with | zero => simpa using hf | succ m ih => obtain ⟨M, rfl⟩ : ∃ M, N = M + 1 := ⟨N - 1, by omega⟩; rw [congrFun (Function.iterate_succ eulerOp m) f]; simpa [Nat.succ_sub_succ] using ih (eulerOp f) (by omega) ((Complex.ofRealCLM.contDiff.contDiffOn.of_le (coe_nat_le_infty M)).mul (hf.deriv_of_isOpen hU (by norm_cast)))
private lemma xpow_iteratedDeriv_eq_sum_eulerOp : ∀ k : ℕ, ∃ c : ℕ → ℝ, ∀ (f : ℝ → ℂ) (U : Set ℝ), IsOpen U → ContDiffOn ℝ (k : ℕ) f U →
    ∀ x ∈ U, (x : ℂ) ^ k * iteratedDeriv k f x = ∑ m ∈ Finset.range (k + 1), (c m : ℂ) * eulerOp^[m] f x := fun k => by
  induction k with | zero => exact ⟨fun _ => 1, fun _ _ _ _ _ _ => by simp⟩ | succ k ih =>
    obtain ⟨c, hc⟩ := ih; let c' : ℕ → ℝ := fun m => (if 1 ≤ m then c (m - 1) else 0) - (if m ≤ k then (k : ℝ) * c m else 0)
    refine ⟨c', fun f U hU hf x hx => ?_⟩; have hf' := hf.of_le (by norm_cast; omega : ((k : ℕ) : ℕ∞ω) ≤ ((k + 1 : ℕ) : ℕ∞ω))
    have hev : (fun t : ℝ => (t : ℂ) ^ k * iteratedDeriv k f t) =ᶠ[𝓝 x] fun t : ℝ => ∑ m ∈ Finset.range (k + 1), (c m : ℂ) * eulerOp^[m] f t := Filter.eventually_of_mem (hU.mem_nhds hx) fun t ht => hc f U hU hf' t ht
    have hL := (hasDerivAt_ofReal_pow k x).fun_mul (hasDerivAt_iteratedDeriv_of_contDiffOn hU (Nat.lt_succ_self k) hf hx) |>.congr_deriv (by ring : _ = (k : ℂ) * (x : ℂ) ^ (k - 1) * iteratedDeriv k f x + (x : ℂ) ^ k * iteratedDeriv (k + 1) f x)
    have hR : HasDerivAt (fun t : ℝ => ∑ m ∈ Finset.range (k + 1), (c m : ℂ) * eulerOp^[m] f t) (∑ m ∈ Finset.range (k + 1), (c m : ℂ) * _root_.deriv (eulerOp^[m] f) x) x :=
      HasDerivAt.fun_sum fun m hm => (diffAt_of_contDiffOn hU (by have := Finset.mem_range.mp hm; omega : 1 ≤ k + 1 - m) (eulerOp_contDiffOn_nat m f U hU (by have := Finset.mem_range.mp hm; omega) hf) hx).hasDerivAt.const_mul _
    have hxmul := congrArg (fun z : ℂ => (x : ℂ) * z) (hL.deriv.symm.trans (hev.deriv_eq.trans hR.deriv))
    have hpow_lhs : (x : ℂ) * ((k : ℂ) * (x : ℂ) ^ (k - 1) * iteratedDeriv k f x + (x : ℂ) ^ k * iteratedDeriv (k + 1) f x) = (k : ℂ) * ((x : ℂ) ^ k * iteratedDeriv k f x) + (x : ℂ) ^ (k + 1) * iteratedDeriv (k + 1) f x := by rcases k with _ | k; { simp }; rw [Nat.add_sub_cancel]; ring
    rw [hpow_lhs, hc f U hU hf' x hx, Finset.mul_sum, Finset.mul_sum, show ∑ m ∈ Finset.range (k + 1), (x : ℂ) * ((c m : ℂ) * _root_.deriv (eulerOp^[m] f) x) = ∑ m ∈ Finset.range (k + 1), (c m : ℂ) * eulerOp^[m + 1] f x from Finset.sum_congr rfl fun m _ => by rw [Function.iterate_succ_apply']; simp [eulerOp]; ring] at hxmul
    rw [eq_sub_of_add_eq' hxmul, sum_range_shift_mul (fun m => (c m : ℂ)) (fun m => eulerOp^[m] f x) k, sum_range_le_extend (fun m => (k : ℂ) * ((c m : ℂ) * eulerOp^[m] f x)) k, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun m _ => by dsimp only [c']; split_ifs <;> push_cast <;> ring
private lemma eulerOp_iterated_eq_sum_xpow : ∀ r : ℕ, ∃ d : ℕ → ℝ, ∀ (f : ℝ → ℂ) (U : Set ℝ), IsOpen U → ContDiffOn ℝ (r : ℕ) f U →
    ∀ x ∈ U, eulerOp^[r] f x = ∑ m ∈ Finset.range (r + 1), (d m : ℂ) * ((x : ℂ) ^ m * iteratedDeriv m f x) := fun r => by
  induction r with | zero => exact ⟨fun _ => 1, fun _ _ _ _ _ _ => by simp⟩ | succ r ih =>
    obtain ⟨d, hd⟩ := ih; let d' : ℕ → ℝ := fun m => (if m ≤ r then (m : ℝ) * d m else 0) + (if 1 ≤ m then d (m - 1) else 0)
    refine ⟨d', fun f U hU hf x hx => ?_⟩; have hf' := hf.of_le (by norm_cast; omega : ((r : ℕ) : ℕ∞ω) ≤ ((r + 1 : ℕ) : ℕ∞ω))
    have hev : eulerOp^[r] f =ᶠ[𝓝 x] fun t : ℝ => ∑ m ∈ Finset.range (r + 1), (d m : ℂ) * ((t : ℂ) ^ m * iteratedDeriv m f t) := Filter.eventually_of_mem (hU.mem_nhds hx) fun t ht => hd f U hU hf' t ht
    have hD : HasDerivAt (fun t : ℝ => ∑ m ∈ Finset.range (r + 1), (d m : ℂ) * ((t : ℂ) ^ m * iteratedDeriv m f t)) (∑ m ∈ Finset.range (r + 1), (d m : ℂ) * ((m : ℂ) * (x : ℂ) ^ (m - 1) * iteratedDeriv m f x + (x : ℂ) ^ m * iteratedDeriv (m + 1) f x)) x :=
      HasDerivAt.fun_sum fun m hm => ((hasDerivAt_ofReal_pow m x).fun_mul (hasDerivAt_iteratedDeriv_of_contDiffOn hU (by have := Finset.mem_range.mp hm; omega) hf hx) |>.congr_deriv (by ring)).const_mul _
    rw [Function.iterate_succ_apply', eulerOp, hev.deriv_eq, hD.deriv, Finset.mul_sum]
    have hsplit : ∑ m ∈ Finset.range (r + 1), (x : ℂ) * ((d m : ℂ) * ((m : ℂ) * (x : ℂ) ^ (m - 1) * iteratedDeriv m f x + (x : ℂ) ^ m * iteratedDeriv (m + 1) f x)) =
        (∑ m ∈ Finset.range (r + 1), ((m : ℝ) * d m : ℂ) * ((x : ℂ) ^ m * iteratedDeriv m f x)) + ∑ m ∈ Finset.range (r + 1), (d m : ℂ) * ((x : ℂ) ^ (m + 1) * iteratedDeriv (m + 1) f x) := by
      rw [← Finset.sum_add_distrib]; refine Finset.sum_congr rfl fun m _ => ?_; rcases m with _ | m; { simp [mul_left_comm] }; rw [Nat.add_sub_cancel]; push_cast; ring
    rw [hsplit, sum_range_le_extend (fun m => ((m : ℝ) * d m : ℂ) * ((x : ℂ) ^ m * iteratedDeriv m f x)) r, sum_range_shift_mul (fun m => (d m : ℂ)) (fun m => (x : ℂ) ^ m * iteratedDeriv m f x) r, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun m _ => by dsimp only [d']; split_ifs <;> push_cast <;> ring
private lemma boundedVariationOn_eVariationOn_le_of_deriv_le {f : ℝ → ℂ} {a b K : ℝ} (hab : a ≤ b) (hK : 0 ≤ K) (hdiff : ∀ x ∈ Icc a b, DifferentiableAt ℝ f x) (hderiv : ∀ x ∈ Icc a b, ‖_root_.deriv f x‖ ≤ K) :
    BoundedVariationOn f (Icc a b) ∧ (eVariationOn f (Icc a b)).toReal ≤ K * (b - a) := by
  let Knn : NNReal := ⟨K, hK⟩; have hlip : LipschitzOnWith Knn f (Icc a b) := (convex_Icc a b).lipschitzOnWith_of_nnnorm_deriv_le hdiff fun x hx => NNReal.coe_le_coe.mp (hderiv x hx)
  have hev : eVariationOn f (Icc a b) ≤ ENNReal.ofReal (K * (b - a)) := by
    refine iSup_le ?_; rintro ⟨n, u, hu_mono, hu_mem⟩
    calc ∑ i ∈ Finset.range n, edist (f (u (i + 1))) (f (u i)) ≤ ∑ i ∈ Finset.range n, (Knn : ENNReal) * ENNReal.ofReal (u (i + 1) - u i) := Finset.sum_le_sum fun i _ => by simpa [edist_dist, Real.dist_eq, abs_of_nonneg (sub_nonneg.mpr (hu_mono (Nat.le_succ i)))] using hlip (hu_mem (i + 1)) (hu_mem i)
      _ = (Knn : ENNReal) * ENNReal.ofReal (u n - u 0) := by rw [← Finset.mul_sum, ← ENNReal.ofReal_sum_of_nonneg (fun i _ => sub_nonneg.mpr (hu_mono (Nat.le_succ i))), Finset.sum_range_sub u n]
      _ ≤ ENNReal.ofReal (K * (b - a)) := by rw [ENNReal.coe_nnreal_eq Knn, show (Knn : ℝ) = K from rfl, ← ENNReal.ofReal_mul hK]; exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left (sub_le_sub (hu_mem n).2 (hu_mem 0).1) hK)
  exact ⟨ne_top_of_le_ne_top ENNReal.ofReal_lt_top.ne hev, ENNReal.toReal_le_of_le_ofReal (mul_nonneg hK (sub_nonneg.mpr hab)) hev⟩
private lemma contDiff_mul_of_contDiffOn_Ici_zero_left {x₀ : ℝ} : ∀ (n : ℕ) (b : ℝ → ℂ) (φ : ℝ → ℝ),
    ContDiffOn ℝ (n : ℕ) b (Ici x₀) → ContDiff ℝ (⊤ : ℕ∞) φ → (∀ x ≤ x₀, φ x = 0) → ContDiff ℝ (n : ℕ) (fun x => b x * (φ x : ℂ)) := fun n => by
  induction n with
  | zero =>
    intro b φ hb hφ hzero; simp only [Nat.cast_zero, contDiff_zero]; rw [continuous_iff_continuousAt]; intro x; rcases lt_trichotomy x x₀ with hx | hxeq | hx
    · exact (continuousAt_const (y := (0 : ℂ))).congr (Filter.eventually_of_mem (isOpen_Iio.mem_nhds hx) fun y hy => by simp [hzero y hy.le])
    · subst hxeq; exact continuousAt_iff_continuous_left_right.mpr ⟨continuousWithinAt_const (b := (0 : ℂ)).congr (fun y hy => by simp [hzero y hy]) (by simp [hzero x le_rfl]), (hb.continuousOn x self_mem_Ici).mul (Complex.continuous_ofReal.continuousAt.comp hφ.continuous.continuousAt).continuousWithinAt⟩
    · exact (((hb.mono Ioi_subset_Ici_self).continuousOn x hx).mul (Complex.continuous_ofReal.continuousAt.comp hφ.continuous.continuousAt).continuousWithinAt).continuousAt (isOpen_Ioi.mem_nhds hx)
  | succ n ih =>
    intro b φ hb hφ hzero; rw [show ((n + 1 : ℕ) : ℕ∞ω) = (n : ℕ∞ω) + 1 by norm_cast, contDiff_succ_iff_deriv]
    have hdφ : ∀ x ≤ x₀, _root_.deriv φ x = 0 := fun x hx => deriv_eq_zero_of_const_Iic (hφ.differentiable (by simp) x) (fun y hy => by rw [hzero y hy, hzero x₀ le_rfl]) hx; let b' := fun x => derivWithin b (Ici x₀) x
    have hda : ∀ x : ℝ, HasDerivAt (fun t => b t * (φ t : ℂ)) (b' x * (φ x : ℂ) + b x * ((_root_.deriv φ x : ℝ) : ℂ)) x := fun x => by
      rcases lt_trichotomy x x₀ with hx | hxeq | hx
      · rw [show b' x * (φ x : ℂ) + b x * ((_root_.deriv φ x : ℝ) : ℂ) = 0 from (by simp [hzero x hx.le, hdφ x hx.le])]; exact (hasDerivAt_const x (0 : ℂ)).congr_of_eventuallyEq (Filter.eventually_of_mem (isOpen_Iio.mem_nhds hx) fun y hy => by simp [hzero y hy.le])
      · subst hxeq; rw [show b' x * (φ x : ℂ) + b x * ((_root_.deriv φ x : ℝ) : ℂ) = 0 from (by simp [hzero x le_rfl, hdφ x le_rfl])]
        exact hasDerivWithinAt_univ.mp ((Iic_union_Ici : Iic x ∪ Ici x = univ) ▸ ((hasDerivWithinAt_const x (Iic x) (0 : ℂ)).congr (fun y hy => by simp [hzero y hy]) (by simp [hzero x le_rfl])).union (by convert (((hb x self_mem_Ici).differentiableWithinAt (by norm_cast)).hasDerivWithinAt).mul ((hφ.differentiable (by simp) x).hasDerivAt.ofReal_comp.hasDerivWithinAt (s := Ici x)) using 1; simp [hzero x le_rfl, hdφ x le_rfl]))
      · exact (((hb x hx.le).differentiableWithinAt (by norm_cast)).hasDerivWithinAt.hasDerivAt (Ici_mem_nhds hx)).mul (hφ.differentiable (by simp) x).hasDerivAt.ofReal_comp
    refine ⟨fun x => (hda x).differentiableAt, fun h => by simp at h, ?_⟩; rw [show _root_.deriv (fun t => b t * (φ t : ℂ)) = fun x => b' x * (φ x : ℂ) + b x * ((_root_.deriv φ x : ℝ) : ℂ) from funext fun x => (hda x).deriv]
    exact (ih b' φ (hb.derivWithin (uniqueDiffOn_Ici x₀) (by norm_cast)) hφ hzero).add (ih b (_root_.deriv φ) (hb.of_le (by norm_cast; omega)) (contDiff_infty_iff_deriv.mp hφ).2 hdφ)

/-! ## Section 1: Explicit Global Morse Coordinate (`Proof of GT.1s` Step 3) -/

/-- Rescaled stationary phase `φ(Y) = (4/3) Y^{3/2} - Y + 1/12`. -/
noncomputable def airyMorsePhi (Y : ℝ) : ℝ := (4 / 3 : ℝ) * Y ^ (3 / 2 : ℝ) - Y + 1 / 12
/-- Explicit global Morse coordinate `z(Y) = (2 √Y - 1) √((4 √Y + 1)/12)` on `Y ≥ 0`. -/
noncomputable def airyMorseZ (Y : ℝ) : ℝ := (2 * Real.sqrt Y - 1) * Real.sqrt ((4 * Real.sqrt Y + 1) / 12)
@[simp] lemma airyMorseZ_zero : airyMorseZ 0 = -1 / Real.sqrt 12 := by simp only [airyMorseZ, Real.sqrt_zero]; ring_nf; rw [Real.sqrt_div zero_le_one, Real.sqrt_one]; ring
@[simp] lemma airyMorseZ_quarter : airyMorseZ (1 / 4) = 0 := by unfold airyMorseZ; rw [show (1 / 4 : ℝ) = (1 / 2) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]; norm_num
theorem airyMorseZ_sq {Y : ℝ} (hY : 0 ≤ Y) : airyMorseZ Y ^ 2 = airyMorsePhi Y := by
  unfold airyMorseZ airyMorsePhi; rw [mul_pow, Real.sq_sqrt (by positivity [Real.sqrt_nonneg Y])]
  have hpow : Y ^ (3 / 2 : ℝ) = Real.sqrt Y * Y := by rw [Real.sqrt_eq_rpow, ← Real.rpow_add_one' hY (by norm_num : (1 / 2 : ℝ) + 1 ≠ 0)]; norm_num
  rw [hpow, show (2 * Real.sqrt Y - 1) ^ 2 * ((4 * Real.sqrt Y + 1) / 12) = (4 / 3) * Real.sqrt Y * Real.sqrt Y ^ 2 - Real.sqrt Y ^ 2 + (Real.sqrt Y ^ 2 - Real.sqrt Y) * (1 / 3) + 1 / 12 - Real.sqrt Y ^ 2 * (1 / 3) + Real.sqrt Y * (1 / 3) by ring, Real.sq_sqrt hY]; ring
theorem airyMorseZ_hasDerivAt {Y : ℝ} (hY : 0 < Y) : HasDerivAt airyMorseZ (Real.sqrt (3 / (4 * Real.sqrt Y + 1))) Y := by
  have hs := Real.sqrt_pos.mpr hY; have hrp : 0 < (4 * Real.sqrt Y + 1) / 12 := by positivity
  have hr := Real.sqrt_pos.mpr hrp; have hs_d := Real.hasDerivAt_sqrt hY.ne'; have hsq_r := Real.sq_sqrt hrp.le
  have hsq_d := (Real.hasDerivAt_sqrt hrp.ne').comp Y ((((hs_d.const_mul 4).add_const 1).div_const 12).congr_deriv (by ring) : HasDerivAt (fun t => (4 * Real.sqrt t + 1) / 12) (1 / (6 * Real.sqrt Y)) Y)
  have hlin_d := ((hs_d.const_mul 2).sub_const 1).congr_deriv (by field_simp [hs.ne'] : 2 * (1 / (2 * Real.sqrt Y)) = 1 / Real.sqrt Y)
  refine (hlin_d.mul hsq_d).congr_deriv ?_; dsimp only [Function.comp_def]
  have halg : (1 / Real.sqrt Y) * Real.sqrt ((4 * Real.sqrt Y + 1) / 12) + (2 * Real.sqrt Y - 1) * ((1 / (2 * Real.sqrt ((4 * Real.sqrt Y + 1) / 12))) * (1 / (6 * Real.sqrt Y))) = 1 / (2 * Real.sqrt ((4 * Real.sqrt Y + 1) / 12)) := by
    field_simp [hs.ne', hr.ne']; rw [show Real.sqrt Y * 4 = 4 * Real.sqrt Y by ring, hsq_r]; ring
  rw [halg]; refine (sq_eq_sq₀ (by positivity) (Real.sqrt_nonneg _)).mp ?_; rw [div_pow, one_pow, mul_pow, hsq_r, Real.sq_sqrt (by positivity)]; field_simp [(by linarith : 4 * Real.sqrt Y + 1 ≠ 0)]; ring
lemma airyMorseZ_deriv_pos {Y : ℝ} (_hY : 0 < Y) : 0 < Real.sqrt (3 / (4 * Real.sqrt Y + 1)) := Real.sqrt_pos.mpr (div_pos (by norm_num) (by linarith [Real.sqrt_nonneg Y]))
lemma airyMorseZ_deriv_quarter : Real.sqrt (3 / (4 * Real.sqrt (1 / 4) + 1)) = 1 := by rw [show (1 / 4 : ℝ) = (1 / 2 : ℝ) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]; norm_num
theorem airyMorseZ_contDiffOn : ContDiffOn ℝ (⊤ : ℕ∞) airyMorseZ (Ioi 0) := fun Y hY => by
  have hsqrt := Real.contDiffAt_sqrt (n := (⊤ : ℕ∞)) (mem_Ioi.mp hY).ne'
  exact (((contDiffAt_const.mul hsqrt).sub contDiffAt_const).mul ((Real.contDiffAt_sqrt (n := (⊤ : ℕ∞)) (by positivity)).comp Y (((contDiffAt_const.mul hsqrt).add contDiffAt_const).div_const 12))).contDiffWithinAt
lemma airyMorseZ_continuousOn : ContinuousOn airyMorseZ (Ici 0) :=
  ((Real.continuous_sqrt.continuousOn.const_mul 2).sub continuousOn_const).mul (Real.continuous_sqrt.continuousOn.comp (((Real.continuous_sqrt.continuousOn.const_mul 4).add continuousOn_const).div_const 12) (mapsTo_univ _ _))
theorem airyMorseZ_strictMonoOn : StrictMonoOn airyMorseZ (Ici 0) :=
  strictMonoOn_of_deriv_pos (convex_Ici 0) airyMorseZ_continuousOn fun Y hY => by rw [interior_Ici] at hY; rw [(airyMorseZ_hasDerivAt hY).deriv]; exact airyMorseZ_deriv_pos hY
theorem airyMorseZ_image_Ioi : airyMorseZ '' Ioi 0 = Ioi (-1 / Real.sqrt 12) := by
  ext z; simp only [mem_image, mem_Ioi]; constructor
  · rintro ⟨Y, hY, rfl⟩; rw [← airyMorseZ_zero]; exact airyMorseZ_strictMonoOn self_mem_Ici hY.le hY
  · intro hz; let s₁ := max 1 (z * Real.sqrt 12 + 1); have hs₁ : 1 ≤ s₁ := le_max_left _ _
    have hz_le : z ≤ airyMorseZ (s₁ ^ 2) := by
      unfold airyMorseZ; rw [Real.sqrt_sq (by linarith)]
      have hrad : 1 / Real.sqrt 12 ≤ Real.sqrt ((4 * s₁ + 1) / 12) := by rw [← Real.sqrt_one, ← Real.sqrt_div zero_le_one]; exact Real.sqrt_le_sqrt (by linarith)
      calc z = (z * Real.sqrt 12) * (1 / Real.sqrt 12) := by field_simp [(Real.sqrt_pos.mpr (by norm_num : (0 : ℝ) < 12)).ne']
        _ ≤ (2 * s₁ - 1) * (1 / Real.sqrt 12) := by gcongr; linarith [le_max_right (1 : ℝ) (z * Real.sqrt 12 + 1)]
        _ ≤ (2 * s₁ - 1) * Real.sqrt ((4 * s₁ + 1) / 12) := by gcongr; linarith
    obtain ⟨Y, hYm, hYe⟩ := intermediate_value_Icc (by positivity : (0 : ℝ) ≤ s₁ ^ 2) (airyMorseZ_continuousOn.mono Icc_subset_Ici_self) ⟨airyMorseZ_zero ▸ hz.le, hz_le⟩
    exact ⟨Y, lt_of_le_of_ne hYm.1 fun h0 => by rw [← h0, airyMorseZ_zero] at hYe; linarith, hYe⟩
/-- Smooth global Morse inverse `Y(z)` on `Ioi (-1 / √12)`. -/
noncomputable def airyMorseY (z : ℝ) : ℝ := if hz : -1 / Real.sqrt 12 < z then Classical.choose ((airyMorseZ_image_Ioi ▸ hz : z ∈ airyMorseZ '' Ioi 0)) else 0
lemma airyMorseY_pos {z : ℝ} (hz : -1 / Real.sqrt 12 < z) : 0 < airyMorseY z := by simp only [airyMorseY, hz, ↓reduceDIte]; exact (Classical.choose_spec ((airyMorseZ_image_Ioi ▸ hz : z ∈ airyMorseZ '' Ioi 0))).1
lemma airyMorseZ_airyMorseY {z : ℝ} (hz : -1 / Real.sqrt 12 < z) : airyMorseZ (airyMorseY z) = z := by simp only [airyMorseY, hz, ↓reduceDIte]; exact (Classical.choose_spec ((airyMorseZ_image_Ioi ▸ hz : z ∈ airyMorseZ '' Ioi 0))).2
lemma airyMorseY_airyMorseZ {Y : ℝ} (hY : 0 < Y) : airyMorseY (airyMorseZ Y) = Y := by
  have hz : -1 / Real.sqrt 12 < airyMorseZ Y := by rw [← airyMorseZ_zero]; exact airyMorseZ_strictMonoOn self_mem_Ici hY.le hY
  exact airyMorseZ_strictMonoOn.injOn (airyMorseY_pos hz).le hY.le (airyMorseZ_airyMorseY hz)
lemma airyMorseY_strictMonoOn : StrictMonoOn airyMorseY (Ioi (-1 / Real.sqrt 12)) := fun z₁ hz₁ z₂ hz₂ hlt => by
  by_contra hle; push Not at hle; have hm := airyMorseZ_strictMonoOn.monotoneOn (airyMorseY_pos hz₂).le (airyMorseY_pos hz₁).le hle; rw [airyMorseZ_airyMorseY hz₂, airyMorseZ_airyMorseY hz₁] at hm; linarith
private lemma airyMorseY_localInverse_eq {z₀ : ℝ} (hz₀ : -1 / Real.sqrt 12 < z₀) :
    ∃ g : ℝ → ℝ, ContDiffAt ℝ (⊤ : ℕ∞) g z₀ ∧ HasDerivAt g ((Real.sqrt (3 / (4 * Real.sqrt (airyMorseY z₀) + 1)))⁻¹) z₀ ∧ airyMorseY =ᶠ[𝓝 z₀] g := by
  set Y₀ := airyMorseY z₀; have hY₀ := airyMorseY_pos hz₀; have hcd := (airyMorseZ_contDiffOn Y₀ hY₀).contDiffAt (isOpen_Ioi.mem_nhds hY₀)
  let L := ContinuousLinearEquiv.unitsEquivAut ℝ (Units.mk0 _ (airyMorseZ_deriv_pos hY₀).ne')
  have hf' : HasFDerivAt airyMorseZ (L : ℝ →L[ℝ] ℝ) Y₀ := by convert (airyMorseZ_hasDerivAt hY₀).hasFDerivAt using 1; ext; simp [L, ContinuousLinearEquiv.unitsEquivAut]
  have hstrict := hcd.hasStrictFDerivAt' hf' (by simp); let g := hcd.localInverse hf' (by simp)
  have hg_cd : ContDiffAt ℝ (⊤ : ℕ∞) g z₀ := by have := hcd.to_localInverse hf' (by simp); rwa [airyMorseZ_airyMorseY hz₀] at this
  have hg_d : HasDerivAt g (Real.sqrt (3 / (4 * Real.sqrt Y₀ + 1)))⁻¹ z₀ := by have h1 := hstrict.to_localInverse; rw [airyMorseZ_airyMorseY hz₀] at h1; exact h1.hasFDerivAt.hasDerivAt.congr_deriv (by dsimp [L, Y₀, ContinuousLinearEquiv.unitsEquivAut]; simp)
  have hg0 : g z₀ = Y₀ := by have := hcd.localInverse_apply_image hf' (by simp); rwa [airyMorseZ_airyMorseY hz₀] at this
  have hright : ∀ᶠ z in 𝓝 z₀, airyMorseZ (g z) = z := by have := hstrict.eventually_right_inverse; rwa [airyMorseZ_airyMorseY hz₀] at this
  refine ⟨g, hg_cd, hg_d, ?_⟩
  filter_upwards [hright, hg_cd.continuousAt.eventually (by rw [hg0]; exact Ioi_mem_nhds hY₀), isOpen_Ioi.mem_nhds hz₀] with z hrz hgz hzm
  exact airyMorseZ_strictMonoOn.injOn (airyMorseY_pos hzm).le hgz.le ((airyMorseZ_airyMorseY hzm).trans hrz.symm)
theorem airyMorseY_contDiffOn : ContDiffOn ℝ (⊤ : ℕ∞) airyMorseY (Ioi (-1 / Real.sqrt 12)) := fun z hz => by obtain ⟨g, hg_cd, _, hev⟩ := airyMorseY_localInverse_eq hz; exact (hg_cd.congr_of_eventuallyEq hev).contDiffWithinAt
theorem airyMorseY_hasDerivAt {z : ℝ} (hz : -1 / Real.sqrt 12 < z) : HasDerivAt airyMorseY ((Real.sqrt (3 / (4 * Real.sqrt (airyMorseY z) + 1)))⁻¹) z := by obtain ⟨g, _, hg_d, hev⟩ := airyMorseY_localInverse_eq hz; exact hg_d.congr_of_eventuallyEq hev
lemma airyMorseY_deriv_pos {z : ℝ} (hz : -1 / Real.sqrt 12 < z) : 0 < (Real.sqrt (3 / (4 * Real.sqrt (airyMorseY z) + 1)))⁻¹ := inv_pos.mpr (airyMorseZ_deriv_pos (airyMorseY_pos hz))

/-! ## Section 2: Symbol Class, Phase Polynomials, and `N`-fold IBP -/

/-- `GT.1s` symbol norm bound: `b ∈ C^{N+1}` and `x^{3/2 + k} ‖∂_x^k b(x)‖ ≤ M` for `k ≤ N`, `x > 0`. -/
def IsAirySymbolBound (N : ℕ) (b : ℝ → ℂ) (M : ℝ) : Prop := ContDiff ℝ (N + 1 : ℕ) b ∧ ∀ k ≤ N, ∀ x > 0, x ^ ((3 / 2 : ℝ) + k) * ‖iteratedDeriv k b x‖ ≤ M
private def IsAirySymbolBoundCore (N : ℕ) (b : ℝ → ℂ) (M : ℝ) : Prop := ContDiff ℝ (N : ℕ) b ∧ ∀ k ≤ N, ∀ x > 0, x ^ ((3 / 2 : ℝ) + k) * ‖iteratedDeriv k b x‖ ≤ M
private lemma isAirySymbolBound_to_core {N : ℕ} {b : ℝ → ℂ} {M : ℝ} (hb : IsAirySymbolBound N b M) : IsAirySymbolBoundCore N b M := ⟨hb.1.of_le (by norm_cast; omega), hb.2⟩
/-- Oscillatory Airy phase `Θ_σ(q, x) = q^3/12 + σ (4/3) x^{3/2} - q x`. -/
noncomputable def airyPhase (σ q x : ℝ) : ℝ := q ^ 3 / 12 + σ * (4 / 3 : ℝ) * x ^ (3 / 2 : ℝ) - q * x
/-- Scalar Airy oscillatory integral `I_σ(q; b)`. -/
noncomputable def airyPhaseInt (σ q : ℝ) (b : ℝ → ℂ) : ℂ := Complex.exp (Complex.I * (q ^ 3 / 12 : ℝ)) * ∫ x in Ioi (0 : ℝ), b x * Complex.exp (Complex.I * ((σ * (4 / 3 : ℝ) * x ^ (3 / 2 : ℝ) - q * x : ℝ) : ℂ))
private lemma hasDerivAt_airyPhase_x (σ q : ℝ) {x : ℝ} (hx : 0 < x) : HasDerivAt (airyPhase σ q) (2 * σ * Real.sqrt x - q) x :=
  ((((Real.hasDerivAt_rpow_const (p := (3 / 2 : ℝ)) (Or.inl hx.ne')).const_mul (σ * (4 / 3 : ℝ))).const_add (q ^ 3 / 12)).sub ((hasDerivAt_id x).const_mul q)).congr_deriv (by rw [show (3 / 2 : ℝ) - 1 = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]; ring)
private lemma airyPhase_cexp_cont (σ q : ℝ) : Continuous (fun x => Complex.exp (Complex.I * (airyPhase σ q x : ℝ))) := by unfold airyPhase; fun_prop
private lemma airyPhaseInt_eq_integral_phase {σ q : ℝ} {b : ℝ → ℂ} (_hb : IntegrableOn b (Ioi 0)) : airyPhaseInt σ q b = ∫ x in Ioi (0 : ℝ), b x * Complex.exp (Complex.I * (airyPhase σ q x : ℝ)) := by
  unfold airyPhaseInt airyPhase; rw [← integral_const_mul]; refine setIntegral_congr_fun measurableSet_Ioi fun x _ => ?_; rw [← mul_assoc, mul_comm (Complex.exp _) (b x), mul_assoc, ← Complex.exp_add]; congr 2; push_cast; ring
private lemma integrableOn_of_symbolBound {N : ℕ} {b : ℝ → ℂ} {M x_min x₁ : ℝ} (hx_min : 0 < x_min) (hx₁ : x_min ≤ x₁) (hM : 0 ≤ M) (hsupp : ∀ x < x₁, b x = 0) (hb : IsAirySymbolBoundCore N b M) : IntegrableOn b (Ioi 0) := by
  have hi : IntegrableOn (fun x : ℝ => M * x ^ (-(3 / 2 : ℝ))) (Ici x_min) := (integrableOn_Ici_iff_integrableOn_Ioi).mpr ((integrableOn_Ioi_rpow_of_lt (by norm_num) hx_min).const_mul M)
  refine (integrable_indicator_iff measurableSet_Ici |>.mpr hi).integrableOn.mono' hb.1.continuous.aestronglyMeasurable.restrict ?_
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
  rcases lt_or_ge x x_min with hxlt | hxge; { rw [hsupp x (lt_of_lt_of_le hxlt hx₁), norm_zero]; exact indicator_nonneg (fun y hy => mul_nonneg hM (Real.rpow_nonneg (hx_min.trans_le (mem_Ici.mp hy)).le _)) x }
  rw [indicator_of_mem (mem_Ici.mpr hxge)]; have hbd := hb.2 0 (Nat.zero_le N) x hx; simp only [Nat.cast_zero, add_zero, iteratedDeriv_zero] at hbd; rw [Real.rpow_neg hx.le, ← div_eq_mul_inv, le_div_iff₀ (Real.rpow_pos_of_pos hx _)]; linarith
private lemma symbolBound_rpow_norm_le {N k : ℕ} {b : ℝ → ℂ} {M x : ℝ} (hb : IsAirySymbolBoundCore N b M) (hk : k ≤ N) (hx : 0 < x) : ‖(x : ℂ) ^ k * iteratedDeriv k b x‖ ≤ M * x ^ (-(3 / 2 : ℝ)) := by
  rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hx, Real.rpow_neg hx.le, ← div_eq_mul_inv, le_div_iff₀ (Real.rpow_pos_of_pos hx _),
    show x ^ k * ‖iteratedDeriv k b x‖ * x ^ (3 / 2 : ℝ) = x ^ ((3 / 2 : ℝ) + k) * ‖iteratedDeriv k b x‖ from (by rw [Real.rpow_add hx, Real.rpow_natCast]; ring)]; exact hb.2 k hk x hx
private lemma isAirySymbolBoundCore_mul_const_tails (N : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) {a_lo b_hi : ℝ} (ha : ∀ y ≤ a_lo, φ y = φ a_lo) (hb : ∀ y ≥ b_hi, φ y = φ b_hi) :
    ∃ K > 0, ∀ {q M : ℝ} {b : ℝ → ℂ}, 0 < q → 0 ≤ M → IsAirySymbolBoundCore N b M → IsAirySymbolBoundCore N (fun x => (φ (x / q ^ 2) : ℂ) * b x) (K * M) := by
  let hφ_ex := fun r => xpow_iteratedDeriv_bounded_of_const_tails (a := a_lo) (b := b_hi) (Complex.ofRealCLM.contDiff.comp hφ) (fun y hy => by simp [ha y hy]) (fun y hy => by simp [hb y hy]) r
  let Kφ := ∑ r ∈ Finset.range (N + 1), Classical.choose (hφ_ex r) + 1
  have hKφ_pos : 0 < Kφ := by have : 0 ≤ ∑ r ∈ Finset.range (N + 1), Classical.choose (hφ_ex r) := Finset.sum_nonneg fun r _ => (Classical.choose_spec (hφ_ex r)).1.le; dsimp [Kφ]; linarith
  refine ⟨2 ^ N * Kφ, by positivity, fun {q M} {b} hq hM hsym => ⟨((Complex.ofRealCLM.contDiff.comp (hφ.comp (contDiff_id.div_const (q ^ 2)))).of_le (coe_nat_le_infty N)).mul hsym.1, fun k hk x hx => ?_⟩⟩
  have hφ_cd : ContDiffOn ℝ (k : ℕ) (fun t => (φ (t / q ^ 2) : ℂ)) (Ioi 0) := (Complex.ofRealCLM.contDiff.comp (hφ.comp (contDiff_id.div_const (q ^ 2)))).contDiffOn.of_le (coe_nat_le_infty k)
  rw [show x ^ ((3 / 2 : ℝ) + k) * ‖iteratedDeriv k (fun t => (φ (t / q ^ 2) : ℂ) * b t) x‖ = x ^ (3 / 2 : ℝ) * ‖(x : ℂ) ^ k * iteratedDeriv k (fun t => (φ (t / q ^ 2) : ℂ) * b t) x‖ from (by rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hx, Real.rpow_add hx, Real.rpow_natCast]; ring)]
  have hsum_le := xpow_iteratedDeriv_mul_bound isOpen_Ioi hφ_cd (hsym.1.contDiffOn.of_le (by norm_cast)) Kφ (M * x ^ (-(3 / 2 : ℝ))) hKφ_pos.le hx
    (fun r hr => by
      have hcomp := congrFun (iteratedDeriv_comp_const_smul (n := r) ((Complex.ofRealCLM.contDiff.comp hφ).of_le (coe_nat_le_infty r)) (q ^ 2)⁻¹) x
      rw [show (fun t => (φ (t / q ^ 2) : ℂ)) = fun t => Complex.ofRealCLM (φ ((q ^ 2)⁻¹ * t)) from funext fun t => by simp [div_eq_inv_mul],
        show iteratedDeriv r (fun t => Complex.ofRealCLM (φ ((q ^ 2)⁻¹ * t))) x = (q ^ 2)⁻¹ ^ r * iteratedDeriv r (fun z => (φ z : ℂ)) (x / q ^ 2) from (by simpa [Function.comp_def, smul_eq_mul, div_eq_inv_mul] using hcomp),
