private noncomputable def cutoffI (Y : ℝ) : ℝ := 1 - Real.smoothTransition (16 * Y - 1)
private noncomputable def cutoffII (Y : ℝ) : ℝ := Real.smoothTransition ((Y - 2) / 2)
private noncomputable def cutoffC (Y : ℝ) : ℝ := 1 - cutoffI Y - cutoffII Y
private noncomputable def bumpCompact (Y : ℝ) : ℝ := 1 - Real.smoothTransition (Y - 1)
private lemma cutoff_sum (Y : ℝ) : cutoffI Y + cutoffC Y + cutoffII Y = 1 := by unfold cutoffC; ring
private lemma cutoffI_contDiff : ContDiff ℝ (⊤ : ℕ∞) cutoffI := contDiff_const.sub (Real.smoothTransition.contDiff.comp ((contDiff_const.mul contDiff_id).sub contDiff_const))
private lemma cutoffII_contDiff : ContDiff ℝ (⊤ : ℕ∞) cutoffII := Real.smoothTransition.contDiff.comp ((contDiff_id.sub contDiff_const).div_const 2)
private lemma cutoffC_contDiff : ContDiff ℝ (⊤ : ℕ∞) cutoffC := (contDiff_const.sub cutoffI_contDiff).sub cutoffII_contDiff
private lemma bumpCompact_contDiff : ContDiff ℝ (⊤ : ℕ∞) bumpCompact := contDiff_const.sub (Real.smoothTransition.contDiff.comp (contDiff_id.sub contDiff_const))
private lemma cutoffI_eq_one {Y : ℝ} (h : Y ≤ 1 / 16) : cutoffI Y = 1 := by rw [cutoffI, Real.smoothTransition.zero_of_nonpos (by linarith), sub_zero]
private lemma cutoffI_eq_zero {Y : ℝ} (h : 1 / 8 ≤ Y) : cutoffI Y = 0 := by rw [cutoffI, Real.smoothTransition.one_of_one_le (by linarith), sub_self]
private lemma cutoffII_eq_zero {Y : ℝ} (h : Y ≤ 2) : cutoffII Y = 0 := by rw [cutoffII, Real.smoothTransition.zero_of_nonpos (by linarith)]
private lemma cutoffII_eq_one {Y : ℝ} (h : 4 ≤ Y) : cutoffII Y = 1 := by rw [cutoffII, Real.smoothTransition.one_of_one_le (by linarith)]
private lemma cutoffC_eq_zero_left {Y : ℝ} (h : Y ≤ 1 / 16) : cutoffC Y = 0 := by rw [cutoffC, cutoffI_eq_one h, cutoffII_eq_zero (by linarith)]; ring
private lemma cutoffC_eq_zero_right {Y : ℝ} (h : 4 ≤ Y) : cutoffC Y = 0 := by rw [cutoffC, cutoffI_eq_zero (by linarith), cutoffII_eq_one h]; ring
private lemma bumpCompact_eq_one {Y : ℝ} (h : Y ≤ 1) : bumpCompact Y = 1 := by rw [bumpCompact, Real.smoothTransition.zero_of_nonpos (by linarith), sub_zero]
private lemma bumpCompact_eq_zero {Y : ℝ} (h : 2 ≤ Y) : bumpCompact Y = 0 := by rw [bumpCompact, Real.smoothTransition.one_of_one_le (by linarith), sub_self]
