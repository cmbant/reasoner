  have hS0 : 0 ≤ S := (mul_nonneg (by positivity) (norm_nonneg _)).trans (seed.schwartz_bd 0 (by omega) 0)
  have hM0 : 0 ≤ M := (mul_nonneg (Real.rpow_nonneg (by linarith : 0 ≤ x₀ + 1) _) (norm_nonneg _)).trans (seed.sym_bd 0 (by omega) (x₀ + 1) (by linarith)).1
  refine ⟨hS0, hM0, fun b_raw hcd hbd => ?_⟩
  let φ : ℝ → ℝ := fun x => ψ (x / x₀); have hφ_cd : ContDiff ℝ (⊤ : ℕ∞) φ := hψ_cd.comp (contDiff_id.div_const x₀); have hφ_zero : ∀ x ≤ x₀, φ x = 0 := fun x hx => hψ_lo (x / x₀) ((div_le_one (by linarith)).mpr hx)
