      exact ((Classical.choose_spec (hφ_ex r)).2 (x / q ^ 2)).trans (by dsimp [Kφ]; linarith [Finset.single_le_sum (f := fun i => Classical.choose (hφ_ex i)) (fun i _ => (Classical.choose_spec (hφ_ex i)).1.le) (Finset.mem_range.mpr (by omega : r < N + 1))]))
    (fun r hr => symbolBound_rpow_norm_le hsym (by omega) hx)
  calc x ^ (3 / 2 : ℝ) * ‖_‖ ≤ x ^ (3 / 2 : ℝ) * (2 ^ N * Kφ * (M * x ^ (-(3 / 2 : ℝ)))) := mul_le_mul_of_nonneg_left (hsum_le.trans (by have h2k : (2 : ℝ) ^ k ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) hk; have := mul_nonneg hM (Real.rpow_nonneg hx.le (-(3 / 2 : ℝ))); gcongr)) (Real.rpow_nonneg hx.le _)
