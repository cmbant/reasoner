private lemma integrable_schwartz_mul_poly {g : ℝ → ℂ} {A : ℝ} (hg_cd : Continuous g) (hg_bd : ∀ u : ℝ, (1 + u ^ 2) * ‖g u‖ ≤ A) :
    Integrable g ∧ ∫ u : ℝ, ‖g u‖ ≤ A * π := by
  have hA : 0 ≤ A := (mul_nonneg (by positivity) (norm_nonneg _)).trans (hg_bd 0)
  have hint : Integrable g := (integrable_inv_one_add_sq.const_mul A).mono' hg_cd.aestronglyMeasurable (ae_of_all _ fun u => ((le_div_iff₀ (by positivity : 0 < 1 + u ^ 2)).mpr (by rw [mul_comm]; exact hg_bd u)).trans_eq (div_eq_mul_inv _ _))
  exact ⟨hint, (integral_mono hint.norm (integrable_inv_one_add_sq.const_mul A) fun u => by rw [← div_eq_mul_inv, le_div_iff₀ (by positivity : 0 < 1 + u ^ 2), mul_comm]; exact hg_bd u).trans_eq (by rw [integral_const_mul, integral_univ_inv_one_add_sq])⟩

private lemma int_cexp_mul (q : ℝ) {f : ℝ → ℂ} (hf : Integrable f) : Integrable (fun x : ℝ => f x * Complex.exp (Complex.I * ((q * x : ℝ) : ℂ))) :=
  hf.norm.mono' (hf.aestronglyMeasurable.mul (by fun_prop)) (ae_of_all _ fun x => le_of_eq (by rw [norm_mul, show Complex.I * ((q * x : ℝ) : ℂ) = ((q * x : ℝ) : ℂ) * Complex.I by ring, Complex.norm_exp_ofReal_mul_I, mul_one]))

private lemma fourier_ibp_bound : ∀ (n : ℕ) (u : ℝ → ℂ) (A : ℝ), ContDiff ℝ (n : ℕ) u → (∀ k ≤ n, ∀ x : ℝ, (1 + x ^ 2) * ‖iteratedDeriv k u x‖ ≤ A) →
    ∀ q : ℝ, q ≠ 0 → ‖∫ x : ℝ, u x * Complex.exp (Complex.I * ((q * x : ℝ) : ℂ))‖ ≤ A * π * |q| ^ (-(n : ℝ)) := by
