  have hbr : airyFtilde (fun z : ℂ => (seed.F z.re : ℂ)) (-(q : ℂ)) = (ceK : ℂ) * Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ)) * ∫ u : ℝ, (seed.F u : ℂ) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ)) := by unfold airyFtilde airyFhat airyPhiK ceK; congr 1; { congr 2; push_cast; ring_nf }; congr 1; funext u; simp only [Complex.ofReal_re]; congr 2; push_cast; ring
  have h_add_term : ∀ (f : ℝ → ℂ) (φr : ℝ → ℝ), (∀ x ≤ 0, f x = 0) → Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ)) * ∫ u : ℝ, (f (-u) * Complex.exp (Complex.I * (φr (-u) : ℂ))) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ)) = Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ)) * ∫ x in Ioi (0 : ℝ), f x * Complex.exp (Complex.I * ((φr x - q * x : ℝ) : ℂ)) := fun f φr hz => by
    congr 1; rw [← integral_indicator measurableSet_Ioi, ← integral_neg_eq_self (Set.indicator (Ioi 0) fun x => f x * Complex.exp (Complex.I * ((φr x - q * x : ℝ) : ℂ)))]; congr 1; funext u; by_cases hu : -u ∈ Ioi (0 : ℝ); { rw [Set.indicator_of_mem hu, mul_assoc, ← Complex.exp_add]; congr 2; push_cast; ring }; rw [Set.indicator_of_notMem hu, hz (-u) (not_lt.mp hu), zero_mul, zero_mul]
  have hb0_m : Integrable (fun u : ℝ => b0 (-u) * Complex.exp (Complex.I * ((0 : ℝ) : ℂ))) := by simpa only [Complex.ofReal_zero, mul_zero, Complex.exp_zero, mul_one] using hb0.comp_neg
  have hi1 := int_cexp_mul q hFp_int; have hi2 := int_cexp_mul q hb0_m; have hi3 := int_cexp_mul q (h_mod b1 (fun x : ℝ => (4 / 3 : ℝ) * x ^ (3 / 2 : ℝ)) hb1 (by fun_prop)); have hi4 := int_cexp_mul q (h_mod bm1 (fun x : ℝ => (-1 : ℝ) * (4 / 3 : ℝ) * x ^ (3 / 2 : ℝ)) hbm1 (by fun_prop))
  have hs1 := integral_add ((hi1.add hi2).add hi3) hi4; have hs2 := integral_add (hi1.add hi2) hi3; have hs3 := integral_add hi1 hi2; simp only [Pi.add_apply] at hs1 hs2 hs3
  have h_sum_int : ∫ u : ℝ, (seed.F u : ℂ) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ)) = ((∫ u : ℝ, Fp u * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ))) + ∫ u : ℝ, (b0 (-u) * Complex.exp (Complex.I * ((0 : ℝ) : ℂ))) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ))) + (∫ u : ℝ, (b1 (-u) * Complex.exp (Complex.I * ((4 / 3 : ℝ) * (-u) ^ (3 / 2 : ℝ) : ℝ))) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ))) + ∫ u : ℝ, (bm1 (-u) * Complex.exp (Complex.I * ((-1 : ℝ) * (4 / 3 : ℝ) * (-u) ^ (3 / 2 : ℝ) : ℝ))) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ)) := by
    have h_eq_sum : (fun u : ℝ => (seed.F u : ℂ) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ))) = fun u : ℝ => ((Fp u * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ)) + (b0 (-u) * Complex.exp (Complex.I * ((0 : ℝ) : ℂ))) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ))) + (b1 (-u) * Complex.exp (Complex.I * ((4 / 3 : ℝ) * (-u) ^ (3 / 2 : ℝ) : ℝ))) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ))) + (bm1 (-u) * Complex.exp (Complex.I * ((-1 : ℝ) * (4 / 3 : ℝ) * (-u) ^ (3 / 2 : ℝ) : ℝ))) * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ)) := funext fun u => by rw [hsplit u]; simp only [Complex.ofReal_zero, mul_zero, Complex.exp_zero, mul_one]; ring
    rw [h_eq_sum, hs1, hs2, hs3]
  rw [hbr, mul_assoc (ceK : ℂ)]; congr 1
  rw [h_sum_int, mul_add, mul_add, mul_add, h_add_term b0 (fun _ => 0) hb0_z, h_add_term b1 (fun x : ℝ => (4 / 3 : ℝ) * x ^ (3 / 2 : ℝ)) hb1_z, h_add_term bm1 (fun x : ℝ => (-1 : ℝ) * (4 / 3 : ℝ) * x ^ (3 / 2 : ℝ)) hbm1_z]
  have h0_eq : Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ)) * ∫ x in Ioi (0 : ℝ), b0 x * Complex.exp (Complex.I * ((0 - q * x : ℝ) : ℂ)) = airyPhaseInt 0 q b0 := by unfold airyPhaseInt; simp only [zero_mul]
  have h1_eq : Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ)) * ∫ x in Ioi (0 : ℝ), b1 x * Complex.exp (Complex.I * (((4 / 3 : ℝ) * x ^ (3 / 2 : ℝ) - q * x : ℝ) : ℂ)) = airyPhaseInt 1 q b1 := by unfold airyPhaseInt; simp only [one_mul]
  have hm1_eq : Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ)) * ∫ x in Ioi (0 : ℝ), bm1 x * Complex.exp (Complex.I * (((-1 : ℝ) * (4 / 3 : ℝ) * x ^ (3 / 2 : ℝ) - q * x : ℝ) : ℂ)) = airyPhaseInt (-1) q bm1 := by unfold airyPhaseInt; rfl
  rw [h0_eq, h1_eq, hm1_eq]

private lemma airyFtilde_neg_real {F : ℝ → ℝ} (hF : Integrable (fun u : ℝ => (F u : ℂ))) (q : ℝ) :
    airyFtilde (fun z : ℂ => (F z.re : ℂ)) (q : ℂ) = star (airyFtilde (fun z : ℂ => (F z.re : ℂ)) (-(q : ℂ))) := by
  unfold airyFtilde airyFhat airyPhiK; simp only [Complex.ofReal_re, star_mul, Complex.star_def]
  rw [show starRingEnd ℂ (Complex.exp (-(Complex.I * (-(q : ℂ)) ^ 3 / 12))) = Complex.exp (-(Complex.I * (q : ℂ) ^ 3 / 12)) from by rw [← Complex.exp_conj]; congr 1; simp only [map_neg, map_div₀, map_mul, map_pow, map_ofNat, Complex.conj_I, Complex.conj_ofReal]; ring,
    show starRingEnd ℂ (∫ u : ℝ, (F u : ℂ) * Complex.exp (-(Complex.I * -(q : ℂ) * (u : ℂ)))) = ∫ u : ℝ, (F u : ℂ) * Complex.exp (-(Complex.I * (q : ℂ) * (u : ℂ))) from by rw [← integral_conj]; congr 1; funext u; simp only [map_mul, Complex.conj_ofReal]; congr 1; rw [← Complex.exp_conj]; congr 1; simp only [map_neg, map_mul, Complex.conj_I, Complex.conj_ofReal]; ring, Complex.conj_ofReal]
  have _ := hF; ring

private lemma iteratedDeriv_star_neg {f : ℝ → ℂ} {U : Set ℝ} (hU : IsOpen U) {j : ℕ} (hf : ContDiffOn ℝ (j : ℕ) f U) :
    ContDiffOn ℝ (j : ℕ) (fun t => star (f (-t))) (Neg.neg ⁻¹' U) ∧ ∀ k ≤ j, ∀ v : ℝ, -v ∈ U → iteratedDeriv k (fun t => star (f (-t))) v = (-1 : ℂ) ^ k * star (iteratedDeriv k f (-v)) := by
  refine ⟨((Complex.conjCLE : ℂ →L[ℝ] ℂ).contDiff.of_le (coe_nat_le_infty j)).comp_contDiffOn (hf.comp contDiff_neg.contDiffOn fun _ h => h), fun k => ?_⟩
  induction k with | zero => intro _ v _; simp | succ k ih =>
    intro hk v hv; have hev : iteratedDeriv k (fun t => star (f (-t))) =ᶠ[𝓝 v] fun t => (-1 : ℂ) ^ k * star (iteratedDeriv k f (-t)) := Filter.eventually_of_mem ((continuous_neg.isOpen_preimage U hU).mem_nhds hv) fun t ht => ih (by omega) t ht
    rw [iteratedDeriv_succ, hev.deriv_eq]
    exact ((Complex.conjCLE.hasStrictFDerivAt.hasFDerivAt.comp_hasDerivAt v ((hasDerivAt_iteratedDeriv_of_contDiffOn hU hk hf hv).scomp v (hasDerivAt_neg v))).const_mul ((-1 : ℂ) ^ k)).congr_deriv (by simp; ring) |>.deriv

private lemma iteratedDeriv_scale_open {f : ℝ → ℂ} {c : ℝ} (_hc : 0 < c) {U : Set ℝ} (hU : IsOpen U) {j : ℕ} (hf : ContDiffOn ℝ (j : ℕ) f U) :
    ContDiffOn ℝ (j : ℕ) (fun t => f (c * t)) ((fun t => c * t) ⁻¹' U) ∧ ∀ k ≤ j, ∀ v : ℝ, c * v ∈ U → iteratedDeriv k (fun t => f (c * t)) v = (c : ℂ) ^ k * iteratedDeriv k f (c * v) := by
  refine ⟨hf.comp (contDiff_const.mul contDiff_id).contDiffOn fun _ h => h, fun k => ?_⟩
  induction k with | zero => intro _ v _; simp | succ k ih =>
    intro hk v hv; have hev : iteratedDeriv k (fun t => f (c * t)) =ᶠ[𝓝 v] fun t => (c : ℂ) ^ k * iteratedDeriv k f (c * t) := Filter.eventually_of_mem (((continuous_const.mul continuous_id).isOpen_preimage U hU).mem_nhds hv) fun t ht => ih (by omega) t ht
    rw [iteratedDeriv_succ, hev.deriv_eq]
    exact (((hasDerivAt_iteratedDeriv_of_contDiffOn hU hk hf hv).scomp v ((hasDerivAt_id v).const_mul c)).const_mul ((c : ℂ) ^ k)).congr_deriv (by simp; ring) |>.deriv

private lemma gt1s_three_sum {x₀ : ℝ} (hx₀ : 0 < x₀) :
    ∃ C > 0, ∀ {M' : ℝ} {b0 b1 bm1 : ℝ → ℂ}, 0 ≤ M' → (∀ x < x₀, b0 x = 0 ∧ b1 x = 0 ∧ bm1 x = 0) →
      IsAirySymbolBound 12 b0 M' → IsAirySymbolBound 12 b1 M' → IsAirySymbolBound 12 bm1 M' →
      ContDiffOn ℝ (3 : ℕ) (fun q => airyPhaseInt 0 q b0 + airyPhaseInt 1 q b1 + airyPhaseInt (-1) q bm1) (Ioi 1) ∧
        ∀ k ≤ 3, ∀ q > (1 : ℝ), ‖iteratedDeriv k (fun t => airyPhaseInt 0 t b0 + airyPhaseInt 1 t b1 + airyPhaseInt (-1) t bm1) q‖ ≤ C * M' * q ^ (-(5 / 2 : ℝ) - (k : ℝ)) := by
  let K : ℕ → ℝ := fun k => Classical.choose (gt1s_scalar_airy_symbol_transfer k hx₀ (Or.inl rfl)) + Classical.choose (gt1s_scalar_airy_symbol_transfer k hx₀ (Or.inr (Or.inl rfl))) + Classical.choose (gt1s_scalar_airy_symbol_transfer k hx₀ (Or.inr (Or.inr rfl)))
  let C := ∑ k ∈ Finset.range 4, K k + 1
  have hK0 : ∀ k, 0 ≤ K k := fun k => by dsimp [K]; linarith [(Classical.choose_spec (gt1s_scalar_airy_symbol_transfer k hx₀ (Or.inl rfl))).1, (Classical.choose_spec (gt1s_scalar_airy_symbol_transfer k hx₀ (Or.inr (Or.inl rfl)))).1, (Classical.choose_spec (gt1s_scalar_airy_symbol_transfer k hx₀ (Or.inr (Or.inr rfl)))).1]
  refine ⟨C, add_pos_of_nonneg_of_pos (Finset.sum_nonneg fun k _ => hK0 k) one_pos, fun {M'} {b0 b1 bm1} hM' hsupp hb0 hb1 hbm1 => ?_⟩
  have hsub : ∀ {N} {b : ℝ → ℂ}, N ≤ 12 → IsAirySymbolBound 12 b M' → IsAirySymbolBound N b M' := fun {N b} hN hb => ⟨hb.1.of_le (by exact_mod_cast (by omega : N + 1 ≤ 13)), fun r hr => hb.2 r (hr.trans hN)⟩
  have hterm : ∀ (σ : ℝ) (hσ : σ ∈ ({-1, 0, 1} : Set ℝ)) {b : ℝ → ℂ}, (∀ x < x₀, b x = 0) → IsAirySymbolBound 12 b M' → ∀ k ≤ 3, ContDiffOn ℝ (k : ℕ) (fun q => airyPhaseInt σ q b) (Ioi 1) ∧ ∀ q > (1 : ℝ), ‖iteratedDeriv k (fun t => airyPhaseInt σ t b) q‖ ≤ Classical.choose (gt1s_scalar_airy_symbol_transfer k hx₀ hσ) * M' * q ^ (-(5 / 2 : ℝ) - (k : ℝ)) := fun σ hσ b hb_s hb k _ =>
    let ⟨hcd, hbd⟩ := (Classical.choose_spec (gt1s_scalar_airy_symbol_transfer k hx₀ hσ)).2 le_rfl hM' hb_s (hsub (by omega) hb); ⟨hcd.mono Ioi_subset_Ici_self, fun q hq => hbd q hq.le⟩
  obtain ⟨c0, _⟩ := hterm 0 (Or.inr (Or.inl rfl)) (fun x hx => (hsupp x hx).1) hb0 3 le_rfl; obtain ⟨c1, _⟩ := hterm 1 (Or.inr (Or.inr rfl)) (fun x hx => (hsupp x hx).2.1) hb1 3 le_rfl; obtain ⟨c2, _⟩ := hterm (-1) (Or.inl rfl) (fun x hx => (hsupp x hx).2.2) hbm1 3 le_rfl
  refine ⟨(c0.add c1).add c2, fun k hk q hq => ?_⟩
  have hAt : ∀ {g : ℝ → ℂ}, ContDiffOn ℝ (3 : ℕ) g (Ioi 1) → ContDiffAt ℝ (k : ℕ) g q := fun hg => (hg.of_le (by exact_mod_cast hk)).contDiffAt (isOpen_Ioi.mem_nhds hq)
  rw [iteratedDeriv_fun_add ((hAt c0).add (hAt c1)) (hAt c2), iteratedDeriv_fun_add (hAt c0) (hAt c1)]
  have d0 := (hterm 0 (Or.inr (Or.inl rfl)) (fun x hx => (hsupp x hx).1) hb0 k hk).2 q hq; have d1 := (hterm 1 (Or.inr (Or.inr rfl)) (fun x hx => (hsupp x hx).2.1) hb1 k hk).2 q hq; have d2 := (hterm (-1) (Or.inl rfl) (fun x hx => (hsupp x hx).2.2) hbm1 k hk).2 q hq
  have hKC : K k ≤ C := by dsimp [C]; linarith [Finset.single_le_sum (f := K) (fun r _ => hK0 r) (Finset.mem_range.mpr (by omega : k < 4))]
  exact (norm_add_le _ _).trans ((add_le_add (norm_add_le _ _) le_rfl).trans (((add_le_add (add_le_add d0 d1) d2).trans_eq (by dsimp [K]; ring)).trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hKC hM') (Real.rpow_nonneg (by linarith) _))))

/-- High-frequency real-axis Airy symbol transfer (`|v| ≥ 1`, `0 ≤ j ≤ 3`, uniform in `δ₀ ∈ [0, 2]`). -/
theorem gt1_high_freq (m j : ℕ) (hm : 3 ≤ m) (hj : j ≤ 3) {x₀ : ℝ} (hx₀ : 1 ≤ x₀) (χ : AiryCutoff) :
    ∃ C > 0, ∀ {S M δ₀ : ℝ} (seed : AiryTailSymbolSeed x₀ χ S M), δ₀ ∈ Icc 0 2 →
      let W := airyWeightedSymbol δ₀ m seed.F
      ContDiffOn ℝ (j : ℕ) W (Ici 1) ∧ ContDiffOn ℝ (j : ℕ) W (Iic (-1)) ∧ ∀ v : ℝ, 1 ≤ |v| → ‖iteratedDeriv j W v‖ ≤ C * (S + M) * |v| ^ (-(5 / 2 : ℝ) - (j : ℝ)) := by
  obtain ⟨C_spl, hC_spl, hspl⟩ := bsplineImag_uniform_bounds m hm; obtain ⟨K_tail, hK_tail, htail_bd⟩ := seed_bTilde_symbolBound hx₀ χ; obtain ⟨C_schw, hC_schw, hschw⟩ := schwartz_fourier_bounds; obtain ⟨C_tr, hC_tr, htr⟩ := gt1s_three_sum (by linarith : 0 < x₀)
  let C_F := ceCs ^ 3 * ceK * max C_schw (C_tr * K_tail); have hC_F : 0 < C_F := mul_pos (mul_pos (pow_pos ceCs_pos 3) ceK_pos) (lt_max_of_lt_left hC_schw); refine ⟨8 * C_spl * C_F + 1, by positivity, fun {S M δ₀} seed hδ => ?_⟩; obtain ⟨hS0, hM0, htb⟩ := htail_bd seed
  let Fp : ℝ → ℂ := fun u => (seed.F u : ℂ) * (χ.val (u / x₀) : ℂ); let b0 := fun x => seed.b₀ x * ((1 - χ.val (-x / x₀) : ℝ) : ℂ); let b1 := fun x => seed.bPos x * ((1 - χ.val (-x / x₀) : ℝ) : ℂ); let bm1 := fun x => seed.bNeg x * ((1 - χ.val (-x / x₀) : ℝ) : ℂ)
  obtain ⟨hb0_supp, hb0_sym⟩ := htb seed.b₀ seed.sym_cd.1 (fun k hk x hx => (seed.sym_bd k hk x hx).1); obtain ⟨hb1_supp, hb1_sym⟩ := htb seed.bPos seed.sym_cd.2.1 (fun k hk x hx => (seed.sym_bd k hk x hx).2.1); obtain ⟨hbm1_supp, hbm1_sym⟩ := htb seed.bNeg seed.sym_cd.2.2 (fun k hk x hx => (seed.sym_bd k hk x hx).2.2); obtain ⟨hschw_cd, hschw_bd⟩ := hschw seed.schwartz_cd seed.schwartz_bd; obtain ⟨hF_int, hF_eq⟩ := airyFtilde_decomp hx₀ seed hM0
  let R : ℝ → ℂ := fun q => Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ)) * (∫ u : ℝ, Fp u * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ))) + airyPhaseInt 0 q b0 + airyPhaseInt 1 q b1 + airyPhaseInt (-1) q bm1
  obtain ⟨htr_cd, htr_bd⟩ := htr (mul_nonneg hK_tail.le hM0) (fun x hx => ⟨hb0_supp x hx, hb1_supp x hx, hbm1_supp x hx⟩) hb0_sym hb1_sym hbm1_sym
  have hR_eq : R = fun q => (Complex.exp (Complex.I * ((q ^ 3 / 12 : ℝ) : ℂ)) * (∫ u : ℝ, Fp u * Complex.exp (Complex.I * ((q * u : ℝ) : ℂ)))) + (airyPhaseInt 0 q b0 + airyPhaseInt 1 q b1 + airyPhaseInt (-1) q bm1) := funext fun q => by dsimp [R]; ring
  have hR_cd : ContDiffOn ℝ (3 : ℕ) R (Ioi 1) := hR_eq ▸ (hschw_cd.contDiffOn.mono (subset_univ (Ioi 1))).add htr_cd
  let G : ℝ → ℂ := fun v => airyFtilde (fun z : ℂ => (seed.F z.re : ℂ)) (-(ceCs * v : ℂ)); have hG_eq_pos : ∀ v : ℝ, G v = (ceK : ℂ) * R (ceCs * v) := fun v => by simpa only [G, R, Fp, b0, b1, bm1, Complex.ofReal_mul] using hF_eq (ceCs * v)
  obtain ⟨hG_cd_pos, hG_sc⟩ := iteratedDeriv_scale_open ceCs_pos isOpen_Ioi hR_cd
  have hG_cd_p : ContDiffOn ℝ (3 : ℕ) G (Ioi (1 / ceCs)) := ((contDiffOn_const.mul hG_cd_pos).congr (fun v _ => hG_eq_pos v)).mono (by rw [(by ext v; simp only [mem_Ioi, mem_preimage, div_lt_iff₀ ceCs_pos, mul_comm v ceCs] : Ioi (1 / ceCs) = (fun t => ceCs * t) ⁻¹' Ioi 1)])
  have hG_bd_pos : ∀ k ≤ 3, ∀ v ≥ (1 : ℝ), ‖iteratedDeriv k G v‖ ≤ C_F * (S + M) * v ^ (-(5 / 2 : ℝ) - (k : ℝ)) := fun k hk v hv => by
    have hv_in : ceCs * v ∈ Ioi 1 := (by simp only [mem_Ioi]; nlinarith [one_lt_ceCs, hv]); have hv0 : 0 < v := by linarith
    rw [show G = fun t => (ceK : ℂ) * R (ceCs * t) from funext hG_eq_pos, iteratedDeriv_const_mul_field (ceK : ℂ), hG_sc k hk v hv_in, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ceK_pos, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ceCs_pos]
    have hschw_q := hschw_bd k hk (ceCs * v); rw [abs_of_pos (mul_pos ceCs_pos hv0)] at hschw_q; split_ifs at hschw_q; swap; · exact absurd (mem_Ioi.mp hv_in).le ‹_›
    have hpow_v : (ceCs * v) ^ (-(5 / 2 : ℝ) - (k : ℝ)) ≤ v ^ (-(5 / 2 : ℝ) - (k : ℝ)) := Real.rpow_le_rpow_of_nonpos hv0 (by nlinarith [one_lt_ceCs]) (by linarith [show (0 : ℝ) ≤ k from Nat.cast_nonneg k])
    have hR_bd : ‖iteratedDeriv k R (ceCs * v)‖ ≤ C_schw * S * v ^ (-(5 / 2 : ℝ) - (k : ℝ)) + C_tr * (K_tail * M) * v ^ (-(5 / 2 : ℝ) - (k : ℝ)) := by rw [hR_eq, iteratedDeriv_fun_add ((hschw_cd.of_le (by exact_mod_cast hk)).contDiffAt) ((htr_cd.of_le (by exact_mod_cast hk)).contDiffAt (isOpen_Ioi.mem_nhds hv_in))]; exact (norm_add_le _ _).trans (add_le_add (hschw_q.trans (mul_le_mul_of_nonneg_left hpow_v (mul_nonneg hC_schw.le hS0))) ((htr_bd k hk (ceCs * v) (mem_Ioi.mp hv_in)).trans (mul_le_mul_of_nonneg_left hpow_v (mul_nonneg hC_tr.le (mul_nonneg hK_tail.le hM0)))))
    have hm_le : C_schw * S + C_tr * (K_tail * M) ≤ max C_schw (C_tr * K_tail) * (S + M) := by nlinarith [le_max_left C_schw (C_tr * K_tail), le_max_right C_schw (C_tr * K_tail), hS0, hM0]
    exact (mul_le_mul_of_nonneg_left (mul_le_mul (pow_le_pow_right₀ one_lt_ceCs.le hk) hR_bd (norm_nonneg _) (pow_nonneg ceCs_pos.le 3)) ceK_pos.le).trans ((by ring : ceK * (ceCs ^ 3 * (C_schw * S * v ^ (-(5 / 2 : ℝ) - (k : ℝ)) + C_tr * (K_tail * M) * v ^ (-(5 / 2 : ℝ) - (k : ℝ)))) = ceCs ^ 3 * ceK * (C_schw * S + C_tr * (K_tail * M)) * v ^ (-(5 / 2 : ℝ) - (k : ℝ))).le.trans (by dsimp [C_F]; rw [mul_assoc (ceCs ^ 3 * ceK) _ (S + M)]; exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hm_le (mul_nonneg (pow_nonneg ceCs_pos.le 3) ceK_pos.le)) (Real.rpow_nonneg hv0.le _)))
