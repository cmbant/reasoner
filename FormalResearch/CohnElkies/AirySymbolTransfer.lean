  rcases lt_or_ge x₀ x with hx_gt | hx_le
  · have hmul := xpow_iteratedDeriv_mul_bound isOpen_Ioi (hcd.mono Ioi_subset_Ici_self |>.of_le (by exact_mod_cast (by omega : k ≤ 13))) ((Complex.ofRealCLM.contDiff.comp hφ_cd).contDiffOn.of_le (coe_nat_le_infty k)) (M * x ^ (-(3 / 2 : ℝ))) Kψ (mul_nonneg hM0 (Real.rpow_nonneg hx.le _)) hx_gt
      (fun r hr => by rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hx, Real.rpow_neg hx.le, ← div_eq_mul_inv, le_div_iff₀ (Real.rpow_pos_of_pos hx _), show x ^ r * ‖iteratedDeriv r b_raw x‖ * x ^ (3 / 2 : ℝ) = x ^ ((3 / 2 : ℝ) + r) * ‖iteratedDeriv r b_raw x‖ from (by rw [Real.rpow_add hx, Real.rpow_natCast]; ring)]; exact hbd r (hr.trans hk) x hx_gt)
      fun r _ => by
        rw [show (⇑Complex.ofRealCLM ∘ φ) = fun t => (Complex.ofRealCLM ∘ ψ) (x₀⁻¹ * t) from funext fun t => by simp [φ, div_eq_inv_mul], show iteratedDeriv r (fun t => (Complex.ofRealCLM ∘ ψ) (x₀⁻¹ * t)) x = (x₀⁻¹ : ℂ) ^ r * iteratedDeriv r (fun z => (ψ z : ℂ)) (x / x₀) from by simpa [Function.comp_def, smul_eq_mul, div_eq_inv_mul, Complex.real_smul] using congrFun (iteratedDeriv_comp_const_smul (n := r) ((Complex.ofRealCLM.contDiff.comp hψ_cd).of_le (coe_nat_le_infty r)) x₀⁻¹) x, show (x : ℂ) ^ r * ((x₀⁻¹ : ℂ) ^ r * iteratedDeriv r (fun z => (ψ z : ℂ)) (x / x₀)) = ((x / x₀ : ℝ) : ℂ) ^ r * iteratedDeriv r (fun z => (ψ z : ℂ)) (x / x₀) from (by push_cast; ring)]
