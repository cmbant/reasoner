    have hAc : ContinuousOn A (Icc c' d') := continuousOn_const.mul (continuousOn_const.mul (continuousOn_id.rpow_const fun x hx => Or.inl (by linarith [hc_inf, hulo, hlc, hx.1] : (0 : ℝ) < x).ne'))
