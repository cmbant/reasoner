  obtain ⟨C_ibp, hC_ibp, hibp⟩ := step1_ibp_bound 4 C_θ hCθ; obtain ⟨K_b, hK_b, hsym_b⟩ := isAirySymbolBoundCore_mul_const_tails 4 bumpCompact_contDiff (fun y hy => by rw [bumpCompact_eq_one hy, bumpCompact_eq_one le_rfl]) (fun y hy => by rw [bumpCompact_eq_zero hy, bumpCompact_eq_zero le_rfl])
  let hp := fun r k : ℕ => phasePoly_deriv_bound_univ r k; let KP_all := ∑ k ∈ Finset.range 4, ∑ r ∈ Finset.range 5, Classical.choose (hp r k) + 1
  have hKP_pos : 0 < KP_all := add_pos_of_nonneg_of_pos (Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => (Classical.choose_spec (hp _ _)).1.le) one_pos; let K_mul := 2 ^ 4 * KP_all; let C := C_ibp * K_mul * (1 + Q_max ^ 2) ^ 3 * K_b + 1
  refine ⟨C, by positivity, fun {q_lo q_hi c_inf c₁ θ_min M B_int} {a} hq_lh hc_inf hcc1 hc1_1 hθ_pos hM hB hq_bd hθ ha_lo ha_sym hint_bd => ?_⟩
  obtain ⟨hbn_sym, _, hbn_hi, hFn_cd, hpt_lim, hsub_it⟩ := airyPhaseInt_cutoff_approx (σ := σ) 4 (by linarith : 0 < c₁) hM hK_b hsym_b (fun x hx => ha_lo x hx.le) (isAirySymbolBound_to_core ha_sym)
  let b_n : ℕ → ℝ → ℂ := fun n x => (bumpCompact (x / (n + 1 : ℝ)) : ℂ) * a x; let F_n : ℕ → ℝ → ℂ := fun n q => airyPhaseInt σ q (b_n n); have hbn_lo : ∀ n x, x ≤ c₁ → b_n n x = 0 := fun n x hx => by dsimp [b_n]; rw [ha_lo x hx, mul_zero]
  have hpiece : ∀ {k : ℕ} (hk : k ≤ 3) {q u_lo c' d' M_e : ℝ} {e : ℝ → ℂ}, q ∈ Ioo q_lo q_hi → c_inf ≤ u_lo → u_lo < c' → c' < d' → 0 ≤ M_e → (∀ x, x ≤ c' ∨ d' ≤ x → e x = 0) → IsAirySymbolBoundCore 4 e M_e → ‖iteratedDeriv k (fun s => airyPhaseInt σ s e) q‖ ≤ C_ibp * K_mul * (1 + Q_max ^ 2) ^ 3 * M_e * ∫ x in Ioo c' d', x ^ ((k : ℝ) - 3 / 2) * (x * |2 * σ * Real.sqrt x - q|) ^ (-(4 : ℝ)) := fun {k} hk {q u_lo c' d' M_e} {e} hq hulo hlc hcd hMe he_supp he_sym => by
