  | zero => intro u A hu hbd q _; obtain ⟨hint, hi⟩ := integrable_schwartz_mul_poly hu.continuous (fun x => by simpa using hbd 0 le_rfl x); exact ((norm_integral_le_integral_norm _).trans ((integral_mono (int_cexp_mul q hint).norm hint.norm fun x => le_of_eq (by rw [norm_mul, show Complex.I * ((q * x : ℝ) : ℂ) = ((q * x : ℝ) : ℂ) * Complex.I by ring, Complex.norm_exp_ofReal_mul_I, mul_one])).trans hi)).trans_eq (by simp)
  | succ n ih =>
    intro u A hu hbd q hq; let v : ℝ → ℂ := fun x => (Complex.I * (q : ℂ))⁻¹ * Complex.exp (Complex.I * ((q * x : ℝ) : ℂ)); let v' : ℝ → ℂ := fun x => Complex.exp (Complex.I * ((q * x : ℝ) : ℂ))
    have hdu_int := (integrable_schwartz_mul_poly (by simpa only [iteratedDeriv_one] using hu.continuous_iteratedDeriv 1 (by norm_cast; omega)) (fun x => by simpa [iteratedDeriv_one] using hbd 1 (by omega) x)).1
    have hu' : Integrable (fun x => _root_.deriv u x * v x) := (int_cexp_mul q hdu_int).const_mul (Complex.I * (q : ℂ))⁻¹ |>.congr (ae_of_all _ fun x => by dsimp [v]; ring)
