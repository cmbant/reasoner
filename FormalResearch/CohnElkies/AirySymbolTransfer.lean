private def evalMonomList (L : List (ℕ × ℕ × ℂ)) (q x : ℝ) : ℂ := (L.map fun t => t.2.2 * (q : ℂ) ^ t.1 * (x : ℂ) ^ t.2.1).sum
private noncomputable def phasePolyList : ℕ → List (ℕ × ℕ × ℂ)
  | 0 => [(0, 0, 1)]
  | j + 1 => (phasePolyList j).map (fun t => (t.1 - 1, t.2.1, (t.1 : ℂ) * t.2.2)) ++ (phasePolyList j).map (fun t => (t.1 + 2, t.2.1, (Complex.I / 4) * t.2.2)) ++ (phasePolyList j).map (fun t => (t.1, t.2.1 + 1, (-Complex.I) * t.2.2))
private noncomputable def phasePoly (j : ℕ) (q x : ℝ) : ℂ := evalMonomList (phasePolyList j) q x
private lemma phasePolyList_deg : ∀ j t, t ∈ phasePolyList j → t.1 + 2 * t.2.1 ≤ 2 * j := fun j => by
  induction j with | zero => intro t h; simp only [phasePolyList, List.mem_singleton] at h; subst h; dsimp; omega | succ j ih => intro t ht; simp only [phasePolyList, List.mem_append, List.mem_map] at ht; rcases ht with (⟨s, hs, rfl⟩ | ⟨s, hs, rfl⟩) | ⟨s, hs, rfl⟩ <;> have := ih s hs <;> dsimp <;> omega
private lemma contDiff_evalMonomList (L : List (ℕ × ℕ × ℂ)) (q : ℝ) : ContDiff ℝ (⊤ : ℕ∞) (fun x => evalMonomList L q x) := by
  induction L with | nil => simpa [evalMonomList] using contDiff_const | cons a L ih => simpa [evalMonomList, List.map_cons, List.sum_cons] using (contDiff_const.mul (Complex.ofRealCLM.contDiff.pow a.2.1)).add ih
private lemma phasePoly_hasDerivAt_q (j : ℕ) (σ q x : ℝ) :
    HasDerivAt (fun s => phasePoly j s x * Complex.exp (Complex.I * (airyPhase σ s x : ℝ))) (phasePoly (j + 1) q x * Complex.exp (Complex.I * (airyPhase σ q x : ℝ))) q := by
  have hP : ∀ L : List (ℕ × ℕ × ℂ), HasDerivAt (fun s => evalMonomList L s x) (evalMonomList (L.map fun t => (t.1 - 1, t.2.1, (t.1 : ℂ) * t.2.2)) q x) q := fun L => by
    induction L with | nil => simp [evalMonomList, hasDerivAt_const] | cons t L ih => simp only [evalMonomList, List.map_cons, List.sum_cons]; exact (((hasDerivAt_ofReal_pow t.1 q).const_mul t.2.2).mul_const ((x : ℂ) ^ t.2.1) |>.congr_deriv (by ring)).add ih
  have hθ : HasDerivAt (fun s => Complex.I * (airyPhase σ s x : ℝ)) (Complex.I * ((q ^ 2 / 4 - x : ℝ) : ℂ)) q :=
    ((((hasDerivAt_pow 3 q).div_const 12).add_const (σ * (4 / 3 : ℝ) * x ^ (3 / 2 : ℝ))).sub ((hasDerivAt_id q).mul_const x) |>.congr_deriv (by ring)).ofReal_comp.const_mul Complex.I
  have hm1 : ∀ L : List (ℕ × ℕ × ℂ), (Complex.I / 4) * (q : ℂ) ^ 2 * evalMonomList L q x = evalMonomList (L.map fun t => (t.1 + 2, t.2.1, (Complex.I / 4) * t.2.2)) q x := fun L => by
    induction L with | nil => simp [evalMonomList] | cons t L ih => simp only [evalMonomList, List.map_cons, List.sum_cons, mul_add] at ih ⊢; rw [← ih, pow_add]; ring
  have hm2 : ∀ L : List (ℕ × ℕ × ℂ), (-Complex.I * (x : ℂ)) * evalMonomList L q x = evalMonomList (L.map fun t => (t.1, t.2.1 + 1, (-Complex.I) * t.2.2)) q x := fun L => by
    induction L with | nil => simp [evalMonomList] | cons t L ih => simp only [evalMonomList, List.map_cons, List.sum_cons, mul_add] at ih ⊢; rw [← ih, pow_succ]; ring
  refine ((hP (phasePolyList j)).mul hθ.cexp).congr_deriv ?_; dsimp only [phasePoly, phasePolyList]
  have happ : ∀ L₁ L₂, evalMonomList (L₁ ++ L₂) q x = evalMonomList L₁ q x + evalMonomList L₂ q x := fun _ _ => by simp [evalMonomList]
  simp only [happ, ← hm1, ← hm2]; push_cast; ring
private lemma phasePoly_monom_xpow_bound (k r : ℕ) (P : ℝ → ℝ → Prop) (B : ℝ → ℝ → ℝ) (hB_nn : ∀ {q x}, P q x → 0 ≤ B q x)
    (hmon : ∀ t ∈ phasePolyList r, ∀ {q x}, P q x → 0 < x ∧ |q| ^ t.1 * x ^ t.2.1 ≤ B q x) :
    ∃ C > 0, ∀ {q x : ℝ}, P q x → ‖(x : ℂ) ^ k * iteratedDeriv k (fun t => phasePoly r q t) x‖ ≤ C * B q x := by
  have hp_ofReal : ∀ (k' m : ℕ) (y : ℝ), iteratedDeriv k' (fun s : ℝ => (s : ℂ) ^ m) y = (m.descFactorial k' : ℂ) * (y : ℂ) ^ (m - k') := fun k' => by induction k' with | zero => intro m y; simp | succ k' ih => intro m y; rw [iteratedDeriv_succ, funext (ih m), ((hasDerivAt_ofReal_pow (m - k') y).const_mul (m.descFactorial k' : ℂ)).deriv]; rcases le_or_gt k' m with hkm | hkm; { rw [Nat.descFactorial_succ, Nat.sub_add_eq]; push_cast; ring }; simp [Nat.descFactorial_eq_zero_iff_lt.mpr hkm]
  have hL : ∀ L : List (ℕ × ℕ × ℂ), (∀ t ∈ L, ∀ {q x}, P q x → 0 < x ∧ |q| ^ t.1 * x ^ t.2.1 ≤ B q x) → ∃ C > 0, ∀ {q x : ℝ}, P q x → ‖(x : ℂ) ^ k * iteratedDeriv k (fun s => evalMonomList L q s) x‖ ≤ C * B q x := fun L => by
    induction L with
    | nil => intro _; exact ⟨1, one_pos, fun {q x} hP => by simp [evalMonomList]; exact hB_nn hP⟩
    | cons t L ih =>
      intro hmonL; obtain ⟨C', hC', hCL⟩ := ih fun s hs {q x} hP => hmonL s (List.mem_cons_of_mem _ hs) hP; let ct := ‖t.2.2‖ * (t.2.1.descFactorial k : ℝ)
      refine ⟨ct + C', by linarith [hC', show 0 ≤ ct from mul_nonneg (norm_nonneg _) (Nat.cast_nonneg _)], fun {q x} hP => ?_⟩
      have hcd1 : ContDiffAt ℝ (k : ℕ) (fun s : ℝ => t.2.2 * (q : ℂ) ^ t.1 * (s : ℂ) ^ t.2.1) x := ((contDiff_const.mul (Complex.ofRealCLM.contDiff.pow t.2.1)).of_le (coe_nat_le_infty k)).contDiffAt; have hcd2 : ContDiffAt ℝ (k : ℕ) (fun s : ℝ => evalMonomList L q s) x := ((contDiff_evalMonomList L q).of_le (coe_nat_le_infty k)).contDiffAt
      rw [show (fun s : ℝ => evalMonomList (t :: L) q s) = fun s : ℝ => t.2.2 * (q : ℂ) ^ t.1 * (s : ℂ) ^ t.2.1 + evalMonomList L q s from funext fun s => by simp [evalMonomList], iteratedDeriv_fun_add hcd1 hcd2, mul_add]
      have hterm : ‖(x : ℂ) ^ k * iteratedDeriv k (fun s : ℝ => t.2.2 * (q : ℂ) ^ t.1 * (s : ℂ) ^ t.2.1) x‖ ≤ ct * B q x := by
        rw [iteratedDeriv_const_mul_field, hp_ofReal]; obtain ⟨hx, hbx⟩ := hmonL t List.mem_cons_self hP; by_cases hkm : k ≤ t.2.1
        · have hct0 : 0 ≤ ct := mul_nonneg (norm_nonneg _) (Nat.cast_nonneg _)
          rw [show (x : ℂ) ^ k * (t.2.2 * (q : ℂ) ^ t.1 * ((t.2.1.descFactorial k : ℂ) * (x : ℂ) ^ (t.2.1 - k))) = t.2.2 * (t.2.1.descFactorial k : ℂ) * ((q : ℂ) ^ t.1 * ((x : ℂ) ^ k * (x : ℂ) ^ (t.2.1 - k))) by ring, ← pow_add, Nat.add_sub_of_le hkm]; simp only [norm_mul, norm_pow, Complex.norm_real, Complex.norm_natCast, Real.norm_eq_abs, abs_of_pos hx]; exact (mul_le_mul_of_nonneg_left hbx hct0).trans_eq (by dsimp only [ct])
        · simp [Nat.descFactorial_eq_zero_iff_lt.mpr (by omega : t.2.1 < k)]; exact mul_nonneg (mul_nonneg (norm_nonneg _) (Nat.cast_nonneg _)) (hB_nn hP)
      exact (norm_add_le _ _).trans ((add_le_add hterm (hCL hP)).trans_eq (by ring))
  exact hL (phasePolyList r) hmon
private lemma phasePoly_xpow_deriv_bound (k r : ℕ) :
    ∃ C > 0, ∀ {q x : ℝ}, 1 / 2 ≤ q → 0 < x → ‖(x : ℂ) ^ k * iteratedDeriv k (fun t => phasePoly r q t) x‖ ≤ C * (q ^ 2 + x) ^ r := by
  obtain ⟨C, hC, h⟩ := phasePoly_monom_xpow_bound k r (fun q x => 1 / 2 ≤ q ∧ 0 < x) (fun q x => (4 : ℝ) ^ r * (q ^ 2 + x) ^ r) (fun {q x} hP => mul_nonneg (by positivity) (pow_nonneg (add_nonneg (sq_nonneg q) hP.2.le) r)) fun t ht {q x} hP => by
    have htd := phasePolyList_deg r t ht; have hx0 : 0 < x := hP.2; have hqx0 : 0 ≤ q ^ 2 + x := add_nonneg (sq_nonneg q) hx0.le
    refine ⟨hx0, ?_⟩; rw [abs_of_pos (by linarith [hP.1] : 0 < q)]
    have hq_le : q ^ t.1 ≤ (4 * q ^ 2) ^ (r - t.2.1) := by rcases le_or_gt 1 q with h1 | h1; { exact (pow_le_pow_right₀ h1 (by omega : t.1 ≤ 2 * (r - t.2.1))).trans ((by rw [← pow_mul, mul_comm] : q ^ (2 * (r - t.2.1)) = (q ^ 2) ^ (r - t.2.1)) ▸ pow_le_pow_left₀ (by positivity) (by linarith [sq_nonneg q]) _) }; exact (pow_le_one₀ (by linarith [hP.1]) h1.le).trans (one_le_pow₀ (n := r - t.2.1) (by nlinarith [hP.1]))
    have ha : (4 * q ^ 2) ^ (r - t.2.1) ≤ (4 * (q ^ 2 + x)) ^ (r - t.2.1) := pow_le_pow_left₀ (by positivity) (by linarith) _; have hb : x ^ t.2.1 ≤ (q ^ 2 + x) ^ t.2.1 := pow_le_pow_left₀ hx0.le (le_add_of_nonneg_left (sq_nonneg q)) _; have hc : (4 : ℝ) ^ (r - t.2.1) ≤ 4 ^ r := pow_le_pow_right₀ (by norm_num) (Nat.sub_le r t.2.1)
    exact (mul_le_mul hq_le le_rfl (pow_nonneg hx0.le _) (by positivity)).trans ((mul_le_mul ha hb (pow_nonneg hx0.le _) (pow_nonneg (mul_nonneg (by norm_num) hqx0) _)).trans ((by rw [mul_pow, mul_assoc, ← pow_add, Nat.sub_add_cancel (by omega)] : (4 * (q ^ 2 + x)) ^ (r - t.2.1) * (q ^ 2 + x) ^ t.2.1 = (4 : ℝ) ^ (r - t.2.1) * (q ^ 2 + x) ^ r).le.trans (mul_le_mul_of_nonneg_right hc (pow_nonneg hqx0 r))))
  exact ⟨C * 4 ^ r, by positivity, fun hq hx => (h ⟨hq, hx⟩).trans_eq (by ring)⟩
private lemma phasePoly_deriv_bound_univ (k r : ℕ) :
    ∃ C > 0, ∀ {q x : ℝ}, 1 / 2 ≤ x → ‖(x : ℂ) ^ k * iteratedDeriv k (fun t => phasePoly r q t) x‖ ≤ C * (1 + q ^ 2) ^ r * x ^ r := by
  obtain ⟨C, hC, h⟩ := phasePoly_monom_xpow_bound k r (fun _ x => 1 / 2 ≤ x) (fun q x => (2 : ℝ) ^ r * ((1 + q ^ 2) ^ r * x ^ r)) (fun {q x} hx => mul_nonneg (by positivity) (mul_nonneg (by positivity) (pow_nonneg (by linarith) r))) fun t ht {q x} hx => by
    have htd := phasePolyList_deg r t ht; have hx0 : 0 < x := by linarith
    have hq_b : |q| ^ t.1 ≤ (1 + q ^ 2) ^ r := by rcases le_or_gt |q| 1 with h1 | h1; { exact (pow_le_one₀ (abs_nonneg _) h1).trans (one_le_pow₀ (n := r) (by linarith [sq_nonneg q])) }; exact (pow_le_pow_right₀ h1.le (by omega : t.1 ≤ 2 * r)).trans ((by rw [pow_mul, sq_abs] : |q| ^ (2 * r) = (q ^ 2) ^ r) ▸ pow_le_pow_left₀ (sq_nonneg q) (by linarith) r)
    have hx_b : x ^ t.2.1 ≤ (2 * x) ^ r := (pow_le_pow_left₀ hx0.le (by linarith : x ≤ 2 * x) _).trans (pow_le_pow_right₀ (by linarith) (by omega : t.2.1 ≤ r))
    exact ⟨hx0, (mul_le_mul hq_b hx_b (pow_nonneg hx0.le _) (by positivity)).trans_eq (by rw [mul_pow]; ring)⟩
  exact ⟨C * 2 ^ r, by positivity, fun hx => (h hx).trans_eq (by ring)⟩

private noncomputable def fInvTheta (σ q : ℝ) (m : ℕ) (x : ℝ) : ℂ := ((2 * σ * Real.sqrt x - q : ℝ) : ℂ)⁻¹ * ((σ * Real.sqrt x / (2 * σ * Real.sqrt x - q) : ℝ) : ℂ) ^ m
private lemma fInvTheta_bound_euler (C_θ : ℝ) (hCθ_nn : 0 ≤ C_θ) : ∀ (k m : ℕ), ∃ C > 0, ∀ {σ q : ℝ} {U : Set ℝ}, IsOpen U → (∀ y ∈ U, 0 < y) → (∀ y ∈ U, 2 * σ * Real.sqrt y - q ≠ 0) →
    ∀ x ∈ U, |σ| * Real.sqrt x ≤ C_θ * |2 * σ * Real.sqrt x - q| → ‖eulerOp^[k] (fInvTheta σ q m) x‖ ≤ C * |2 * σ * Real.sqrt x - q|⁻¹ := by
  have hcd : ∀ (σ q : ℝ) (m : ℕ) {U : Set ℝ}, (∀ y ∈ U, 0 < y) → (∀ y ∈ U, 2 * σ * Real.sqrt y - q ≠ 0) → ContDiffOn ℝ (⊤ : ℕ∞) (fInvTheta σ q m) U := fun σ q m {U} hU_pos hU_ne x hx => by
    have hs := Real.contDiffAt_sqrt (n := (⊤ : ℕ∞)) (hU_pos x hx).ne'; have hlin := ((contDiffAt_const (c := 2 * σ)).mul hs).sub (contDiffAt_const (c := q))
    exact (((Complex.ofRealCLM.contDiff.contDiffAt.comp x hlin).inv (Complex.ofReal_ne_zero.mpr (hU_ne x hx))).mul ((Complex.ofRealCLM.contDiff.contDiffAt.comp x (((contDiffAt_const (c := σ)).mul hs).div hlin (hU_ne x hx))).pow m)).contDiffWithinAt
  have heu : ∀ (σ q : ℝ) (m : ℕ) {U : Set ℝ}, IsOpen U → (∀ y ∈ U, 0 < y) → (∀ y ∈ U, 2 * σ * Real.sqrt y - q ≠ 0) → EqOn (eulerOp (fInvTheta σ q m)) (fun t => ((m : ℂ) / 2) * fInvTheta σ q m t + (-(m + 1 : ℂ)) * fInvTheta σ q (m + 1) t) U := fun σ q m {U} _ hU_pos hU_ne x hx => by
    let g := fun t => 2 * σ * Real.sqrt t - q; let r := fun t => σ * Real.sqrt t / g t
    have hx0 := (hU_pos x hx).ne'; have hg0 := hU_ne x hx; have hs0 := (Real.sqrt_pos.mpr (hU_pos x hx)).ne'
    have hx_ne : (x : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hx0; have hg_ne : (g x : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hg0; have hs_ne : (Real.sqrt x : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hs0
    have hg_d : HasDerivAt g (σ / Real.sqrt x) x := (((Real.hasDerivAt_sqrt hx0).const_mul (2 * σ)).sub_const q).congr_deriv (by ring)
    have hr_d : HasDerivAt r ((r x / 2 - r x ^ 2) / x) x := (((Real.hasDerivAt_sqrt hx0).const_mul σ).div hg_d hg0).congr_deriv (by dsimp [r]; field_simp [hx0, hg0, hs0]; rw [Real.sq_sqrt (hU_pos x hx).le]; ring)
    have hginv_d : HasDerivAt (fun t => (g t : ℂ)⁻¹) (-((g x : ℂ)⁻¹ * (r x : ℂ)) / (x : ℂ)) x := ((hg_d.ofReal_comp).inv hg_ne).congr_deriv (by dsimp [r]; have hs2 : (Real.sqrt x : ℂ) ^ 2 = (x : ℂ) := (by exact_mod_cast Real.sq_sqrt (hU_pos x hx).le); push_cast; rw [← hs2]; field_simp [hx_ne, hg_ne, hs_ne])
    have hr_pow : HasDerivAt (fun t => (r t : ℂ) ^ m) ((m : ℂ) * (r x : ℂ) ^ (m - 1) * (((r x / 2 - r x ^ 2 : ℝ) : ℂ) / (x : ℂ))) x := ((hr_d.ofReal_comp).pow m).congr_deriv (by push_cast; ring)
    dsimp only [eulerOp]; rw [show fInvTheta σ q m = fun t => (g t : ℂ)⁻¹ * (r t : ℂ) ^ m from rfl, (hginv_d.fun_mul hr_pow).deriv]
    rcases m with _ | m; { simp only [Nat.cast_zero, pow_zero, mul_zero, zero_mul, add_zero, mul_one, zero_add]; dsimp only [fInvTheta, g, r]; push_cast; simp only [pow_one]; field_simp [hx_ne]; ring }
    rw [Nat.add_sub_cancel]; dsimp only [fInvTheta, g, r]; push_cast; simp only [pow_add, pow_one]; field_simp [hx_ne]; ring
  intro k; induction k with
  | zero => intro m; refine ⟨C_θ ^ m + 1, by positivity, fun {σ q U} hU hU_pos hU_ne x hx hCθ => ?_⟩; simp only [Function.iterate_zero, id_eq, fInvTheta, norm_mul, norm_inv, norm_pow, Complex.norm_real, Real.norm_eq_abs]; have hrb : |(σ * Real.sqrt x) / (2 * σ * Real.sqrt x - q)| ≤ C_θ := (by rw [abs_div, abs_mul, abs_of_nonneg (Real.sqrt_nonneg x), div_le_iff₀ (abs_pos.mpr (hU_ne x hx))]; exact hCθ); exact (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg _) hrb m) (inv_nonneg.mpr (abs_nonneg _))).trans (by rw [mul_comm]; gcongr; linarith)
  | succ k ih =>
    intro m; obtain ⟨C₁, _, h₁⟩ := ih m; obtain ⟨C₂, _, h₂⟩ := ih (m + 1); refine ⟨((m : ℝ) / 2) * C₁ + (m + 1 : ℝ) * C₂ + 1, by positivity, fun {σ q U} hU hU_pos hU_ne x hx hCθ => ?_⟩
    rw [congrFun (Function.iterate_succ eulerOp k) _, Function.comp_apply, eulerOp_congr hU (heu _ _ m hU hU_pos hU_ne) k hx, eulerOp_linear_iterate ((m : ℂ) / 2) (-(m + 1 : ℂ)) hU (hcd _ _ m hU_pos hU_ne) (hcd _ _ (m + 1) hU_pos hU_ne) k x hx]
    have hn1 : ‖((m : ℂ) / 2)‖ = (m : ℝ) / 2 := by rw [norm_div, Complex.norm_natCast, show ‖(2 : ℂ)‖ = 2 from by simp]
    have hn2 : ‖-(m + 1 : ℂ)‖ = (m : ℝ) + 1 := by rw [norm_neg, ← Nat.cast_succ, Complex.norm_natCast, Nat.cast_succ]
    refine (norm_add_le _ _).trans ?_; rw [norm_mul, norm_mul, hn1, hn2]; have hinv_nn := inv_nonneg.mpr (abs_nonneg (2 * σ * Real.sqrt x - q))
    exact (add_le_add (mul_le_mul_of_nonneg_left (h₁ hU hU_pos hU_ne x hx hCθ) (by positivity)) (mul_le_mul_of_nonneg_left (h₂ hU hU_pos hU_ne x hx hCθ) (by positivity))).trans (((by ring : ((m : ℝ) / 2) * (C₁ * |2 * σ * Real.sqrt x - q|⁻¹) + ((m : ℝ) + 1) * (C₂ * |2 * σ * Real.sqrt x - q|⁻¹) = (((m : ℝ) / 2) * C₁ + (m + 1 : ℝ) * C₂) * |2 * σ * Real.sqrt x - q|⁻¹).le).trans (mul_le_mul_of_nonneg_right (by linarith) hinv_nn))
private lemma step1_ibp_bound (N : ℕ) (C_θ : ℝ) (hCθ_nn : 0 ≤ C_θ) :
    ∃ C > 0, ∀ {σ q u_lo c' d' u_hi θ_min : ℝ}, 0 ≤ u_lo → u_lo < c' → c' < d' → d' < u_hi → (∀ x ∈ Ioo u_lo u_hi, θ_min ≤ |2 * σ * Real.sqrt x - q|) → 0 < θ_min →
      (∀ x ∈ Ioo u_lo u_hi, |σ| * Real.sqrt x ≤ C_θ * |2 * σ * Real.sqrt x - q|) → ∀ {a : ℝ → ℂ} {A : ℝ → ℝ}, ContDiffOn ℝ (N : ℕ) a (Ioo u_lo u_hi) →
        (∀ x, (x ≤ c' ∨ d' ≤ x) → a x = 0) → (∀ m ≤ N, ∀ x ∈ Ioo u_lo u_hi, ‖(x : ℂ) ^ m * iteratedDeriv m a x‖ ≤ A x) → ContinuousOn A (Icc c' d') →
        ‖∫ x in Ioo c' d', a x * Complex.exp (Complex.I * (airyPhase σ q x : ℝ))‖ ≤ C * ∫ x in Ioo c' d', A x * (x * |2 * σ * Real.sqrt x - q|) ^ (-(N : ℝ)) := by
  induction N with
