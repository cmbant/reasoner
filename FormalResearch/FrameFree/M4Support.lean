def Qm : Fin 8 → Fin 8 → ℂ :=
![
  ![1, 0, 0, 0, 0, 0, 0, 0],
  ![0, 2/3, -ω/3, 0, ω/3 + 1/3, 0, 0, 0],
  ![0, ω/3 + 1/3, 2/3, 0, -ω/3, 0, 0, 0],
  ![0, 0, 0, 2/3, 0, ω/3 + 1/3, -ω/3, 0],
  ![0, -ω/3, ω/3 + 1/3, 0, 2/3, 0, 0, 0],
  ![0, 0, 0, -ω/3, 0, 2/3, ω/3 + 1/3, 0],
  ![0, 0, 0, ω/3 + 1/3, 0, -ω/3, 2/3, 0],
  ![0, 0, 0, 0, 0, 0, 0, 1]]

def Oad (g : Op1) : M3 :=
  !![
    (g 0 0)^2/2 - (g 0 1)^2/2 - (g 1 0)^2/2 + (g 1 1)^2/2, -Complex.I*(g 0 0)^2/2 - Complex.I*(g 0 1)^2/2 + Complex.I*(g 1 0)^2/2 + Complex.I*(g 1 1)^2/2, -(g 0 0)*(g 0 1) + (g 1 0)*(g 1 1);
    Complex.I*(g 0 0)^2/2 - Complex.I*(g 0 1)^2/2 + Complex.I*(g 1 0)^2/2 - Complex.I*(g 1 1)^2/2, (g 0 0)^2/2 + (g 0 1)^2/2 + (g 1 0)^2/2 + (g 1 1)^2/2, -Complex.I*(g 0 0)*(g 0 1) - Complex.I*(g 1 0)*(g 1 1);
    -(g 0 0)*(g 1 0) + (g 0 1)*(g 1 1), Complex.I*(g 0 0)*(g 1 0) + Complex.I*(g 0 1)*(g 1 1), (g 0 0)*(g 1 1) + (g 0 1)*(g 1 0)]

theorem cayley3 (T : M3) : T * T * T - T.trace • (T * T) + (T.adjugate).trace • T - T.det • (1 : M3) = 0 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
  simp [Matrix.mul_apply, Fin.sum_univ_three, Matrix.det_fin_three, Matrix.adjugate_fin_three, Matrix.trace_fin_three] <;> ring

theorem adj_eq (T : M3) (h1 : T * Tᵀ = 1) (h2 : T.det = 1) : T.adjugate = Tᵀ := by
  have h3 : Tᵀ * T = 1 := mul_eq_one_comm.mp h1
  have h4 : T * T.adjugate = 1 := by rw [Matrix.mul_adjugate, h2, one_smul]
  calc T.adjugate = (Tᵀ * T) * T.adjugate := by rw [h3, Matrix.one_mul]
    _ = Tᵀ * (T * T.adjugate) := by rw [Matrix.mul_assoc]
    _ = Tᵀ := by rw [h4, Matrix.mul_one]

/-- Cayley–Hamilton for `SO(3,ℂ)`: `T² = tr T (T − 1) + Tᵀ` (`eq:m4hand-ch`). -/
theorem ch3 (T : M3) (h1 : T * Tᵀ = 1) (h2 : T.det = 1) :
    T * T = T.trace • (T - 1) + Tᵀ := by
  have h3 : Tᵀ * T = 1 := mul_eq_one_comm.mp h1
  have c := cayley3 T
  rw [adj_eq T h1 h2, Matrix.trace_transpose, h2, one_smul] at c
  have c2 := congrArg (fun X => Tᵀ * X) c
  simp only [Matrix.mul_sub, Matrix.mul_add, Matrix.mul_smul, Matrix.mul_zero, ← Matrix.mul_assoc, h3, Matrix.one_mul, Matrix.mul_one] at c2
  calc T * T = (T * T - T.trace • T + T.trace • 1 - Tᵀ) + (T.trace • (T - 1) + Tᵀ) := by
        rw [smul_sub]; abel
    _ = _ := by rw [c2, zero_add]

/-- `T ∈ SO(3, ℂ)` -/
structure SO3 (T : M3) : Prop where
  orth : T * Tᵀ = 1
  det_one : T.det = 1

theorem SO3.orth' {T : M3} (h : SO3 T) : Tᵀ * T = 1 := mul_eq_one_comm.mp h.orth
theorem SO3.transpose {T : M3} (h : SO3 T) : SO3 Tᵀ :=
  ⟨by rw [Matrix.transpose_transpose]; exact h.orth', by rw [Matrix.det_transpose]; exact h.det_one⟩
theorem SO3.mul {S T : M3} (hS : SO3 S) (hT : SO3 T) : SO3 (S * T) :=
  ⟨by rw [Matrix.transpose_mul, Matrix.mul_assoc, ← Matrix.mul_assoc T, hT.orth, Matrix.one_mul, hS.orth],
   by rw [Matrix.det_mul, hS.det_one, hT.det_one, one_mul]⟩

theorem SO3.ch {T : M3} (h : SO3 T) : T * T = T.trace • (T - 1) + Tᵀ := ch3 T h.orth h.det_one

theorem SO3.trace_sq {T : M3} (h : SO3 T) : (T * T).trace = T.trace ^ 2 - 2 * T.trace := by
  rw [h.ch]
  simp [Matrix.trace_add, Matrix.trace_smul, Matrix.trace_sub, Matrix.trace_transpose, Matrix.trace_one]
  ring

def bsum (X Y : M3) : ℂ := ∑ i, ∑ j, X i j * Y i j
def tsum' (X Y : M3) : ℂ := ∑ i, ∑ j, X i j * Y j i

theorem bsum_eq (X Y : M3) : bsum X Y = (Xᵀ * Y).trace := by
  simp [bsum, Matrix.trace, Matrix.mul_apply, Fin.sum_univ_three]; ring
theorem tsum_eq (X Y : M3) : tsum' X Y = (X * Y).trace := by
  simp [tsum', Matrix.trace, Matrix.mul_apply, Fin.sum_univ_three]

theorem tab_B11 {Q : M3} (hQ : SO3 Q) : bsum Q Q = 3 := by
  rw [bsum_eq, hQ.orth']; simp
theorem tab_B22 {P : M3} (hP : SO3 P) : bsum P P = 3 := by
  rw [bsum_eq, hP.orth']; simp
theorem tab_T12 (P Q : M3) : tsum' Q P = (P * Q).trace := by
  rw [tsum_eq, Matrix.trace_mul_comm]
theorem tab_T11 {Q : M3} (hQ : SO3 Q) : tsum' Q Q = Q.trace ^ 2 - 2 * Q.trace := by
  rw [tsum_eq]; exact hQ.trace_sq
theorem tab_T22 {P : M3} (hP : SO3 P) : tsum' P P = P.trace ^ 2 - 2 * P.trace := by
  rw [tsum_eq]; exact hP.trace_sq
theorem tab_T33 {P Q : M3} (hP : SO3 P) (hQ : SO3 Q) :
    tsum' (P * Qᵀ) (P * Qᵀ) = (P * Qᵀ).trace ^ 2 - 2 * (P * Qᵀ).trace := by
  rw [tsum_eq]; exact (hP.mul hQ.transpose).trace_sq

theorem tab_B33 {P Q : M3} (hP : SO3 P) (hQ : SO3 Q) : bsum (P * Qᵀ) (P * Qᵀ) = 3 := by
  rw [bsum_eq, Matrix.transpose_mul, Matrix.transpose_transpose]
  have : Q * Pᵀ * (P * Qᵀ) = 1 := by
    rw [Matrix.mul_assoc, ← Matrix.mul_assoc Pᵀ, hP.orth', Matrix.one_mul, hQ.orth]
  rw [this]; simp
theorem tab_B12 (P Q : M3) : bsum Q P = (P * Qᵀ).trace := by
  rw [bsum_eq, Matrix.trace_mul_comm]
theorem tab_B23 {P : M3} (hP : SO3 P) (Q : M3) : bsum P (P * Qᵀ) = Q.trace := by
  rw [bsum_eq, ← Matrix.mul_assoc, hP.orth', Matrix.one_mul, Matrix.trace_transpose]
theorem tab_B13 {P Q : M3} (hQ : SO3 Q) :
    bsum Q (P * Qᵀ) = Q.trace * (P * Qᵀ).trace - Q.trace * P.trace + (P * Q).trace := by
  have h1 : (Qᵀ * (P * Qᵀ)).trace = (P * (Qᵀ * Qᵀ)).trace := by
    rw [Matrix.trace_mul_comm, Matrix.mul_assoc]
  rw [bsum_eq, h1]
  have := hQ.transpose.ch
  rw [Matrix.transpose_transpose, Matrix.trace_transpose] at this
  rw [this]
  simp [Matrix.mul_add, Matrix.mul_smul, Matrix.mul_sub, Matrix.trace_add, Matrix.trace_smul, Matrix.trace_sub]
  ring
theorem tab_T13 {P Q : M3} (hQ : SO3 Q) : tsum' Q (P * Qᵀ) = P.trace := by
  have h1 : (Q * (P * Qᵀ)).trace = (P * (Qᵀ * Q)).trace := by
    rw [Matrix.trace_mul_comm, Matrix.mul_assoc]
  rw [tsum_eq, h1, hQ.orth', Matrix.mul_one]
theorem tab_T23 {P Q : M3} (hP : SO3 P) :
    tsum' P (P * Qᵀ) = P.trace * (P * Qᵀ).trace - P.trace * Q.trace + (P * Q).trace := by
  rw [tsum_eq, ← Matrix.mul_assoc, hP.ch]
  have : (Pᵀ * Qᵀ).trace = (P * Q).trace := by
    rw [← Matrix.transpose_mul, Matrix.trace_transpose, Matrix.trace_mul_comm]
  simp [Matrix.add_mul, Matrix.smul_mul, Matrix.sub_mul, Matrix.trace_add, Matrix.trace_smul, Matrix.trace_sub, this]
  ring

def tr3 (Y : M3) : ℂ := Y 0 0 + Y 1 1 + Y 2 2
def Sp (Y : M3) : M3 := fun i j => (Y i j + Y j i) / 2 - (if i = j then tr3 Y / 3 else 0)
def Ap (Y : M3) : M3 := fun i j => (Y i j - Y j i) / 2
def comb (c1 c2 : ℂ) (X1 X2 X3 : M3) : M3 := fun i j => X1 i j + c1 * X2 i j + c2 * X3 i j
def tcomb (c1 c2 : ℂ) (Y1 Y2 Y3 : M3) : ℂ := tr3 Y1 + c1 * tr3 Y2 + c2 * tr3 Y3
def bil (X : M3) : ℂ := ∑ i, ∑ j, X i j ^ 2

theorem I2_poly (Y1 Y2 Y3 : M3) :
    tcomb ω (ω ^ 2) Y1 Y2 Y3 ^ 2 - 6 * bil (comb ω (ω ^ 2) (Sp Y1) (Sp Y2) (Sp Y3)) =
    -3 * ((bsum Y1 Y1 + tsum' Y1 Y1 - tr3 Y1 * tr3 Y1) + (ω * ω) * (bsum Y2 Y2 + tsum' Y2 Y2 - tr3 Y2 * tr3 Y2)
      + (ω ^ 2 * ω ^ 2) * (bsum Y3 Y3 + tsum' Y3 Y3 - tr3 Y3 * tr3 Y3)
      + 2 * ω * (bsum Y1 Y2 + tsum' Y1 Y2 - tr3 Y1 * tr3 Y2)
      + 2 * ω ^ 2 * (bsum Y1 Y3 + tsum' Y1 Y3 - tr3 Y1 * tr3 Y3)
      + 2 * (ω * ω ^ 2) * (bsum Y2 Y3 + tsum' Y2 Y3 - tr3 Y2 * tr3 Y3)) := by
  simp only [tcomb, bil, comb, Sp, Ap, bsum, tsum', tr3, Fin.sum_univ_three, Fin.isValue, Fin.reduceEq, ↓reduceIte]
  ring

theorem I1_poly (Y1 Y2 Y3 : M3) :
    tcomb (ω ^ 2) ω Y1 Y2 Y3 ^ 2 - 3 * bil (comb (ω ^ 2) ω (Sp Y1) (Sp Y2) (Sp Y3))
      - 3 * bil (comb (-(ω ^ 2)) ω (Ap Y1) (Ap Y2) (Ap Y3)) - 2 * tcomb 1 1 Y1 Y2 Y3 * tcomb ω (ω ^ 2) Y1 Y2 Y3 =
    2 * tcomb (ω ^ 2) ω Y1 Y2 Y3 ^ 2 - 2 * tcomb 1 1 Y1 Y2 Y3 * tcomb ω (ω ^ 2) Y1 Y2 Y3
    - 3 / 2 * ((bsum Y1 Y1 + tsum' Y1 Y1) + (ω ^ 2 * ω ^ 2) * (bsum Y2 Y2 + tsum' Y2 Y2) + (ω * ω) * (bsum Y3 Y3 + tsum' Y3 Y3)
      + 2 * ω ^ 2 * (bsum Y1 Y2 + tsum' Y1 Y2) + 2 * ω * (bsum Y1 Y3 + tsum' Y1 Y3)
      + 2 * (ω ^ 2 * ω) * (bsum Y2 Y3 + tsum' Y2 Y3)
      + (bsum Y1 Y1 - tsum' Y1 Y1) + (ω ^ 2 * ω ^ 2) * (bsum Y2 Y2 - tsum' Y2 Y2) + (ω * ω) * (bsum Y3 Y3 - tsum' Y3 Y3)
      - 2 * ω ^ 2 * (bsum Y1 Y2 - tsum' Y1 Y2) + 2 * ω * (bsum Y1 Y3 - tsum' Y1 Y3)
      - 2 * (ω ^ 2 * ω) * (bsum Y2 Y3 - tsum' Y2 Y3)) := by
  simp only [tcomb, bil, comb, Sp, Ap, bsum, tsum', tr3, Fin.sum_univ_three, Fin.isValue, Fin.reduceEq, ↓reduceIte]
  ring

theorem tr3_eq (Y : M3) : tr3 Y = Y.trace := by
  simp [tr3, Matrix.trace_fin_three]

/-- `(F₂t)² = 6 β(F₂S, F₂S)` for `Y = (Q, P, PQᵀ)`, `P, Q ∈ SO(3,ℂ)` (`lem:m4hand-trace`, second identity). -/
theorem levelA_I2 {P Q : M3} (hP : SO3 P) (hQ : SO3 Q) :
    tcomb ω (ω ^ 2) Q P (P * Qᵀ) ^ 2 = 6 * bil (comb ω (ω ^ 2) (Sp Q) (Sp P) (Sp (P * Qᵀ))) := by
  have h := I2_poly Q P (P * Qᵀ)
  simp only [tab_B11 hQ, tab_B22 hP, tab_B33 hP hQ, tab_B12 P Q, tab_B13 hQ, tab_B23 hP, tab_T11 hQ, tab_T22 hP,
    tab_T33 hP hQ, tab_T12 P Q, tab_T13 hQ, tab_T23 hP, tr3_eq] at h
  generalize Matrix.trace P = p at h
  generalize Matrix.trace Q = q at h
  generalize (P * Qᵀ).trace = r at h
  generalize (P * Q).trace = u at h
  linear_combination h + (-3 * (-2*p*q*ω + 2*q*ω - 2*q - 2*r*ω^2 + 2*r*ω + 2*u*ω + 3*ω^2 - 3*ω + 3)) * omega_sq_add

/-- `(F₁t)² = 3β(F₁S,F₁S) + 3β(GA,GA) + 2 (F₀t)(F₂t)` (`lem:m4hand-trace`, first identity). -/
theorem levelA_I1 {P Q : M3} (hP : SO3 P) (hQ : SO3 Q) :
    tcomb (ω ^ 2) ω Q P (P * Qᵀ) ^ 2 = 3 * bil (comb (ω ^ 2) ω (Sp Q) (Sp P) (Sp (P * Qᵀ)))
      + 3 * bil (comb (-(ω ^ 2)) ω (Ap Q) (Ap P) (Ap (P * Qᵀ))) + 2 * tcomb 1 1 Q P (P * Qᵀ) * tcomb ω (ω ^ 2) Q P (P * Qᵀ) := by
  have h := I1_poly Q P (P * Qᵀ)
  simp only [tcomb, tr3_eq] at h ⊢
  simp only [tab_B11 hQ, tab_B22 hP, tab_B33 hP hQ, tab_B12 P Q, tab_B13 hQ, tab_B23 hP, tab_T11 hQ, tab_T22 hP,
    tab_T33 hP hQ, tab_T12 P Q, tab_T13 hQ, tab_T23 hP, tr3_eq] at h
  generalize Matrix.trace P = p at h ⊢
  generalize Matrix.trace Q = q at h ⊢
  generalize (P * Qᵀ).trace = r at h ⊢
  generalize (P * Q).trace = u at h ⊢
  linear_combination h + (2*p^2*ω^2 - 2*p^2*ω + 6*p*q*ω - 2*p*q - 2*p*r*ω - 2*q*r - 6*u*ω - 9*ω^2 + 9*ω - 9) * omega_sq_add


/-- Frobenius norm squared (real). -/
def fn (X : M3) : ℝ := ∑ i, ∑ j, Complex.normSq (X i j)

/-- `|β(X,X)| ≤ ‖X‖²`. -/
theorem norm_bil_le (X : M3) : ‖bil X‖ ≤ fn X := by
  unfold bil fn
  refine (norm_sum_le _ _).trans ?_
  refine Finset.sum_le_sum fun i _ => ?_
  refine (norm_sum_le _ _).trans ?_
  refine Finset.sum_le_sum fun j _ => ?_
  rw [norm_pow, ← Complex.normSq_eq_norm_sq]

def RHSr (Y1 Y2 Y3 : M3) : ℝ :=
  4 * fn (comb (ω ^ 2) ω (Sp Y1) (Sp Y2) (Sp Y3)) + 4 * fn (comb ω (ω ^ 2) (Sp Y1) (Sp Y2) (Sp Y3))
  + 4 * fn (comb (-(ω ^ 2)) ω (Ap Y1) (Ap Y2) (Ap Y3))
  + 4 / 3 * Complex.normSq (tcomb 1 1 Y1 Y2 Y3) - 4 / 3 * Complex.normSq (tcomb (ω ^ 2) ω Y1 Y2 Y3)
  + 2 / 3 * Complex.normSq (tcomb ω (ω ^ 2) Y1 Y2 Y3)

/-- The right side of the deficit identity is nonnegative: Cayley–Hamilton, `|β(X,X)| ≤ ‖X‖²` and AM–GM (end of the proof of `thm:m4support`). -/
theorem RHSr_nonneg {P Q : M3} (hP : SO3 P) (hQ : SO3 Q) : 0 ≤ RHSr Q P (P * Qᵀ) := by
  have h1 := levelA_I1 hP hQ
  have h2 := levelA_I2 hP hQ
  set F0 := tcomb 1 1 Q P (P * Qᵀ)
  set F1 := tcomb (ω ^ 2) ω Q P (P * Qᵀ)
  set F2 := tcomb ω (ω ^ 2) Q P (P * Qᵀ)
  set f1 := fn (comb (ω ^ 2) ω (Sp Q) (Sp P) (Sp (P * Qᵀ)))
  set f2 := fn (comb ω (ω ^ 2) (Sp Q) (Sp P) (Sp (P * Qᵀ)))
  set f3 := fn (comb (-(ω ^ 2)) ω (Ap Q) (Ap P) (Ap (P * Qᵀ)))
  have b1 := norm_bil_le (comb (ω ^ 2) ω (Sp Q) (Sp P) (Sp (P * Qᵀ)))
  have b2 := norm_bil_le (comb ω (ω ^ 2) (Sp Q) (Sp P) (Sp (P * Qᵀ)))
  have b3 := norm_bil_le (comb (-(ω ^ 2)) ω (Ap Q) (Ap P) (Ap (P * Qᵀ)))
  set B1 := bil (comb (ω ^ 2) ω (Sp Q) (Sp P) (Sp (P * Qᵀ)))
  set B2 := bil (comb ω (ω ^ 2) (Sp Q) (Sp P) (Sp (P * Qᵀ)))
  set B3 := bil (comb (-(ω ^ 2)) ω (Ap Q) (Ap P) (Ap (P * Qᵀ)))
  have n1 : ‖F1‖ ^ 2 ≤ 3 * f1 + 3 * f3 + 2 * (‖F0‖ * ‖F2‖) := by
    have := congrArg norm h1
    rw [norm_pow] at this
    rw [this]
    refine (norm_add_le _ _).trans ?_
    refine add_le_add ((norm_add_le _ _).trans (add_le_add ?_ ?_)) ?_
    · rw [norm_mul]; norm_num; linarith
    · rw [norm_mul]; norm_num; linarith
    · rw [norm_mul, norm_mul]; norm_num; linarith
  have n2 : ‖F2‖ ^ 2 ≤ 6 * f2 := by
    have := congrArg norm h2
    rw [norm_pow] at this
    rw [this, norm_mul]; norm_num; linarith
  unfold RHSr
  simp only [Complex.normSq_eq_norm_sq]
  nlinarith [sq_nonneg (‖F0‖ - ‖F2‖), norm_nonneg F0, norm_nonneg F2, norm_nonneg F1]

