def pairl (Y1 Y2 Y3 : M3) : ℂ := (-1) * Y1 0 0 + (-1) * Y1 1 1 + (-1) * Y1 2 2 + (ω + 1) * Y2 0 0 + (ω + 1) * Y2 1 1 + (ω + 1) * Y2 2 2 + (-ω) * Y3 0 0 + (-ω) * Y3 1 1 + (-ω) * Y3 2 2

def fnc (X : M3) : ℂ := ∑ i, ∑ j, nm (X i j)
def RHSc (Y1 Y2 Y3 : M3) : ℂ :=
  4 * fnc (comb (ω ^ 2) ω (Sp Y1) (Sp Y2) (Sp Y3)) + 4 * fnc (comb ω (ω ^ 2) (Sp Y1) (Sp Y2) (Sp Y3))
  + 4 * fnc (comb (-(ω ^ 2)) ω (Ap Y1) (Ap Y2) (Ap Y3))
  + 4 / 3 * nm (tcomb 1 1 Y1 Y2 Y3) - 4 / 3 * nm (tcomb (ω ^ 2) ω Y1 Y2 Y3)
  + 2 / 3 * nm (tcomb ω (ω ^ 2) Y1 Y2 Y3)

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The exact deficit identity `(9/8) Σ|QΩ₀Qᵀ|² − |pair|² = (3/4)·RHS` as a polynomial identity in the entries of `Y` (`prop:m4hand-deficit`, `lem:m4hand-form`). -/
theorem HF2 (Y1 Y2 Y3 : M3) :
    (9 / 8 : ℂ) * (∑ p, ∑ q, nm (Lf Y1 Y2 Y3 p q)) - nm (pairl Y1 Y2 Y3) = (3 / 4) * RHSc Y1 Y2 Y3 := by
  unfold Lf pairl RHSc fnc nm tcomb comb Sp Ap tr3
  simp only [Fin.sum_univ_eight, Fin.sum_univ_three, Matrix.cons_val, map_add, map_mul, map_sub, map_neg, map_div₀, map_pow, map_ofNat, map_one, map_zero, conj_omega', Complex.conj_I, Fin.isValue, Fin.reduceEq, ite_true, ite_false, ↓reduceIte]
  ring_nf
  simp only [ωsq, ωcu, ω4, ω5, Isq]
  ring_nf

theorem nm_eq (z : ℂ) : nm z = (Complex.normSq z : ℂ) := Complex.mul_conj z

theorem RHSc_eq (Y1 Y2 Y3 : M3) : RHSc Y1 Y2 Y3 = (RHSr Y1 Y2 Y3 : ℂ) := by
  unfold RHSc RHSr fnc fn
  simp only [nm_eq]
  push_cast
  rfl

/-- Real form of the deficit identity (`prop:m4hand-deficit`, `lem:m4hand-form`). -/
theorem HF_real (Y1 Y2 Y3 : M3) :
    (9 / 8 : ℝ) * (∑ p, ∑ q, Complex.normSq (Lf Y1 Y2 Y3 p q)) - Complex.normSq (pairl Y1 Y2 Y3)
      = (3 / 4) * RHSr Y1 Y2 Y3 := by
  have h := HF2 Y1 Y2 Y3
  rw [RHSc_eq] at h
  simp only [nm_eq] at h
  apply Complex.ofReal_injective
  push_cast
  exact h

def b0 : Fin 8 → Fin 2 := ![0, 0, 0, 0, 1, 1, 1, 1]
def b1 : Fin 8 → Fin 2 := ![0, 0, 1, 1, 0, 0, 1, 1]
def b2 : Fin 8 → Fin 2 := ![0, 1, 0, 1, 0, 1, 0, 1]

/-- `A ⊗ B ⊗ C` acting on `ℂ⁸`. -/
def act (A B C : Op1) (v : Fin 8 → ℂ) (p : Fin 8) : ℂ :=
  ∑ r, A (b0 p) (b0 r) * B (b1 p) (b1 r) * C (b2 p) (b2 r) * v r

def ut1 : Fin 8 → ℂ := ![0, ω ^ 2, ω, 0, 1, 0, 0, 0]
def ut2 : Fin 8 → ℂ := ![0, 0, 0, 1, 0, ω, ω ^ 2, 0]
def vt1 : Fin 8 → ℂ := ![0, ω, ω ^ 2, 0, 1, 0, 0, 0]
def vt2 : Fin 8 → ℂ := ![0, 0, 0, 1, 0, ω ^ 2, ω, 0]

def W0 (hA hB : Op1) : Fin 8 → ℂ := act hA hB 1 vt2
def W1 (hA hB : Op1) : Fin 8 → ℂ := act hA hB 1 vt1

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- Block coordinates of the filtered Plücker vector (`lem:m4hand-blocks`(b)): `W₀∧W₁ = ½ Ω₀(Y)` with `Y = (det h_A·O(h_B), det h_B·O(h_A), O(h_A)O(h_B)ᵀ)`. -/
theorem bridge (hA hB : Op1) (p q : Fin 8) :
    W0 hA hB p * W1 hA hB q - W0 hA hB q * W1 hA hB p =
      (1 / 2) * Om0 (hA.det • Oad hB) (hB.det • Oad hA) (Oad hA * (Oad hB)ᵀ) p q := by
  unfold W0 W1 act Om0 Oad
  fin_cases p <;> fin_cases q <;>
  simp only [Fin.sum_univ_eight, Fin.sum_univ_three, Matrix.cons_val, Matrix.smul_apply, smul_eq_mul, Matrix.mul_apply,
    Matrix.transpose_apply, Matrix.det_fin_two, b0, b1, b2, vt1, vt2, Matrix.one_apply, Fin.isValue, Fin.reduceEq, ↓reduceIte,
    Matrix.of_apply, Matrix.cons_val', Matrix.empty_val', Matrix.cons_val_fin_one, Fin.reduceFinMk, Fin.mk_one, Fin.zero_eta] <;>
  ring_nf <;> simp only [ωsq, ωcu, ω4, ω5, Isq] <;> ring_nf

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- `O(h)O(h)ᵀ = det(h)² I`. -/
theorem Oad_mul_transpose (h : Op1) : Oad h * (Oad h)ᵀ = (h.det) ^ 2 • (1 : M3) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
  simp [Matrix.mul_apply, Fin.sum_univ_three, Oad, Matrix.one_apply, Matrix.transpose_apply, Matrix.det_fin_two] <;>
  ring_nf <;> simp only [Isq] <;> ring_nf

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- `det O(h) = det(h)³`. -/
theorem Oad_det (h : Op1) : (Oad h).det = (h.det) ^ 3 := by
  simp [Matrix.det_fin_three, Oad, Matrix.det_fin_two]
  ring_nf
  simp only [Isq]
  ring_nf

/-- `O(h) ∈ SO(3,ℂ)` for `det h = 1` (`eq:m4hand-O`). -/
theorem SO3_Oad (h : Op1) (hd : h.det = 1) : SO3 (Oad h) :=
  ⟨by rw [Oad_mul_transpose, hd]; simp, by rw [Oad_det, hd]; simp⟩

/-- Hermitian inner product on `ℂ⁸`, conjugate-linear in the first slot. -/
def ipv (x y : Fin 8 → ℂ) : ℂ := ∑ p, conj (x p) * y p
/-- Squared norm on `ℂ⁸`. -/
def nv (x : Fin 8 → ℂ) : ℝ := ∑ p, Complex.normSq (x p)

theorem nv_cast (x : Fin 8 → ℂ) : (nv x : ℂ) = ipv x x := by
  unfold nv ipv
  push_cast
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [mul_comm, Complex.mul_conj]

theorem ipv_swap (x y : Fin 8 → ℂ) : ipv y x = conj (ipv x y) := by
  unfold ipv
  rw [map_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [map_mul, Complex.conj_conj, mul_comm]

/-- Lagrange's identity on `ℂ⁸`. -/
theorem lagr8 (x y : Fin 8 → ℂ) :
    (1 / 2 : ℝ) * ∑ p, ∑ q, Complex.normSq (x p * y q - x q * y p) =
      nv x * nv y - Complex.normSq (ipv x y) := by
  apply Complex.ofReal_injective
  push_cast
  simp only [Complex.ofReal_sum, ← Complex.mul_conj]
  rw [nv_cast, nv_cast]
  unfold ipv
  simp only [Fin.sum_univ_eight, map_sub, map_mul, map_add, Complex.conj_conj]
  ring

/-- `ipv` of two combinations of `x,y`. -/
theorem ipv_lin2 (α β γ δ : ℂ) (x y : Fin 8 → ℂ) :
    ipv (fun p => α * x p + β * y p) (fun p => γ * x p + δ * y p) =
      conj α * γ * ipv x x + conj α * δ * ipv x y + conj β * γ * ipv y x + conj β * δ * ipv y y := by
  unfold ipv
  simp only [Fin.sum_univ_eight, map_sub, map_mul, map_add]
  ring

/-- Apply `Q` (the projector `1 - P₊`) to a vector. -/
def qv (x : Fin 8 → ℂ) : Fin 8 → ℂ := fun p => ∑ r, Qm p r * x r

/-- The two branches `ũ_a`: `ut2` for `a = 0`, `ut1` for `a = 1`. -/
def uu : Fin 2 → Fin 8 → ℂ := ![ut2, ut1]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- `3 Gram(Q x, Q y) = 3 Gram(x,y) - Σ_a conj⟨ũ_a,x⟩⟨ũ_a,y⟩`. -/
theorem gram_q (x y : Fin 8 → ℂ) :
    3 * ipv (qv x) (qv y) = 3 * ipv x y - ∑ a, conj (ipv (uu a) x) * ipv (uu a) y := by
  unfold ipv qv uu Qm ut1 ut2
  simp only [Fin.sum_univ_eight, Fin.sum_univ_two, Matrix.cons_val, map_add, map_mul, map_sub, map_neg, map_div₀,
    map_pow, map_ofNat, map_one, map_zero, conj_omega', Fin.isValue]
  ring_nf
  simp only [ωsq, ωcu, ω4, ω5]
  ring_nf

/-- `Qx ∧ Qy = (Q⊗Q)(x∧y)` in coordinates. -/
theorem wedge_q (x y : Fin 8 → ℂ) (p q : Fin 8) :
    qv x p * qv y q - qv x q * qv y p =
      ∑ r, ∑ s, Qm p r * Qm q s * (x r * y s - x s * y r) := by
  unfold qv
  simp only [Fin.sum_univ_eight]
  ring

theorem cs2 (D a b r0 r1 Y0 Y1 : ℝ) (hD : 0 < D) (ha : 0 ≤ a) (hb : 0 ≤ b) (hr0 : 0 ≤ r0) (hr1 : 0 ≤ r1)
    (hY0 : 0 ≤ Y0) (hY1 : 0 ≤ Y1) (h0 : D * a ^ 2 ≤ r0 * Y0) (h1 : D * b ^ 2 ≤ r1 * Y1) :
    D * (a + b) ^ 2 ≤ (r0 + r1) * (Y0 + Y1) := by
  have h2 : 2 * D * (a * b) ≤ r0 * Y1 + r1 * Y0 := by
    have hsq : (2 * D * (a * b)) ^ 2 ≤ (r0 * Y1 + r1 * Y0) ^ 2 := by
      have e1 : (2 * D * (a * b)) ^ 2 = 4 * (D * a ^ 2) * (D * b ^ 2) := by ring
      have e2 : 4 * (D * a ^ 2) * (D * b ^ 2) ≤ 4 * (r0 * Y0) * (r1 * Y1) := by
        have := mul_le_mul h0 h1 (by positivity) (by positivity)
        nlinarith
      nlinarith [sq_nonneg (r0 * Y1 - r1 * Y0)]
    exact le_trans (le_abs_self _) (abs_le_of_sq_le_sq hsq (by positivity))
  nlinarith

/-- The first-row-contraction vectors `ρ_a = m_{a1} W₀ - m_{a0} W₁`. -/
def rhov (W0 W1 : Fin 8 → ℂ) (a : Fin 2) : Fin 8 → ℂ :=
  fun p => ipv (uu a) W1 * W0 p - ipv (uu a) W0 * W1 p

/-- `y_a = G_{a0} W₀ + G_{a1} W₁`. -/
def yv (W0 W1 : Fin 8 → ℂ) (G : Fin 2 → Fin 2 → ℂ) (a : Fin 2) : Fin 8 → ℂ :=
  fun p => G a 0 * W0 p + G a 1 * W1 p

/-- `c_a = G_{a0} m_{a0} + G_{a1} m_{a1}`. -/
def cc (W0 W1 : Fin 8 → ℂ) (G : Fin 2 → Fin 2 → ℂ) (a : Fin 2) : ℂ :=
  G a 0 * ipv (uu a) W0 + G a 1 * ipv (uu a) W1

/-- Gram determinant of the plane. -/
def Dpl (W0 W1 : Fin 8 → ℂ) : ℝ := nv W0 * nv W1 - Complex.normSq (ipv W0 W1)

theorem Dpl_eq (W0 W1 : Fin 8 → ℂ) :
    Dpl W0 W1 = (1 / 2 : ℝ) * ∑ p, ∑ q, Complex.normSq (W0 p * W1 q - W0 q * W1 p) := (lagr8 W0 W1).symm

/-- Per-row Lagrange inequality: `D |c_a|² ≤ ‖ρ_a‖² ‖y_a‖²`. -/
theorem row_ineq (W0 W1 : Fin 8 → ℂ) (G : Fin 2 → Fin 2 → ℂ) (a : Fin 2) :
    Dpl W0 W1 * Complex.normSq (cc W0 W1 G a) ≤ nv (rhov W0 W1 a) * nv (yv W0 W1 G a) := by
  have hL := lagr8 (rhov W0 W1 a) (yv W0 W1 G a)
  have hE : ∀ p q, rhov W0 W1 a p * yv W0 W1 G a q - rhov W0 W1 a q * yv W0 W1 G a p =
      cc W0 W1 G a * (W0 p * W1 q - W0 q * W1 p) := by
    intro p q
    unfold rhov yv cc
    ring
  simp only [hE, Complex.normSq_mul] at hL
  have : (1 / 2 : ℝ) * ∑ p, ∑ q, Complex.normSq (cc W0 W1 G a) * Complex.normSq (W0 p * W1 q - W0 q * W1 p) =
      Complex.normSq (cc W0 W1 G a) * Dpl W0 W1 := by
    rw [Dpl_eq]
    simp only [← Finset.mul_sum]
    ring
  rw [this] at hL
  nlinarith [Complex.normSq_nonneg (ipv (rhov W0 W1 a) (yv W0 W1 G a))]

/-- Gram of the `ρ_a` in terms of the plane Gram matrix and `m`. -/
theorem nv_rho (W0 W1 : Fin 8 → ℂ) (a : Fin 2) :
    (nv (rhov W0 W1 a) : ℂ) =
      conj (ipv (uu a) W1) * ipv (uu a) W1 * ipv W0 W0 - conj (ipv (uu a) W1) * ipv (uu a) W0 * ipv W0 W1
      - conj (ipv (uu a) W0) * ipv (uu a) W1 * ipv W1 W0 + conj (ipv (uu a) W0) * ipv (uu a) W0 * ipv W1 W1 := by
  rw [nv_cast]
  have := ipv_lin2 (ipv (uu a) W1) (-ipv (uu a) W0) (ipv (uu a) W1) (-ipv (uu a) W0) W0 W1
  have e : rhov W0 W1 a = fun p => ipv (uu a) W1 * W0 p + -ipv (uu a) W0 * W1 p := by
    funext p; unfold rhov; ring
  rw [e, this]
  simp only [map_neg]
  ring

/-- `det m`, `m_{ab} = ⟨ũ_a, W_b⟩`. -/
def detm (W0 W1 : Fin 8 → ℂ) : ℂ :=
  ipv (uu 0) W0 * ipv (uu 1) W1 - ipv (uu 0) W1 * ipv (uu 1) W0

/-- The 2×2 plane identity: `3D - Σ_a ‖ρ_a‖² = 3 det R - |det m|²/3`, `R = Gram(Q W)`. -/
theorem plane_identity (W0 W1 : Fin 8 → ℂ) :
    3 * Dpl W0 W1 - ∑ a, nv (rhov W0 W1 a) =
      3 * (nv (qv W0) * nv (qv W1) - Complex.normSq (ipv (qv W0) (qv W1))) - Complex.normSq (detm W0 W1) / 3 := by
  apply Complex.ofReal_injective
  have h00 := gram_q W0 W0
  have h11 := gram_q W1 W1
  have h01 := gram_q W0 W1
  have h10 := gram_q W1 W0
  rw [ipv_swap (qv W0) (qv W1)] at h10
  rw [ipv_swap W0 W1] at h10
  have hs : ∀ a, (nv (rhov W0 W1 a) : ℂ) = _ := nv_rho W0 W1
  unfold Dpl
  push_cast
  simp only [Fin.sum_univ_two] at h00 h11 h01 h10 ⊢
  simp only [hs, nv_cast, ← Complex.mul_conj, detm]
  rw [ipv_swap W0 W1]
  have e00 : ipv (qv W0) (qv W0) = ipv W0 W0 - (1 / 3) * (conj (ipv (uu 0) W0) * ipv (uu 0) W0 + conj (ipv (uu 1) W0) * ipv (uu 1) W0) := by
    linear_combination (1 / 3) * h00
  have e11 : ipv (qv W1) (qv W1) = ipv W1 W1 - (1 / 3) * (conj (ipv (uu 0) W1) * ipv (uu 0) W1 + conj (ipv (uu 1) W1) * ipv (uu 1) W1) := by
    linear_combination (1 / 3) * h11
  have e01 : ipv (qv W0) (qv W1) = ipv W0 W1 - (1 / 3) * (conj (ipv (uu 0) W0) * ipv (uu 0) W1 + conj (ipv (uu 1) W0) * ipv (uu 1) W1) := by
    linear_combination (1 / 3) * h01
  have e10 : conj (ipv (qv W0) (qv W1)) = conj (ipv W0 W1) - (1 / 3) * (conj (ipv (uu 0) W1) * ipv (uu 0) W0 + conj (ipv (uu 1) W1) * ipv (uu 1) W0) := by
    linear_combination (1 / 3) * h10
  rw [e00, e11, e10, e01]
  simp only [map_sub, map_mul, map_add, Complex.conj_conj]
  ring

/-- The plane inequality: `det R ≥ |det M|²/9` and `D > 0` give `|Σ_a c_a|² ≤ 3 Σ_a ‖y_a‖²` (the Cauchy–Schwarz step of the plane formula, row by row). -/
theorem plane_main (W0 W1 : Fin 8 → ℂ) (G : Fin 2 → Fin 2 → ℂ)
    (hdef : Complex.normSq (detm W0 W1) ≤
      9 * (nv (qv W0) * nv (qv W1) - Complex.normSq (ipv (qv W0) (qv W1))))
    (hD : 0 < Dpl W0 W1) :
    Complex.normSq (∑ a, cc W0 W1 G a) ≤ 3 * ∑ a, nv (yv W0 W1 G a) := by
  have hid := plane_identity W0 W1
  have hsum : ∑ a, nv (rhov W0 W1 a) ≤ 3 * Dpl W0 W1 := by linarith
  have r0 := row_ineq W0 W1 G 0
  have r1 := row_ineq W0 W1 G 1
  simp only [Fin.sum_univ_two] at hsum ⊢
  have hn : ∀ x, 0 ≤ nv x := fun x => Finset.sum_nonneg fun p _ => Complex.normSq_nonneg _
  rw [Complex.normSq_eq_norm_sq] at r0 r1
  have hc := cs2 (Dpl W0 W1) ‖cc W0 W1 G 0‖ ‖cc W0 W1 G 1‖ (nv (rhov W0 W1 0)) (nv (rhov W0 W1 1))
    (nv (yv W0 W1 G 0)) (nv (yv W0 W1 G 1)) hD (norm_nonneg _) (norm_nonneg _) (hn _) (hn _) (hn _) (hn _) r0 r1
  have hnorm : Complex.normSq (cc W0 W1 G 0 + cc W0 W1 G 1) ≤ (‖cc W0 W1 G 0‖ + ‖cc W0 W1 G 1‖) ^ 2 := by
    rw [Complex.normSq_eq_norm_sq]
    exact pow_le_pow_left₀ (norm_nonneg _) (norm_add_le _ _) 2
  have h3 : Dpl W0 W1 * Complex.normSq (cc W0 W1 G 0 + cc W0 W1 G 1) ≤ Dpl W0 W1 * (3 * (nv (yv W0 W1 G 0) + nv (yv W0 W1 G 1))) := by
    calc Dpl W0 W1 * Complex.normSq (cc W0 W1 G 0 + cc W0 W1 G 1)
        ≤ Dpl W0 W1 * (‖cc W0 W1 G 0‖ + ‖cc W0 W1 G 1‖) ^ 2 := mul_le_mul_of_nonneg_left hnorm hD.le
      _ ≤ (nv (rhov W0 W1 0) + nv (rhov W0 W1 1)) * (nv (yv W0 W1 G 0) + nv (yv W0 W1 G 1)) := hc
      _ ≤ (3 * Dpl W0 W1) * (nv (yv W0 W1 G 0) + nv (yv W0 W1 G 1)) :=
          mul_le_mul_of_nonneg_right hsum (add_nonneg (hn _) (hn _))
      _ = _ := by ring
  exact le_of_mul_le_mul_left h3 hD

set_option maxHeartbeats 0 in
