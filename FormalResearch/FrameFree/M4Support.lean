/-- `Q Ω₀ Qᵀ = L` (the table `Lf`). -/
theorem QOQ (Y1 Y2 Y3 : M3) (p q : Fin 8) :
    ∑ r, ∑ s, Qm p r * Qm q s * Om0 Y1 Y2 Y3 r s = Lf Y1 Y2 Y3 p q := by
  fin_cases p <;> fin_cases q <;>
  simp only [Fin.sum_univ_eight, Qm, Om0, Lf, Matrix.cons_val, Fin.isValue, Fin.reduceFinMk, Fin.mk_one, Fin.zero_eta,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one] <;>
  ring_nf <;> simp only [ωsq, ωcu, ω4, ω5, Isq] <;> ring_nf

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- Parseval for the block coordinates (`lem:m4hand-blocks`(a), `eq:m4hand-parseval`). -/
theorem parseval (Y1 Y2 Y3 : M3) :
    ∑ p, ∑ q, Complex.normSq (Om0 Y1 Y2 Y3 p q) = 8 * (fn Y1 + fn Y2 + fn Y3) := by
  apply Complex.ofReal_injective
  push_cast
  simp only [← Complex.mul_conj]
  unfold Om0 fn
  push_cast
  simp only [← Complex.mul_conj]
  simp only [Fin.sum_univ_eight, Fin.sum_univ_three, Matrix.cons_val, map_add, map_mul, map_sub, map_neg, map_div₀,
    map_pow, map_ofNat, map_one, map_zero, conj_omega', Complex.conj_I, Fin.isValue]
  ring_nf
  simp only [ωsq, ωcu, ω4, ω5, Isq]
  ring_nf

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- `det M = −⟨ϖ₊, Ω⟩` (`lem:m4hand-plucker`). -/
theorem detm_eq (W0 W1 : Fin 8 → ℂ) (Y1 Y2 Y3 : M3)
    (hΩ : ∀ p q, W0 p * W1 q - W0 q * W1 p = (1 / 2) * Om0 Y1 Y2 Y3 p q) :
    detm W0 W1 = - pairl Y1 Y2 Y3 := by
  have h1 : detm W0 W1 = ∑ p, ∑ q, conj (ut2 p) * conj (ut1 q) * (W0 p * W1 q - W0 q * W1 p) := by
    unfold detm ipv uu
    simp only [Fin.sum_univ_eight, Matrix.cons_val, Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_fin_one]
    ring
  rw [h1]
  simp only [hΩ]
  unfold pairl Om0 ut1 ut2
  simp only [Fin.sum_univ_eight, Fin.sum_univ_three, Matrix.cons_val, map_add, map_mul, map_sub, map_neg, map_div₀,
    map_pow, map_ofNat, map_one, map_zero, conj_omega', Complex.conj_I, Fin.isValue]
  ring_nf
  simp only [ωsq, ωcu, ω4, ω5, Isq]
  ring_nf

theorem fn_ge_three {Y : M3} (h : bsum Y Y = 3) : 3 ≤ fn Y := by
  have := norm_bil_le Y
  have e : bil Y = bsum Y Y := by
    unfold bil bsum
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
  rw [e, h] at this
  simpa using this

theorem normSq_half : Complex.normSq (1 / 2 : ℂ) = 1 / 4 := by
  rw [Complex.normSq_apply]; simp; norm_num

/-- The determinant law in the relative frames: given the Plücker/bridge relation `W₀∧W₁ = ½ Ω₀(Y)` with
`Y = (Q, P, PQᵀ)` for `P, Q ∈ SO(3,ℂ)`, `det R ≥ |det M|²/9` and the plane is nondegenerate. -/
theorem deficit_of_SO3 (W0 W1 : Fin 8 → ℂ) {P Q : M3} (hP : SO3 P) (hQ : SO3 Q)
    (hΩ : ∀ p q, W0 p * W1 q - W0 q * W1 p = (1 / 2) * Om0 Q P (P * Qᵀ) p q) :
    Complex.normSq (detm W0 W1) ≤ 9 * (nv (qv W0) * nv (qv W1) - Complex.normSq (ipv (qv W0) (qv W1))) ∧
      0 < Dpl W0 W1 := by
  constructor
  · have hw : ∀ p q, qv W0 p * qv W1 q - qv W0 q * qv W1 p = (1 / 2) * Lf Q P (P * Qᵀ) p q := by
      intro p q
      rw [wedge_q]
      simp only [hΩ]
      rw [← QOQ Q P (P * Qᵀ) p q, Finset.mul_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun s _ => ?_
      ring
    have hl := lagr8 (qv W0) (qv W1)
    simp only [hw, Complex.normSq_mul, normSq_half, ← Finset.mul_sum] at hl
    have hF := HF_real Q P (P * Qᵀ)
    have hR := RHSr_nonneg hP hQ
    have hd := detm_eq W0 W1 Q P (P * Qᵀ) hΩ
    rw [hd, Complex.normSq_neg]
    linarith
  · have hD : Dpl W0 W1 = fn Q + fn P + fn (P * Qᵀ) := by
      rw [Dpl_eq]
      simp only [hΩ, Complex.normSq_mul, normSq_half, ← Finset.mul_sum, parseval]
      ring
    rw [hD]
    have := fn_ge_three (tab_B11 hQ)
    have := fn_ge_three (tab_B22 hP)
    have := fn_ge_three (tab_B33 hP hQ)
    linarith

/-- The two conjugate branches: `vt2` for `a = 0`, `vt1` for `a = 1`. -/
def vtt : Fin 2 → Fin 8 → ℂ := ![vt2, vt1]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- Composition of local filters on `ℂ⁸`. -/
theorem act_comp (A B C A' B' C' : Op1) (v : Fin 8 → ℂ) (p : Fin 8) :
    act A B C (act A' B' C' v) p = act (A * A') (B * B') (C * C') v p := by
  fin_cases p <;>
  simp only [act, Fin.sum_univ_eight, Matrix.mul_apply, Fin.sum_univ_two, b0, b1, b2, Matrix.cons_val, Fin.isValue,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, Fin.reduceFinMk, Fin.mk_one, Fin.zero_eta] <;>
  ring

theorem act_lin (A B C : Op1) (c1 c2 : ℂ) (v1 v2 : Fin 8 → ℂ) (p : Fin 8) :
    act A B C (fun r => c1 * v1 r + c2 * v2 r) p = c1 * act A B C v1 p + c2 * act A B C v2 p := by
  simp only [act, Fin.sum_univ_eight]
  ring

/-- Matrix of `h^{⊗3}` on the doublet `S₋`. -/
def Dm (h : Op1) (b' b : Fin 2) : ℂ := act h h h (vtt b) (![3, 4] b')

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- `h^{⊗3}` preserves the doublet `S₋ = span(ṽ₁, ṽ₂)`. -/
theorem cube_span (h : Op1) (b : Fin 2) (p : Fin 8) :
    act h h h (vtt b) p = Dm h 0 b * vtt 0 p + Dm h 1 b * vtt 1 p := by
  unfold Dm
  fin_cases b <;> fin_cases p <;>
  simp only [act, vtt, vt1, vt2, Fin.sum_univ_eight, b0, b1, b2, Matrix.cons_val, Fin.isValue,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, Fin.reduceFinMk, Fin.mk_one, Fin.zero_eta] <;>
  ring_nf <;> simp only [ωsq, ωcu, ω4, ω5] <;> ring_nf

