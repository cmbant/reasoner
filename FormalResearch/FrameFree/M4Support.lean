theorem sum_cons {β : Type*} [AddCommMonoid β] (n : ℕ) (f : (Fin (n + 1) → Fin 2) → β) :
    ∑ x, f x = ∑ a : Fin 2, ∑ y : Fin n → Fin 2, f (Fin.cons a y) := by
  rw [← (Fin.consEquiv (fun _ : Fin (n + 1) => Fin 2)).sum_comp, Fintype.sum_prod_type]
  rfl

theorem cons4 (a b c d : Fin 2) :
    (Fin.cons a (Fin.cons b (Fin.cons c (Fin.cons d (default : Fin 0 → Fin 2)))) : Fin 4 → Fin 2) = ![a, b, c, d] := by
  ext i; fin_cases i <;> rfl

theorem sum_x_eq {β : Type*} [AddCommMonoid β] (f : (Fin 4 → Fin 2) → β) :
    ∑ x, f x = ∑ a : Fin 2, ∑ p : Fin 8, f ![a, b0 p, b1 p, b2 p] := by
  simp only [sum_cons 3, sum_cons 2, sum_cons 1, sum_cons 0]
  simp only [Fin.sum_univ_two, Fin.sum_univ_eight, b0, b1, b2, Matrix.cons_val, Fin.isValue,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, Fin.reduceFinMk, Fin.mk_one, Fin.zero_eta,
    Finset.univ_unique, Finset.sum_singleton, cons4]
  abel

/-- The normalisation `1/√6`. -/
def rr : ℝ := 1 / Real.sqrt 6

theorem rr_sq : rr ^ 2 = 1 / 6 := by
  unfold rr
  rw [div_pow, Real.sq_sqrt (by norm_num)]
  norm_num

theorem M4v_apply (a : Fin 2) (p : Fin 8) :
    M4v ![a, b0 p, b1 p, b2 p] = (rr : ℂ) * uu a p := by
  fin_cases a <;> fin_cases p <;>
  simp [M4v, toN, M4, uu, ut1, ut2, b0, b1, b2, conj_omega, rr]

theorem conj_uu (a : Fin 2) (p : Fin 8) : conj (uu a p) = vtt a p := by
  fin_cases a <;> fin_cases p <;>
  simp [uu, vtt, ut1, ut2, vt1, vt2, conj_omega, map_pow, ← pow_mul, omega_pow4]

theorem conj_M4v_apply (a : Fin 2) (p : Fin 8) :
    conj (M4v ![a, b0 p, b1 p, b2 p]) = (rr : ℂ) * vtt a p := by
  rw [M4v_apply, map_mul, conj_uu, Complex.conj_ofReal]

/-- The filtered conjugate `g·M̄₄`, branch by branch. -/
theorem rot_apply (g : Fin 4 → Op1) (a : Fin 2) (p : Fin 8) :
    rot g (cj M4v) ![a, b0 p, b1 p, b2 p] =
      (rr : ℂ) * ∑ b, g 0 a b * act (g 1) (g 2) (g 3) (vtt b) p := by
  unfold rot
  rw [sum_x_eq]
  simp only [cj, conj_M4v_apply, Fin.prod_univ_four, Matrix.cons_val]
  simp only [act, Fin.sum_univ_two, Fin.sum_univ_eight, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_fin_one, Fin.isValue]
  ring

/-- `Wc g b`: the filtered conjugate branch on qubits `2,3,4`. -/
def Wc (g : Fin 4 → Op1) (b : Fin 2) : Fin 8 → ℂ := act (g 1) (g 2) (g 3) (vtt b)

/-- `⟨M₄, g·M̄₄⟩ = (1/6) Σ_{a,b} g₁(a,b)⟨ũ_a, W_b⟩`. -/
theorem ip_rot (g : Fin 4 → Op1) :
    ip M4v (rot g (cj M4v)) = (rr : ℂ) ^ 2 * ∑ a, ∑ b, g 0 a b * ipv (uu a) (Wc g b) := by
  unfold ip
  rw [sum_x_eq]
  simp only [conj_M4v_apply, rot_apply, ipv, conj_uu, Wc, Fin.sum_univ_two, Fin.sum_univ_eight]
  ring

/-- `‖g·M̄₄‖² = (1/6) Σ_a ‖Σ_b g₁(a,b) W_b‖²`. -/
theorem nsq_rot (g : Fin 4 → Op1) :
    nsq (rot g (cj M4v)) = rr ^ 2 * ∑ a, nv (fun p => ∑ b, g 0 a b * Wc g b p) := by
  unfold nsq nv
  rw [sum_x_eq]
  simp only [rot_apply, Wc, Complex.normSq_mul, Complex.normSq_ofReal, Fin.sum_univ_two, Fin.sum_univ_eight]
  ring

/-- Reduction of `h_C` to the relative frames (proof of `thm:m4support`: collective filters preserve `S_±`). -/
theorem reduce_hC (A B C : Op1) (hC : C.det = 1) (b : Fin 2) (p : Fin 8) :
    act A B C (vtt b) p =
      Dm C 0 b * act (A * C⁻¹) (B * C⁻¹) 1 (vtt 0) p + Dm C 1 b * act (A * C⁻¹) (B * C⁻¹) 1 (vtt 1) p := by
  have hinv : C⁻¹ * C = 1 := Matrix.nonsing_inv_mul C (by rw [hC]; exact isUnit_one)
  have e1 : act A B C (vtt b) p = act (A * C⁻¹) (B * C⁻¹) 1 (act C C C (vtt b)) p := by
    rw [act_comp, Matrix.mul_assoc, hinv, Matrix.mul_one, Matrix.mul_assoc, hinv, Matrix.mul_one, Matrix.one_mul]
  have e2 : act C C C (vtt b) = fun r => Dm C 0 b * vtt 0 r + Dm C 1 b * vtt 1 r := funext (cube_span C b)
  rw [e1, e2, act_lin]

theorem det_mul_inv (A C : Op1) (hA : A.det = 1) (hC : C.det = 1) : (A * C⁻¹).det = 1 := by
  rw [Matrix.det_mul, Matrix.det_nonsing_inv, hA, hC]; simp

/-- The main inequality of `thm:m4support`: `|⟨M₄, g·M̄₄⟩|² ≤ ½ ‖g·M̄₄‖²` for every `g ∈ SL(2,ℂ)⁴`. -/
theorem main_ineq (g : Fin 4 → Op1) (hg : ∀ i, (g i).det = 1) :
    Complex.normSq (ip M4v (rot g (cj M4v))) ≤ (1 / 2) * nsq (rot g (cj M4v)) := by
  have hC : (g 3).det = 1 := hg 3
  have hdA : (g 1 * (g 3)⁻¹).det = 1 := det_mul_inv _ _ (hg 1) hC
  have hdB : (g 2 * (g 3)⁻¹).det = 1 := det_mul_inv _ _ (hg 2) hC
  set A' := g 1 * (g 3)⁻¹ with hA'
  set B' := g 2 * (g 3)⁻¹ with hB'
  have hP : SO3 (Oad A') := SO3_Oad _ hdA
  have hQ : SO3 (Oad B') := SO3_Oad _ hdB
  have hΩ : ∀ p q, W0 A' B' p * W1 A' B' q - W0 A' B' q * W1 A' B' p =
      (1 / 2) * Om0 (Oad B') (Oad A') (Oad A' * (Oad B')ᵀ) p q := by
    intro p q
    have := bridge A' B' p q
    rwa [hdA, hdB, one_smul, one_smul] at this
  have hdef := deficit_of_SO3 (W0 A' B') (W1 A' B') hP hQ hΩ
  set G' : Fin 2 → Fin 2 → ℂ := fun a b' => g 0 a 0 * Dm (g 3) b' 0 + g 0 a 1 * Dm (g 3) b' 1 with hG'
  have key := plane_main (W0 A' B') (W1 A' B') G' hdef.1 hdef.2
  have hW : ∀ b p, Wc g b p = Dm (g 3) 0 b * W0 A' B' p + Dm (g 3) 1 b * W1 A' B' p := by
    intro b p
    exact reduce_hC (g 1) (g 2) (g 3) hC b p
  have hc : ∑ a, ∑ b, g 0 a b * ipv (uu a) (Wc g b) = ∑ a, cc (W0 A' B') (W1 A' B') G' a := by
    simp only [ipv, hW, cc, hG', Fin.sum_univ_two, Fin.sum_univ_eight]
    ring
  have hy : ∀ a, nv (fun p => ∑ b, g 0 a b * Wc g b p) = nv (yv (W0 A' B') (W1 A' B') G' a) := by
    intro a
    unfold nv yv
    refine Finset.sum_congr rfl fun p _ => ?_
    simp only [hW, hG', Fin.sum_univ_two]
    congr 1
    ring
  rw [ip_rot, nsq_rot, hc, Complex.normSq_mul]
  simp only [hy]
  have h2 : Complex.normSq ((rr : ℂ) ^ 2) = (1 / 6) ^ 2 := by
    rw [map_pow, Complex.normSq_ofReal]
    have := rr_sq
    nlinarith
  rw [h2, rr_sq]
  nlinarith


/-- `thm:m4support`, upper half: `F_C(M₄) ≤ 1/2`. -/
theorem FCΘ_M4v_le : FCΘ M4v ≤ 1 / 2 := by
  rw [FCΘ_eq_FC_cj]
  unfold FC
  refine Real.sSup_le ?_ (by norm_num)
  rintro r ⟨g, hg, hne, rfl⟩
  have hpos : 0 < nsq (rot g (cj M4v)) := lt_of_le_of_ne (nsq_nonneg' _) (Ne.symm hne)
  rw [div_le_iff₀ hpos]
  exact main_ineq g hg

/-- `thm:m4support`: `F_C(M₄) = 1/2`. -/
theorem FCΘ_M4v_eq : FCΘ M4v = 1 / 2 :=
  le_antisymm FCΘ_M4v_le (half_le_FCΘ_M4)

/-- `F_C(M₄^{⊗(m+1)}) = 2^{-(m+1)}` exactly. -/
theorem FCΘ_M4pow_eq_half_pow (m : ℕ) : FCΘ (M4pow m) = (1 / 2 : ℝ) ^ (m + 1) :=
  FCΘ_M4pow_eq FCΘ_M4v_le m

/-- The exponent window for `M₄`-powers, with the heavy half of `thm:m4support` discharged. -/
theorem M4pow_window_of_h49 (h49 : FKΘ M4v = 4 / 9) (m : ℕ) :
    -Real.log (FCΘ (M4pow m)) = (m + 1) * Real.log 2 ∧
      (m + 1) * Real.log 2 < CK (M4pow m) :=
  M4pow_window FCΘ_M4v_le h49 m

