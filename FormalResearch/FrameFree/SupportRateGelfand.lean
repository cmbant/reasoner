import FormalResearch.FrameFree.SupportRate
import Mathlib.Analysis.CStarAlgebra.GelfandDuality
import Mathlib.Analysis.Normed.Algebra.GelfandFormula
import Mathlib.Topology.Algebra.Algebra
import Mathlib.Analysis.Normed.Ring.Lemmas

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped ComplexConjugate InnerProductSpace BigOperators IsMulCommutative

/-!
# Support rate, abstract Gelfand step

Namespace `FormalResearch.FrameFree.SupportRate`.  For a complex Banach algebra `B` and pairwise commuting
`s_j ∈ B` (`j ∈ N`), the closed algebra `Alg s` generated by the `s_j` is a commutative Banach algebra; the
relation elements `ThB s k r = Σ_α r_α s_{α₁} ⋯ s_{α_k}` vanish for `r ∈ J_k`, the characters of `Alg s` give
points `z = conj (χ s_j)` with `z^{⊗k} ∈ J_k^⊥`, and the Gelfand spectral-radius formula bounds
`‖(Σ x_j s_j)^n‖^{1/n}` by the supremum of `|⟨x,z⟩|` over those points.
-/

namespace FormalResearch.FrameFree.SupportRate

variable {N : Type*} [Fintype N] [DecidableEq N]
variable {B : Type*} [NormedRing B] [NormedAlgebra ℂ B] [CompleteSpace B] (s : N → B)

/-- `Θ_k(r) = Σ_α r_α s_{α₁} ⋯ s_{α_k}` by slice recursion. -/
noncomputable def ThB : (k : ℕ) → Eg N k → B
  | 0, r => (r (fun i => i.elim0)) • (1 : B)
  | k + 1, r => ∑ j, s j * ThB k (slice j r)

/-- The closed subalgebra generated by the `s_j`. -/
noncomputable def AlgB : Subalgebra ℂ B := (Algebra.adjoin ℂ (Set.range s)).topologicalClosure

variable {s}

theorem AlgB_comm (hc : ∀ i j, s i * s j = s j * s i) : IsMulCommutative (AlgB s) := by
  have h : (Set.range s).Pairwise Commute := by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ -
    exact hc i j
  have := Algebra.isMulCommutative_adjoin ℂ h
  exact inferInstanceAs (IsMulCommutative (Algebra.adjoin ℂ (Set.range s)).topologicalClosure)

section Abs

variable [IsMulCommutative (AlgB s)]

noncomputable instance instNCR : NormedCommRing (AlgB s) :=
  { (inferInstance : NormedRing (AlgB s)) with mul_comm := fun a b => mul_comm a b }

instance instCS : CompleteSpace (AlgB s) :=
  (Algebra.adjoin ℂ (Set.range s)).isClosed_topologicalClosure.completeSpace_coe

theorem sA_mem (j : N) : s j ∈ AlgB s :=
  Subalgebra.le_topologicalClosure _ (Algebra.subset_adjoin ⟨j, rfl⟩)

/-- Generator as element of the Banach algebra. -/
noncomputable def sA (j : N) : AlgB s := ⟨s j, sA_mem j⟩

theorem TA_mem (c : V N) : ∑ j, c j • s j ∈ AlgB s :=
  Subalgebra.sum_mem _ fun j _ => Subalgebra.smul_mem _ (sA_mem j) _

/-- `Σ c_j s_j` as element of the Banach algebra. -/
noncomputable def TA (c : V N) : AlgB s := ⟨∑ j, c j • s j, TA_mem c⟩

/-- `Θ_k(r)` as element of the Banach algebra. -/
noncomputable def ThA : (k : ℕ) → Eg N k → AlgB s
  | 0, r => (r (fun i => i.elim0)) • (1 : AlgB s)
  | k + 1, r => ∑ j, sA j * ThA k (slice j r)

theorem ThA_coe : ∀ (k : ℕ) (r : Eg N k), ((ThA k r : AlgB s) : B) = ThB s k r := by
  intro k
  induction k with
  | zero => intro r; rfl
  | succ k ih =>
    intro r
    show ((∑ j, sA j * ThA k (slice j r) : AlgB s) : B) = ∑ j, s j * ThB s k (slice j r)
    rw [AddSubmonoidClass.coe_finsetSum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Subalgebra.coe_mul, ih]
    rfl

theorem TA_eq_sum (c : V N) : TA (s := s) c = ∑ j, c j • sA (s := s) j := by
  apply Subtype.ext
  rw [AddSubmonoidClass.coe_finsetSum]
  simp only [Subalgebra.coe_smul]
  rfl

/-- The point of `ℂ^N` attached to a character. -/
noncomputable def zχ (χ : WeakDual.characterSpace ℂ (AlgB s)) : V N :=
  WithLp.toLp 2 fun j => conj (χ (sA j))

theorem chi_TA (χ : WeakDual.characterSpace ℂ (AlgB s)) (c : V N) :
    χ (TA c) = ∑ j, c j * χ (sA j) := by
  rw [TA_eq_sum, map_sum]
  simp [map_smul]

theorem chi_ThA (χ : WeakDual.characterSpace ℂ (AlgB s)) :
    ∀ (k : ℕ) (r : Eg N k), χ (ThA k r) = ⟪pw (zχ χ) k, r⟫_ℂ := by
  intro k
  induction k with
  | zero => intro r; simp [ThA, inner_pw_zero]
  | succ k ih =>
    intro r
    rw [inner_pw_succ]
    simp only [ThA, map_sum, map_mul, ih]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp [zχ]

section Main

variable (J : ∀ k, Submodule ℂ (Eg N k))

theorem pw_zχ_mem (hJ : ∀ k (r : Eg N k), r ∈ J k → ThB s k r = 0)
    (χ : WeakDual.characterSpace ℂ (AlgB s)) (k : ℕ) : pw (zχ χ) k ∈ (J k)ᗮ := by
  rw [Submodule.mem_orthogonal]
  intro r hr
  have h := chi_ThA χ k r
  have h0 : ThA (s := s) k r = 0 := Subtype.ext (by rw [ThA_coe]; exact hJ k r hr)
  rw [h0, map_zero] at h
  rw [← inner_conj_symm, ← h, map_zero]

theorem norm_chi_TA_le (hnorm : ∀ c : V N, ‖∑ j, c j • s j‖ ≤ ‖c‖) (h1 : ‖(1 : B)‖ ≤ 1)
    (χ : WeakDual.characterSpace ℂ (AlgB s)) (c : V N) : ‖χ (TA c)‖ ≤ ‖c‖ := by
  have h := AlgHom.norm_apply_le_self_mul_norm_one χ (TA c)
  have h2 : ‖(TA c : AlgB s)‖ ≤ ‖c‖ := hnorm c
  have h3 : ‖(1 : AlgB s)‖ ≤ 1 := h1
  calc ‖χ (TA c)‖ ≤ ‖(TA c : AlgB s)‖ * ‖(1 : AlgB s)‖ := h
    _ ≤ ‖c‖ * 1 := mul_le_mul h2 h3 (norm_nonneg _) (norm_nonneg _)
    _ = ‖c‖ := mul_one _

theorem norm_zχ_le (hnorm : ∀ c : V N, ‖∑ j, c j • s j‖ ≤ ‖c‖) (h1 : ‖(1 : B)‖ ≤ 1)
    (χ : WeakDual.characterSpace ℂ (AlgB s)) : ‖zχ χ‖ ≤ 1 := by
  have h := norm_chi_TA_le hnorm h1 χ (zχ χ)
  rw [chi_TA] at h
  have e : ∑ j, (zχ χ) j * χ (sA j) = ((‖zχ χ‖ ^ 2 : ℝ) : ℂ) := by
    rw [EuclideanSpace.norm_sq_eq]
    push_cast
    refine Finset.sum_congr rfl fun j _ => ?_
    have hj : (zχ χ) j = conj (χ (sA j)) := rfl
    rw [hj, Complex.conj_mul', Complex.norm_conj]
  rw [e, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)] at h
  nlinarith [norm_nonneg (zχ χ)]

theorem norm_chi_TA_le_sqrt (hnorm : ∀ c : V N, ‖∑ j, c j • s j‖ ≤ ‖c‖) (h1 : ‖(1 : B)‖ ≤ 1)
    (hJ : ∀ k (r : Eg N k), r ∈ J k → ThB s k r = 0) (x : V N) (F : ℝ) (hF0 : 0 ≤ F)
    (hF : ∀ z : V N, (∀ k, pw z k ∈ (J k)ᗮ) → ‖⟪x, z⟫_ℂ‖ ^ 2 ≤ F * ‖z‖ ^ 2)
    (χ : WeakDual.characterSpace ℂ (AlgB s)) : ‖χ (TA x)‖ ≤ Real.sqrt F := by
  have hz := hF (zχ χ) (pw_zχ_mem J hJ χ)
  have hn := norm_zχ_le hnorm h1 χ
  have e : χ (TA x) = conj ⟪x, zχ χ⟫_ℂ := by
    rw [chi_TA, inner_V, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp [zχ]
  rw [e, Complex.norm_conj]
  refine Real.le_sqrt_of_sq_le ?_
  calc ‖⟪x, zχ χ⟫_ℂ‖ ^ 2 ≤ F * ‖zχ χ‖ ^ 2 := hz
    _ ≤ F * 1 := mul_le_mul_of_nonneg_left (by nlinarith [norm_nonneg (zχ χ)]) hF0
    _ = F := mul_one _

/-- **Gelfand step.**  If every point `z` with `z^{⊗k} ∈ J_k^⊥` satisfies `|⟨x,z⟩|² ≤ F ‖z‖²`, then
`‖(Σ x_j s_j)^n‖ ≤ (√c)^n` eventually, for every `c > F`. -/
theorem eventually_norm_pow_le [Nontrivial B] (hnorm : ∀ c : V N, ‖∑ j, c j • s j‖ ≤ ‖c‖) (h1 : ‖(1 : B)‖ ≤ 1)
    (hJ : ∀ k (r : Eg N k), r ∈ J k → ThB s k r = 0) (x : V N) (F : ℝ) (hF0 : 0 ≤ F)
    (hF : ∀ z : V N, (∀ k, pw z k ∈ (J k)ᗮ) → ‖⟪x, z⟫_ℂ‖ ^ 2 ≤ F * ‖z‖ ^ 2) {c : ℝ} (hc : F < c) :
    ∀ᶠ n : ℕ in Filter.atTop, ‖(∑ j, x j • s j) ^ n‖ ≤ (Real.sqrt c) ^ n := by
  have hc0 : 0 < c := lt_of_le_of_lt hF0 hc
  have hsq : Real.sqrt F < Real.sqrt c := Real.sqrt_lt_sqrt hF0 hc
  set a : AlgB s := TA x with ha
  set r : NNReal := ⟨Real.sqrt c, Real.sqrt_nonneg _⟩ with hr
  have hρ : spectralRadius ℂ a < r := by
    refine spectrum.spectralRadius_lt_of_forall_lt a fun k hk => ?_
    obtain ⟨χ, rfl⟩ := WeakDual.CharacterSpace.mem_spectrum_iff_exists.1 hk
    rw [← NNReal.coe_lt_coe]
    exact lt_of_le_of_lt (norm_chi_TA_le_sqrt J hnorm h1 hJ x F hF0 hF χ) hsq
  have ht := spectrum.pow_norm_pow_one_div_tendsto_nhds_spectralRadius a
  filter_upwards [ht.eventually_lt_const hρ, Filter.eventually_ge_atTop 1] with n hn hn1
  have hn0 : n ≠ 0 := by omega
  have hrpos : (0 : ℝ) < (r : ℝ) := Real.sqrt_pos.2 hc0
  have h2 : ‖a ^ n‖ ^ ((n : ℝ)⁻¹) < r := by
    refine (ENNReal.ofReal_lt_ofReal_iff hrpos).1 ?_
    simpa [ENNReal.ofReal_coe_nnreal, one_div] using hn
  have h3 : ‖a ^ n‖ = (‖a ^ n‖ ^ ((n : ℝ)⁻¹)) ^ n := by
    rw [Real.rpow_inv_natCast_pow (norm_nonneg _) hn0]
  have h4 : ‖a ^ n‖ ≤ (Real.sqrt c) ^ n := by
    rw [h3]
    exact pow_le_pow_left₀ (by positivity) h2.le n
  calc ‖(∑ j, x j • s j) ^ n‖ = ‖a ^ n‖ := by
        show _ = ‖((a ^ n : AlgB s) : B)‖
        rw [Subalgebra.coe_pow]; rfl
    _ ≤ _ := h4

end Main

end Abs

end FormalResearch.FrameFree.SupportRate
