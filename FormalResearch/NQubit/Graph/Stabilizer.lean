module

public import FormalResearch.NQubit.Graph.CutPurity
public import FormalResearch.NQubit.Shadow.Stabilizer

/-!
# Graph states are stabilizer states

For a simple graph `Γ` (symmetric, loop-free `Bool` adjacency) the normalised graph state
`graphStateNorm Γ` is a stabilizer state (`graphStateNorm_isStabilizerState`).

The stabilizer group is the usual one, generated by `K_i = X_i ∏_{j ~ i} Z_j`.  Written as Pauli words up to phase
it is `{ P_S : S ⊆ V }`, where `P_S` has at vertex `i` the letter with `x`-part `[i ∈ S]` and `z`-part
`∑_{j ∈ S} Γ_ij` (`ZMod 2`), that is `P_S = ∏_{i ∈ S} K_i` (`letter`, `pword`, `nbr`; here `S` is encoded by its
indicator `s : Fin n → ZMod 2`, `graphStabWords Γ = {pword s (nbr Γ s) | s}`).

* `rot_pword_graph`: `P_s |G⟩ = c_s |G⟩` with a unimodular scalar `c_s` (`pauliSU` letters are the `SU(2)`
  representatives `{1, -iσₓ, -iσ_y, -iσ_z}`; each letter is `cc · (-1)^{t x} · [y = x + s]` entrywise,
  `pauliSU_letter`), hence `pauliSq = 1` (`pauliSq_graphStateNorm`);
* `graphStabWords_isStabilizerGroup`: `s ↦ P_s` is injective (so `2^n` words), `P_s P_{s'} = P_{s+s'}` up to phase
  (`pmulW_pword`, `nbr_add`), and the words pairwise commute: the number of anticommuting positions is even because the
  symplectic form `Σ_i (s_i t'_i + t_i s'_i)` of `(s, Γ s)` and `(s', Γ s')` vanishes for symmetric `Γ`
  (`sum_symp_nbr`);
* `IsStabilizerState.weightEnum_nat`/`shadowCoeff_nat` apply: `weightEnum_graphStateNorm_nat`,
  `shadowCoeff_graphStateNorm_nat`.

Everything is **proved** for every `n` and every simple graph.
-/

@[expose] public section


open scoped ComplexConjugate BigOperators
open FormalResearch.NQubit FormalResearch.NQubit.Pauli FormalResearch.NQubit.Shadow

namespace FormalResearch.NQubit.Graph

variable {n : ℕ}

/-! ### Pauli letters as `𝔽₂²` -/

/-- The Pauli letter with `x`-part `s` and `z`-part `t` (`0 = I`, `1 = X`, `2 = Y`, `3 = Z`). -/
def letter (s t : ZMod 2) : Fin 4 := ![![0, 3], ![1, 2]] s t

theorem letter_inj (s t s' t' : ZMod 2) (h : letter s t = letter s' t') : s = s' ∧ t = t' := by
  revert s t s' t'; decide

theorem pmul_letter (s t s' t' : ZMod 2) : pmul (letter s t) (letter s' t') = letter (s + s') (t + t') := by
  revert s t s' t'; decide

/-- Two letters anticommute exactly when their symplectic product `s t' + t s'` is `1`. -/
theorem acomm_letter (s t s' t' : ZMod 2) :
    (if acomm (letter s t) (letter s' t') then (1 : ZMod 2) else 0) = s * t' + t * s' := by
  revert s t s' t'; decide

/-- The Pauli word with `x`-part `s` and `z`-part `t`. -/
def pword (s t : Fin n → ZMod 2) : Fin n → Fin 4 := fun i => letter (s i) (t i)

theorem pmulW_pword (s t s' t' : Fin n → ZMod 2) :
    pmulW (pword s t) (pword s' t') = pword (s + s') (t + t') := by
  funext i; exact pmul_letter _ _ _ _

theorem pword_inj {s t s' t' : Fin n → ZMod 2} (h : pword s t = pword s' t') : s = s' := by
  funext i; exact (letter_inj _ _ _ _ (congrFun h i)).1

/-- Even number of anticommuting positions from a vanishing symplectic form. -/
theorem even_nanti_pword (s t s' t' : Fin n → ZMod 2) (h : ∑ i, (s i * t' i + t i * s' i) = 0) :
    Even (nanti (pword s t) (pword s' t')) := by
  rw [← ZMod.natCast_eq_zero_iff_even]
  unfold nanti
  rw [Finset.card_filter]
  push_cast
  exact (Finset.sum_congr rfl fun i _ => acomm_letter (s i) (t i) (s' i) (t' i)).trans h

/-! ### Neighbourhood parities -/

/-- `(Γ a)_i = Σ_j Γ_ij a_j` over `𝔽₂`. -/
def nbr (Γ : Fin n → Fin n → Bool) (a : Fin n → ZMod 2) (i : Fin n) : ZMod 2 :=
  ∑ j, if Γ i j = true then a j else 0

theorem nbr_add (Γ : Fin n → Fin n → Bool) (a b : Fin n → ZMod 2) : nbr Γ (a + b) = nbr Γ a + nbr Γ b := by
  funext i
  simp only [nbr, Pi.add_apply, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  split_ifs <;> simp

/-- The symplectic form of `(a, Γ a)` and `(b, Γ b)` vanishes for symmetric `Γ`. -/
theorem sum_symp_nbr (Γ : Fin n → Fin n → Bool) (hsym : ∀ i j, Γ i j = Γ j i) (a b : Fin n → ZMod 2) :
    ∑ i, (a i * nbr Γ b i + nbr Γ a i * b i) = 0 := by
  have h2 : ∑ i, nbr Γ a i * b i = ∑ i, a i * nbr Γ b i := by
    unfold nbr
    simp only [Finset.mul_sum, Finset.sum_mul, mul_ite, ite_mul, mul_zero, zero_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    rw [hsym j i, mul_comm]
  rw [Finset.sum_add_distrib, h2]
  generalize ∑ i, a i * nbr Γ b i = u
  fin_cases u <;> decide

/-! ### The quadratic form on `𝔽₂`-vectors -/

/-- `Σ_{i<j} Γ_ij a_i a_j` for `a : Fin n → ZMod 2`; `qf Γ x = qfz Γ (zx ∘ x)`. -/
def qfz (Γ : Fin n → Fin n → Bool) (a : Fin n → ZMod 2) : ZMod 2 :=
  ∑ i, ∑ j, if i < j ∧ Γ i j = true then a i * a j else 0

theorem qf_eq_qfz (Γ : Fin n → Fin n → Bool) (x : Cfg n) : qf Γ x = qfz Γ (fun i => zx (x i)) := rfl

/-- The cross term of the quadratic form: `Σ_{i<j} Γ_ij (a_i b_j + b_i a_j) = Σ_i b_i (Γ a)_i`. -/
theorem cross_term (Γ : Fin n → Fin n → Bool) (hsym : ∀ i j, Γ i j = Γ j i) (hirr : ∀ i, Γ i i = false)
    (a b : Fin n → ZMod 2) :
    (∑ i, ∑ j, if i < j ∧ Γ i j = true then a i * b j + b i * a j else 0) = ∑ i, b i * nbr Γ a i := by
  have h1 : ∀ i j, (if i < j ∧ Γ i j = true then a i * b j + b i * a j else 0)
      = (if i < j ∧ Γ i j = true then b i * a j else 0)
        + (if i < j ∧ Γ i j = true then b j * a i else 0) := by
    intro i j; split_ifs <;> simp [mul_comm, add_comm]
  have h2 : ∀ i, b i * nbr Γ a i = ∑ j, ((if i < j ∧ Γ i j = true then b i * a j else 0)
        + (if j < i ∧ Γ i j = true then b i * a j else 0)) := by
    intro i
    unfold nbr
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    by_cases hij : i = j
    · subst hij; simp [hirr]
    · rcases lt_or_gt_of_ne hij with h | h
      · simp [h, not_lt.mpr h.le]
      · simp [h, not_lt.mpr h.le]
  simp_rw [h1, h2, Finset.sum_add_distrib]
  congr 1
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  rw [hsym j i]

theorem qfz_add (Γ : Fin n → Fin n → Bool) (hsym : ∀ i j, Γ i j = Γ j i) (hirr : ∀ i, Γ i i = false)
    (a b : Fin n → ZMod 2) :
    qfz Γ (a + b) = qfz Γ a + qfz Γ b + ∑ i, b i * nbr Γ a i := by
  rw [← cross_term Γ hsym hirr]
  unfold qfz
  simp only [Pi.add_apply, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
  split_ifs <;> ring

/-! ### Letters of `pauliSU` -/

/-- The bit `x` flipped when `s = 1`. -/
def fl (s : ZMod 2) (x : Fin 2) : Fin 2 := if s = 1 then 1 - x else x

theorem zx_fl (s : ZMod 2) (x : Fin 2) : zx (fl s x) = s + zx x := by
  revert s x; unfold fl zx; decide

/-- The phase of the letter `(s, t)`. -/
def cc (s t : ZMod 2) : ℂ := ![![1, -Complex.I], ![-Complex.I, -1]] s t

theorem normSq_cc (s t : ZMod 2) : Complex.normSq (cc s t) = 1 := by
  fin_cases s <;> fin_cases t <;> simp [cc]

theorem zmod2_cases : ∀ s : ZMod 2, s = 0 ∨ s = 1 := by decide

theorem letter_00 : letter 0 0 = 0 := rfl
theorem letter_01 : letter 0 1 = 3 := rfl
theorem letter_10 : letter 1 0 = 1 := rfl
theorem letter_11 : letter 1 1 = 2 := rfl
theorem cc_00 : cc 0 0 = 1 := rfl
theorem cc_01 : cc 0 1 = -Complex.I := rfl
theorem cc_10 : cc 1 0 = -Complex.I := rfl
theorem cc_11 : cc 1 1 = -1 := rfl

/-- Entrywise form of the `SU(2)` Pauli letters. -/
theorem pauliSU_letter (s t : ZMod 2) (x y : Fin 2) :
    pauliSU (letter s t) x y = cc s t * chi (t * zx x) * (if y = fl s x then 1 else 0) := by
  rcases zmod2_cases s with rfl | rfl <;> rcases zmod2_cases t with rfl | rfl <;>
    fin_cases x <;> fin_cases y <;>
    simp [pauliSU, letter_00, letter_01, letter_10, letter_11, cc_00, cc_01, cc_10, cc_11, chi, fl, zx]

theorem rot_pword (s t : Fin n → ZMod 2) (ψ : Ψ n) (x : Cfg n) :
    rot (fun i => pauliSU (pword s t i)) ψ x
      = (∏ i, cc (s i) (t i)) * chi (∑ i, t i * zx (x i)) * ψ (fun i => fl (s i) (x i)) := by
  unfold rot
  have h : ∀ y : Cfg n, (∏ i, pauliSU (pword s t i) (x i) (y i)) =
      (∏ i, cc (s i) (t i)) * chi (∑ i, t i * zx (x i)) *
        (if y = fun i => fl (s i) (x i) then 1 else 0) := by
    intro y
    simp only [pword, pauliSU_letter]
    rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, ← chi_sum, Finset.prod_boole]
    congr 2
    simp [funext_iff]
  simp_rw [h]
  simp [mul_assoc, ite_mul, Finset.sum_ite_eq']

/-- **A Pauli word of the stabilizer group fixes the graph state up to a unimodular scalar**: for
`ψ = r • |G⟩`, `P_{(s, Γ s)} ψ = (∏ cc · (-1)^{q(s)}) ψ`. -/
theorem rot_pword_graph (Γ : Fin n → Fin n → Bool) (hsym : ∀ i j, Γ i j = Γ j i)
    (hirr : ∀ i, Γ i i = false) (r : ℂ) (s : Fin n → ZMod 2) :
    rot (fun i => pauliSU (pword s (nbr Γ s) i)) (fun x => r * chi (qf Γ x))
      = ((∏ i, cc (s i) (nbr Γ s i)) * chi (qfz Γ s)) • (fun x => r * chi (qf Γ x)) := by
  funext x
  rw [rot_pword]
  have hz : (fun i => zx (fl (s i) (x i))) = s + fun i => zx (x i) := by
    funext i; exact zx_fl _ _
  have hq : qf Γ (fun i => fl (s i) (x i)) =
      qfz Γ s + qf Γ x + ∑ i, zx (x i) * nbr Γ s i := by
    rw [qf_eq_qfz, hz, qfz_add Γ hsym hirr]
    rfl
  rw [hq, chi_add, chi_add]
  have hA : (∑ i, zx (x i) * nbr Γ s i) = ∑ i, nbr Γ s i * zx (x i) :=
    Finset.sum_congr rfl fun i _ => mul_comm _ _
  rw [hA]
  have := chi_mul_self (∑ i, nbr Γ s i * zx (x i))
  simp only [Pi.smul_apply, smul_eq_mul]
  linear_combination ((∏ i, cc (s i) (nbr Γ s i)) * chi (qfz Γ s) * r * chi (qf Γ x)) * this

/-- **`⟨P⟩² = 1`** on the words `P_s` for the normalised graph state. -/
theorem pauliSq_graphStateNorm (Γ : Fin n → Fin n → Bool) (hsym : ∀ i j, Γ i j = Γ j i)
    (hirr : ∀ i, Γ i i = false) (s : Fin n → ZMod 2) :
    pauliSq (graphStateNorm Γ) (pword s (nbr Γ s)) = 1 := by
  have hψ : graphStateNorm Γ = fun x => (((Real.sqrt ((2 : ℝ) ^ n))⁻¹ : ℝ) : ℂ) * chi (qf Γ x) := rfl
  have hp : pexp (graphStateNorm Γ) (pword s (nbr Γ s))
      = ((∏ i, cc (s i) (nbr Γ s i)) * chi (qfz Γ s)) * (nsq (graphStateNorm Γ) : ℂ) := by
    unfold pexp
    rw [hψ, rot_pword_graph Γ hsym hirr, ← hψ, ← ip_self]
    unfold ip
    simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
    exact Finset.sum_congr rfl fun x _ => by ring
  unfold pauliSq
  rw [hp, Complex.normSq_mul, Complex.normSq_mul, nsq_graphStateNorm, Complex.normSq_ofReal,
    chi_normSq, map_prod]
  simp [normSq_cc]

/-! ### The stabilizer group -/

/-- The stabilizer group of the graph state as Pauli words: `P_s` has `x`-part `s` and `z`-part `Γ s`
(`P_S = ∏_{i ∈ S} K_i` for `s = 1_S`), `K_i = X_i ∏_{j ~ i} Z_j`. -/
def graphStabWords (Γ : Fin n → Fin n → Bool) : Finset (Fin n → Fin 4) :=
  Finset.univ.image fun s : Fin n → ZMod 2 => pword s (nbr Γ s)

theorem graphStabWords_isStabilizerGroup (Γ : Fin n → Fin n → Bool) (hsym : ∀ i j, Γ i j = Γ j i) :
    IsStabilizerGroup (graphStabWords Γ) where
  card := by
    unfold graphStabWords
    rw [Finset.card_image_of_injective _ fun s s' h => pword_inj h]
    simp [ZMod.card]
  mul_mem := by
    intro a ha b hb
    obtain ⟨s, -, rfl⟩ := Finset.mem_image.mp ha
    obtain ⟨s', -, rfl⟩ := Finset.mem_image.mp hb
    refine Finset.mem_image.mpr ⟨s + s', Finset.mem_univ _, ?_⟩
    rw [pmulW_pword, nbr_add]
  comm := by
    intro a ha b hb
    obtain ⟨s, -, rfl⟩ := Finset.mem_image.mp ha
    obtain ⟨s', -, rfl⟩ := Finset.mem_image.mp hb
    exact even_nanti_pword _ _ _ _ (sum_symp_nbr Γ hsym s s')

/-- **Graph states are stabilizer states.** For every simple graph, the normalised graph state
`graphStateNorm Γ = 2^{-n/2} Σ_x (-1)^{Σ_{i<j} Γ_ij x_i x_j} |x⟩` has `nsq = 1` and `⟨P⟩² = 1` on the `2^n` pairwise
commuting words `P_S = ∏_{i ∈ S} K_i` (`graphStabWords`), `K_i = X_i ∏_{j ~ i} Z_j`. -/
theorem graphStateNorm_isStabilizerState (Γ : Fin n → Fin n → Bool) (hsym : ∀ i j, Γ i j = Γ j i)
    (hirr : ∀ i, Γ i i = false) : IsStabilizerState (graphStateNorm Γ) :=
  ⟨nsq_graphStateNorm Γ, graphStabWords Γ, graphStabWords_isStabilizerGroup Γ hsym, fun a ha => by
    obtain ⟨s, -, rfl⟩ := Finset.mem_image.mp ha
    exact pauliSq_graphStateNorm Γ hsym hirr s⟩

/-- The Pauli weight enumerator of a graph state has non-negative integer coefficients. -/
theorem weightEnum_graphStateNorm_nat (Γ : Fin n → Fin n → Bool) (hsym : ∀ i j, Γ i j = Γ j i)
    (hirr : ∀ i, Γ i i = false) (j : ℕ) : ∃ m : ℕ, weightEnum (graphStateNorm Γ) j = m :=
  (graphStateNorm_isStabilizerState Γ hsym hirr).weightEnum_nat j

/-- The shadow enumerator of a graph state has non-negative integer coefficients. -/
theorem shadowCoeff_graphStateNorm_nat (Γ : Fin n → Fin n → Bool) (hsym : ∀ i j, Γ i j = Γ j i)
    (hirr : ∀ i, Γ i i = false) (i : ℕ) : ∃ m : ℕ, shadowCoeff (graphStateNorm Γ) i = m :=
  (graphStateNorm_isStabilizerState Γ hsym hirr).shadowCoeff_nat i

/-- info: 'FormalResearch.NQubit.Graph.graphStateNorm_isStabilizerState' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms graphStateNorm_isStabilizerState

end FormalResearch.NQubit.Graph
