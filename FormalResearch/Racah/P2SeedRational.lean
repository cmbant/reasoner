module

public import Mathlib
public import FormalResearch.Racah.P2SeedMultiplierLink

/-!
# Rationality of the multipliers `ψ_{2r}` of the `3j` all-order calculus, in every chamber (Weyl P2)

Source: `Weyl/P2/paper/weyl_midpoint_recoupling.tex`, `app:3j-allorder`: `prop:localcalculus` (b),
`eq:3jpsi2r`, `eq:3jseedlogallorder` and the sentence "this `ψ_{2r}` is rational on the interior, and exact
Regge and transposition covariance extends the same operator to every nondegenerate sign/order chamber";
`thm:3jallorderlocal` ("generated by rational functions of `x`").

`P2SeedMultiplierLink` formalised the operators `𝒢_r` of the `3j` all-order calculus with coefficients
*smooth* on `(-1,1)`, and the seed-row multiplier `φ_{r+1} = κ_{r+1} - 𝒥(𝖡_{r+1}) d_M / d_M` for the extremal
chamber `M ≥ |σ|` only.  This file proves, for `M ± σ` integers with `L₀ = max(|M|,|σ|) > 0`
(all chambers, all half-integer labels):

* `link3_zero_all` (**the seed-row link in every chamber**): for `α = |M-σ|`, `β = |M+σ|`,
  `f_{2r}^{(0)}(x) = κ_r(x) d^{L₀}_{Mσ}(x)` on `(-1,1)`, `κ_r = [t^r] exp(∑ ℓ_s t^s)` (`expCoeff (seedEll α β) r`).
  The extremal chamber is `f3even_zero_eq_expCoeff_mul`; the other chambers follow by the exact
  Regge, sign and transposition scalings of `f3even` (`f3even_regge`, `f3even_negMσ`, `f3even_swap`), under which
  the pair `(α, β)` and the multiplier ratio `f_{2r}^{(0)}/f_0^{(0)}` are unchanged.
* `isRat_expCoeff_seedEll`: `κ_r` is a rational function `p(x)/(1-x²)^m` (poles at `x = ±1` only).
* `DOp_dv_zero_rat`: `∂ d_{L₀} = w d_{L₀}` with `w = ((β-α) - (α+β)x)/(2(1-x²))` rational
  (the paper's `d_m'/d_m = (n-mx)/(1-x²)`, every chamber).
* `allorder_operators_seed_psi_rat` (**`thm:3jallorderlocal`, rational form**): the operators `𝒢_r` of
  `allorder_operators` can be taken left-normal with *rational* coefficients (`LN DOp Crat`, `Crat` the multiplication
  operators by `p(x)/(1-x²)^m`), with `[x, 𝒢_{r+1}] = 𝖡_{r+1}`, `𝒢_r d_n = f_{2r}^{(n)}` at every rank, and the
  multiplier `ψ_{r+1} = 𝒢_{r+1} - 𝒥(𝖡_{r+1})` is multiplication by a rational function
  `φ = κ_{r+1} - 𝒥(𝖡_{r+1}) d_{L₀}/d_{L₀}` (`eq:3jpsi2r`).

Claim class: proved (no hypothesis beyond `M ± σ ∈ ℤ`, `L₀ > 0`).  Not covered: the `M = σ = 0` two-start case
(`P2SeedZeroPsi`), explicit forms of `ψ_{2r}`.
-/

@[expose] public section

namespace FormalResearch.Racah.LocalCalculus.Fun

open Set Module FormalResearch.Wigner FormalResearch.Racah FormalResearch.Asymptotics
open scoped ContDiff

/-! ### The algebra of rational functions with poles at `±1` -/

/-- The functions `p(x)/(1-x²)^m` on `(-1,1)` form a subalgebra of `ℝ → ℝ`. -/
def ratAlg : Subalgebra ℝ (ℝ → ℝ) where
  carrier := {φ | IsRat φ}
  mul_mem' := fun {φ ψ} ⟨p, m, hp⟩ ⟨q, n, hq⟩ =>
    ⟨p * q, m + n, fun y hy => by
      simp [Pi.mul_apply, hp y hy, hq y hy, pow_add, div_mul_div_comm]⟩
  one_mem' := ⟨1, 0, fun y hy => by simp⟩
  add_mem' := fun {φ ψ} ⟨p, m, hp⟩ ⟨q, n, hq⟩ =>
    ⟨p * (1 - Polynomial.X ^ 2) ^ n + q * (1 - Polynomial.X ^ 2) ^ m, m + n, fun y hy => by
      have h1 : 1 - y ^ 2 ≠ 0 := by nlinarith [hy.1, hy.2]
      simp only [Pi.add_apply, hp y hy, hq y hy]
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_pow,
        Polynomial.eval_sub, Polynomial.eval_one, Polynomial.eval_X, pow_add]
      field_simp⟩
  zero_mem' := ⟨0, 0, fun y hy => by simp⟩
  algebraMap_mem' := fun c => ⟨Polynomial.C c, 0, fun y hy => by simp⟩

lemma mem_ratAlg {φ : ℝ → ℝ} : φ ∈ ratAlg ↔ IsRat φ := Iff.rfl

lemma isRat_id : IsRat (fun y : ℝ => y) := ⟨Polynomial.X, 0, fun y hy => by simp⟩

lemma isRat_const (c : ℝ) : IsRat (fun _ : ℝ => c) := ⟨Polynomial.C c, 0, fun y hy => by simp⟩

/-- `1/((1-y)/2)^k` is rational. -/
lemma isRat_inv_minus (k : ℕ) : IsRat (fun y : ℝ => 1 / ((1 - y) / 2) ^ k) :=
  ⟨Polynomial.C ((2 : ℝ) ^ k) * (1 + Polynomial.X) ^ k, k, fun y hy => by
    have h1 : 1 - y ≠ 0 := by linarith [hy.2]
    have h2 : 1 + y ≠ 0 := by linarith [hy.1]
    have : 1 - y ^ 2 = (1 - y) * (1 + y) := by ring
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_add,
      Polynomial.eval_one, Polynomial.eval_X, this]
    rw [mul_pow, div_pow]
    field_simp⟩

/-- `1/((1+y)/2)^k` is rational. -/
lemma isRat_inv_plus (k : ℕ) : IsRat (fun y : ℝ => 1 / ((1 + y) / 2) ^ k) :=
  ⟨Polynomial.C ((2 : ℝ) ^ k) * (1 - Polynomial.X) ^ k, k, fun y hy => by
    have h1 : 1 - y ≠ 0 := by linarith [hy.2]
    have h2 : 1 + y ≠ 0 := by linarith [hy.1]
    have : 1 - y ^ 2 = (1 - y) * (1 + y) := by ring
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_sub,
      Polynomial.eval_one, Polynomial.eval_X, this]
    rw [mul_pow, div_pow]
    field_simp⟩

/-- The coefficients `κ_r = [X^r] exp(∑ a_s X^s)` of rational `a_s` are rational. -/
theorem isRat_expCoeff {a : ℕ → ℝ → ℝ} (ha : ∀ s, IsRat (a s)) (r : ℕ) : IsRat (expCoeff a r) := by
  have hpow : ∀ n r : ℕ, IsRat (fun z => PowerSeries.coeff r (coeffSeries a z ^ n)) := by
    intro n
    induction n with
    | zero =>
      intro r
      simp only [pow_zero, PowerSeries.coeff_one]
      exact isRat_const _
    | succ n ih =>
      intro r
      have : (fun z => PowerSeries.coeff r (coeffSeries a z ^ (n + 1))) =
          ∑ p ∈ Finset.HasAntidiagonal.antidiagonal r,
            (fun z => PowerSeries.coeff p.1 (coeffSeries a z ^ n)) * (fun z => a p.2 z) := by
        funext z
        simp only [pow_succ, PowerSeries.coeff_mul, Finset.sum_apply, Pi.mul_apply, coeffSeries,
          PowerSeries.coeff_mk]
      rw [this]
      exact ratAlg.sum_mem fun p _ => ratAlg.mul_mem (ih p.1) (ha p.2)
  have : expCoeff a r = ∑ n ∈ Finset.range (r + 1),
      algebraMap ℝ (ℝ → ℝ) ((n.factorial : ℝ))⁻¹ * (fun z => PowerSeries.coeff r (coeffSeries a z ^ n)) := by
    funext z
    simp [expCoeff, expSeries]
  rw [this]
  exact ratAlg.sum_mem fun n _ => ratAlg.mul_mem (ratAlg.algebraMap_mem _) (hpow n r)

/-- `ℓ_r = seedEll α β r` is rational. -/
theorem isRat_seedEll (α β r : ℕ) : IsRat (seedEll α β r) := by
  have h1 := isRat_inv_minus (2 * r)
  have h2 := isRat_inv_plus (2 * r)
  have : seedEll α β r = fun x => 1 / (4 * (r : ℝ)) * (centeredPowerSum (α + β + 1) (2 * r) -
      centeredPowerSum α (2 * r) * (1 / ((1 - x) / 2) ^ (2 * r)) -
      centeredPowerSum β (2 * r) * (1 / ((1 + x) / 2) ^ (2 * r))) := by
    funext x; simp only [seedEll]; ring
  rw [this]
  have hc : ∀ c : ℝ, IsRat (fun _ : ℝ => c) := isRat_const
  have := ratAlg.mul_mem (ratAlg.algebraMap_mem (1 / (4 * (r : ℝ))))
    (ratAlg.sub_mem (ratAlg.sub_mem (hc (centeredPowerSum (α + β + 1) (2 * r)))
      (ratAlg.mul_mem (hc (centeredPowerSum α (2 * r))) h1))
      (ratAlg.mul_mem (hc (centeredPowerSum β (2 * r))) h2))
  refine (mem_ratAlg).1 (by convert this using 1; funext x; simp [Algebra.algebraMap_eq_smul_one])

theorem isRat_expCoeff_seedEll (α β r : ℕ) : IsRat (expCoeff (seedEll α β) r) :=
  isRat_expCoeff (fun s => isRat_seedEll α β s) r

/-! ### The seed-row link in every chamber -/

section Link

variable {M σ : ℚ} {α β : ℕ}

private lemma pPlus3_of_abs (hα : |M - σ| = α) : pPlus3 M σ = α := by
  unfold pPlus3; rw [hα]; exact Nat.floor_natCast α

private lemma pMinus3_of_abs (hβ : |M + σ| = β) : pMinus3 M σ = β := by
  unfold pMinus3; rw [hβ]; exact Nat.floor_natCast β

/-- Transfer of the seed-row link along an exact scaling `f_{2r}'^{(0)} = s f_{2r}^{(0)}`. -/
lemma link3_transfer {M' σ' : ℚ} (s : ℝ) (hs : ∀ r y, f3even M' σ' 0 r y = s * f3even M σ 0 r y)
    {α β : ℕ} (h : ∀ r, ∀ y ∈ Sx, f3even M σ 0 r y = expCoeff (seedEll α β) r y * f3even M σ 0 0 y)
    (r : ℕ) {y : ℝ} (hy : y ∈ Sx) :
    f3even M' σ' 0 r y = expCoeff (seedEll α β) r y * f3even M' σ' 0 0 y := by
  rw [hs r y, hs 0 y, h r y hy]; ring

private lemma sign_sq (n : ℕ) : ((-1 : ℝ) ^ n) * ((-1 : ℝ) ^ n) = 1 := by
  rw [← mul_pow]; norm_num

/-- **The seed-row link in every chamber**: for `α = |M-σ|`, `β = |M+σ|` natural (and `M ± σ`
integers in the physical setting; no further hypothesis), `f_{2r}^{(0)}(x) = κ_r(x) f_0^{(0)}(x)`
on `(-1,1)`, with `κ_r = expCoeff (seedEll α β) r`. -/
theorem link3_zero_all (hα : |M - σ| = α) (hβ : |M + σ| = β) (r : ℕ) {y : ℝ} (hy : y ∈ Sx) :
    f3even M σ 0 r y = expCoeff (seedEll α β) r y * f3even M σ 0 0 y := by
  -- base case: the extremal chamber
  have base : ∀ (M σ : ℚ) (α β : ℕ), M - σ = α → M + σ = β → ∀ r, ∀ y ∈ Sx,
      f3even M σ 0 r y = expCoeff (seedEll α β) r y * f3even M σ 0 0 y := by
    intro M σ α β h1 h2 r y hy
    rw [f3even_zero_eq_expCoeff_mul h1 h2 r hy,
      f3even_zero_zero_apply (abs_chamber h1) (abs_chamber h2) hy,
      dv_zero_eq_wignerSmallDx h1 h2 hy]
  by_cases hA : |σ| ≤ M
  · have h1 : M - σ = α := by
      rw [← hα]; exact (abs_of_nonneg (by linarith [le_abs_self σ])).symm
    have h2 : M + σ = β := by
      rw [← hβ]; exact (abs_of_nonneg (by linarith [neg_abs_le σ])).symm
    exact base M σ α β h1 h2 r y hy
  by_cases hC : |σ| ≤ -M
  · -- `(M,σ) ↦ (-M,-σ)`
    have h1 : (-M) - (-σ) = α := by
      rw [← hα, abs_sub_comm, show -M - -σ = σ - M by ring]
      exact (abs_of_nonneg (by linarith [le_abs_self σ, neg_abs_le σ])).symm
    have h2 : (-M) + (-σ) = β := by
      rw [← hβ, ← abs_neg, show -(M + σ) = -M + -σ by ring]
      exact (abs_of_nonneg (by linarith [le_abs_self σ, neg_abs_le σ])).symm
    refine link3_transfer (M := -M) (σ := -σ) ((-1 : ℝ) ^ pPlus3 M σ) (fun r y => ?_)
      (base (-M) (-σ) α β h1 h2) r hy
    rw [f3even_negMσ M σ 0 r y]
    calc f3even M σ 0 r y = ((-1 : ℝ) ^ pPlus3 M σ * (-1 : ℝ) ^ pPlus3 M σ) * f3even M σ 0 r y := by
          rw [sign_sq, one_mul]
      _ = _ := by ring
  have hlt : |M| < |σ| := by
    by_contra hc
    rw [not_lt] at hc
    rcases abs_cases M with ⟨h, _⟩ | ⟨h, _⟩
    · exact hA (by linarith)
    · exact hC (by linarith)
  by_cases hσ : 0 ≤ σ
  · -- `(M,σ) ↦ (σ,M)`
    have hM : |M| ≤ σ := by rw [abs_of_nonneg hσ] at hlt; exact hlt.le
    have h1 : σ - M = α := by
      rw [← hα, abs_sub_comm]
      exact (abs_of_nonneg (by linarith [le_abs_self M, neg_abs_le M])).symm
    have h2 : σ + M = β := by
      rw [← hβ, add_comm]
      exact (abs_of_nonneg (by linarith [le_abs_self M, neg_abs_le M])).symm
    refine link3_transfer (M := σ) (σ := M) ((-1 : ℝ) ^ pPlus3 M σ) (fun r y => ?_)
      (base σ M α β h1 h2) r hy
    rw [f3even_swap M σ 0 r y]
    calc f3even M σ 0 r y = ((-1 : ℝ) ^ pPlus3 M σ * (-1 : ℝ) ^ pPlus3 M σ) * f3even M σ 0 r y := by
          rw [sign_sq, one_mul]
      _ = _ := by ring
  · -- `(M,σ) ↦ (-σ,-M)`
    have hσ' : σ < 0 := not_le.mp hσ
    have hM : |M| ≤ -σ := by rw [abs_of_neg hσ'] at hlt; exact hlt.le
    have h1 : (-σ) - (-M) = α := by
      rw [← hα, show -σ - -M = M - σ by ring]
      exact (abs_of_nonneg (by linarith [le_abs_self M, neg_abs_le M])).symm
    have h2 : (-σ) + (-M) = β := by
      rw [← hβ, ← abs_neg, show -(M + σ) = -σ + -M by ring]
      exact (abs_of_nonneg (by linarith [le_abs_self M, neg_abs_le M])).symm
    refine link3_transfer (M := -σ) (σ := -M) 1 (fun r y => ?_) (base (-σ) (-M) α β h1 h2) r hy
    rw [f3even_regge M σ 0 r y, one_mul]

end Link

/-! ### The logarithmic derivative of `d_{L₀}` -/

section LogDeriv

variable {M σ : ℚ} {α β : ℕ}

private lemma nat_mul_pow_pred {a : ℝ} (ha : a ≠ 0) (n : ℕ) :
    (n : ℝ) * a ^ (n - 1) = n * a ^ n / a := by
  cases n with
  | zero => simp
  | succ k => simp only [Nat.add_sub_cancel, pow_succ]; field_simp

/-- **`d_m'/d_m = (n-mx)/(1-x²)`** for the extremal Wigner function of every chamber:
`d_{L₀}'(x)/d_{L₀}(x) = ((β-α) - (α+β)x)/(2(1-x²))`, `α = |M-σ|`, `β = |M+σ|`. -/
theorem dv_zero_logderiv (hα : |M - σ| = α) (hβ : |M + σ| = β) {y : ℝ} (hy : y ∈ Sx) :
    deriv (dv M σ 0).1 y / (dv M σ 0).1 y =
      (((β : ℝ) - α) - (α + β) * y) / (2 * (1 - y ^ 2)) := by
  have ha : 0 < (1 - y) / 2 := by linarith [hy.2]
  have hb : 0 < (1 + y) / 2 := by linarith [hy.1]
  have h1 : HasDerivAt (fun z : ℝ => (1 - z) / 2) (-(1 / 2)) y := by
    exact (((hasDerivAt_id y).const_sub 1).div_const 2).congr_deriv (by norm_num)
  have h2 : HasDerivAt (fun z : ℝ => (1 + z) / 2) (1 / 2) y := by
    exact (((hasDerivAt_id y).const_add 1).div_const 2).congr_deriv (by norm_num)
  have hP : HasDerivAt (fun z : ℝ => ((1 - z) / 2) ^ α * ((1 + z) / 2) ^ β)
      (((α : ℝ) * ((1 - y) / 2) ^ (α - 1) * (-(1 / 2))) * ((1 + y) / 2) ^ β +
        ((1 - y) / 2) ^ α * ((β : ℝ) * ((1 + y) / 2) ^ (β - 1) * (1 / 2))) y :=
    (h1.pow α).mul (h2.pow β)
  have hPpos : 0 < ((1 - y) / 2) ^ α * ((1 + y) / 2) ^ β := by positivity
  have hs := (hP.sqrt hPpos.ne').const_mul (seed3 M σ)
  have hev : (dv M σ 0).1 =ᶠ[nhds y] fun z => seed3 M σ * Real.sqrt (((1 - z) / 2) ^ α * ((1 + z) / 2) ^ β) :=
    Filter.eventually_of_mem (isOpen_Sx.mem_nhds hy) fun z hz => by
      rw [dv_zero_apply hα hβ hz, pPlus3_of_abs hα, pMinus3_of_abs hβ]
  rw [hev.deriv_eq, hs.deriv, dv_zero_apply hα hβ hy, pPlus3_of_abs hα, pMinus3_of_abs hβ]
  have hc := seed3_ne_zero M σ
  have hsq : Real.sqrt (((1 - y) / 2) ^ α * ((1 + y) / 2) ^ β) ≠ 0 := (Real.sqrt_pos.mpr hPpos).ne'
  have hsq2 := Real.sq_sqrt hPpos.le
  set s := Real.sqrt (((1 - y) / 2) ^ α * ((1 + y) / 2) ^ β)
  have e1 : seed3 M σ * ((((α : ℝ) * ((1 - y) / 2) ^ (α - 1) * (-(1 / 2))) * ((1 + y) / 2) ^ β +
      ((1 - y) / 2) ^ α * ((β : ℝ) * ((1 + y) / 2) ^ (β - 1) * (1 / 2))) / (2 * s)) /
      (seed3 M σ * s) =
      (((α : ℝ) * ((1 - y) / 2) ^ (α - 1) * (-(1 / 2))) * ((1 + y) / 2) ^ β +
      ((1 - y) / 2) ^ α * ((β : ℝ) * ((1 + y) / 2) ^ (β - 1) * (1 / 2))) /
        (2 * (((1 - y) / 2) ^ α * ((1 + y) / 2) ^ β)) := by
    rw [← hsq2]; field_simp
  rw [e1, nat_mul_pow_pred ha.ne' α, nat_mul_pow_pred hb.ne' β]
  have h1y : 1 - y ≠ 0 := by linarith [hy.2]
  have h2y : 1 + y ≠ 0 := by linarith [hy.1]
  have h3y : 1 - y ^ 2 ≠ 0 := by nlinarith [hy.1, hy.2]
  field_simp
  ring

/-- `d_{L₀}'/d_{L₀}` is rational. -/
theorem isRat_dv_zero_logderiv (hα : |M - σ| = α) (hβ : |M + σ| = β) :
    IsRat (fun y => deriv (dv M σ 0).1 y / (dv M σ 0).1 y) :=
  ⟨Polynomial.C (1 / 2) * (Polynomial.C ((β : ℝ) - α) - Polynomial.C ((α : ℝ) + β) * Polynomial.X),
    1, fun y hy => by
      show deriv (dv M σ 0).1 y / (dv M σ 0).1 y = _
      rw [dv_zero_logderiv hα hβ hy]
      have h3y : 1 - y ^ 2 ≠ 0 := by nlinarith [hy.1, hy.2]
      simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_sub, Polynomial.eval_X, pow_one]
      field_simp⟩

/-- `∂ d_{L₀} = w d_{L₀}` with a rational multiplier `w` (`w ∈ Crat`). -/
theorem DOp_dv_zero_rat (hα : |M - σ| = α) (hβ : |M + σ| = β) :
    ∃ w ∈ Crat, DOp (dv M σ 0) = w (dv M σ 0) :=
  ⟨mulOp (fun y => deriv (dv M σ 0).1 y / (dv M σ 0).1 y)
      (contDiffOn_div_dv0 hα hβ (dv M σ 0).contDiffOn_deriv),
    ⟨_, isRat_dv_zero_logderiv hα hβ, fun _ _ => rfl⟩, DOp_dv_zero hα hβ⟩

end LogDeriv

/-! ### The rational all-order operators -/

section Main

variable {M σ : ℚ} {α β : ℕ}

/-- The multiplier `κ_r = f_{2r}^{(0)}/d_{L₀}` is rational (every chamber). -/
theorem isRat_kap (hα : |M - σ| = α) (hβ : |M + σ| = β) (r : ℕ) :
    IsRat (fun y => f3even M σ 0 r y / (dv M σ 0).1 y) := by
  obtain ⟨p, m, hp⟩ := isRat_expCoeff_seedEll α β r
  refine ⟨p, m, fun y hy => ?_⟩
  show f3even M σ 0 r y / (dv M σ 0).1 y = _
  rw [link3_zero_all hα hβ r hy, f3even_zero_zero_apply hα hβ hy, mul_div_assoc,
    div_self (dv_zero_ne_zero hα hβ hy), mul_one, hp y hy]

/-- **`thm:3jallorderlocal` with rational coefficients, and `eq:3jpsi2r` with rational `ψ_{2r}`**
(`L₀ = max(|M|,|σ|) > 0`, `α = |M-σ|`, `β = |M+σ|` natural; every chamber, in particular all half-integer
labels).  There are operators `𝒢_r` (`𝒢_0 = I`) on functions on `(-1,1)`, rank-independent, left-normal with
*rational* coefficients `p(x)/(1-x²)^m` (`LN DOp Crat`), with `[x, 𝒢_{r+1}] = 𝖡_{r+1}` (`eq:3jB2r`, `q = 0`,
`e_s = c_s`), such that `𝒢_r d_n = f_{2r}^{(n)}` on `(-1,1)` at every rank `n` (so
`Φ_L = ∑_r t^r 𝒢_r d_L` as formal series), and for every `r` the multiplier
`ψ_{r+1} = 𝒢_{r+1} - 𝒥(𝖡_{r+1})` of the recursion `𝒢_{r+1} = 𝒥(𝖡_{r+1}) + ψ_{r+1}` is multiplication by a
rational function `φ` with `φ = κ_{r+1} - 𝒥(𝖡_{r+1}) d_{L₀}/d_{L₀}` on `(-1,1)`,
`κ_{r+1} = [t^{r+1}] exp(∑ ℓ_s t^s)` (`eq:3jseedlogallorder`).  (`𝒥 = Jsol` is a left-normal solution of
`[x, 𝒥(𝖡)] = 𝖡`.) -/
theorem allorder_operators_seed_psi_rat (hα : |M - σ| = α) (hβ : |M + σ| = β)
    (hL : 0 < max |M| |σ|) :
    ∃ G : ℕ → End ℝ Fn, G 0 = 1 ∧ (∀ r, G r ∈ LN DOp Crat) ∧
      (∀ r, comm xOp (G (r + 1)) =
        Bop xOp (Hop (SigM M σ) (TauM M σ)) (0 : Polynomial ℝ) c3 (TauM M σ) G r) ∧
      (∀ n r, ∀ y ∈ Sx, (G r (dv M σ n)).1 y = f3even M σ n r y) ∧
      ∀ r, ∃ φ : ℝ → ℝ, IsRat φ ∧
        (∀ (f : Fn) (y : ℝ), ((G (r + 1) - Jsol xOp DOp Crat (Bop xOp (Hop (SigM M σ) (TauM M σ))
          (0 : Polynomial ℝ) c3 (TauM M σ) G r)) f).1 y = φ y * f.1 y) ∧
        ∀ y ∈ Sx, φ y = expCoeff (seedEll α β) (r + 1) y -
          (Jsol xOp DOp Crat (Bop xOp (Hop (SigM M σ) (TauM M σ)) (0 : Polynomial ℝ) c3 (TauM M σ) G r)
            (dv M σ 0)).1 y / (dv M σ 0).1 y := by
  have hk : 0 < kz M σ := by unfold kz; exact_mod_cast hL
  have hfwd : ∀ n : ℕ, (kz M σ + n) * Rn M σ (n + 1) ≠ 0 := by
    intro n
    have hR : 0 < Rn M σ (n + 1) := by
      unfold Rn
      refine Rk_pos M σ _ ?_
      have : (0 : ℚ) < ((n + 1 : ℕ) : ℚ) := by positivity
      linarith
    have : 0 < kz M σ + n := by positivity
    exact (mul_pos this hR).ne'
  obtain ⟨w, hw, hdw⟩ := DOp_dv_zero_rat hα hβ
  have hkapC : ∀ r, kap hα hβ r ∈ Crat := fun r => ⟨_, isRat_kap hα hβ r, fun _ _ => rfl⟩
  obtain ⟨G, hG0, hGm, hGB, hGκ, hGψ⟩ := LocalCalculus.local_calculus_start (D := DOp) (C := Crat)
    (x := xOp) DOp_xOp (fun c hc => comm_x_Crat hc) (fun c hc => comm_Crat hc) xOp_mem_Crat
    (Hop_mem_LN_rat (SigM M σ) (TauM M σ)) (0 : Polynomial ℝ) c3 (TauM M σ) (d0 := dv M σ 0)
    hw hdw (kap hα hβ) hkapC (kap_zero hα hβ)
  have hranks := LocalCalculus.local_calculus_ranks xOp (Hop (SigM M σ) (TauM M σ)) (0 : Polynomial ℝ)
    c3 c3_zero G hG0 (TauM M σ) (kz M σ) (Rn M σ) (dv M σ) (Hop_dv M σ) (dv_rec M σ) hGB
  have hu := LocalCalculus.rank_unique_of_start xOp (0 : Polynomial ℝ) c3 c3_zero (TauM M σ) (kz M σ)
    (Rn M σ) (Rn_zero M σ) hfwd (physFn_rankDefect hα hβ) hranks (by
      rw [physFn_zero_eq_kap hα hβ]
      funext r
      exact (hGκ r).symm)
  have hid : ∀ n r, ∀ y ∈ Sx, (G r (dv M σ n)).1 y = f3even M σ n r y := by
    intro n r y hy
    have := congrFun (congrFun hu n) r
    rw [← physFn_apply (M := M) (σ := σ) n r hy, this]
    rfl
  refine ⟨G, hG0, hGm, hGB, hid, fun r => ?_⟩
  obtain ⟨ψ, ⟨φ, hφ, hψφ⟩, hGs, hψd⟩ := hGψ r
  refine ⟨φ, hφ, fun f y => ?_, fun y hy => ?_⟩
  · have e : G (r + 1) - Jsol xOp DOp Crat (Bop xOp (Hop (SigM M σ) (TauM M σ)) (0 : Polynomial ℝ) c3
        (TauM M σ) G r) = ψ := by rw [hGs]; abel
    rw [e]
    exact hψφ f y
  · have h1 := hψφ (dv M σ 0) y
    rw [hψd] at h1
    have hd := dv_zero_ne_zero hα hβ hy
    have h3 : (kap hα hβ (r + 1) (dv M σ 0)).1 y = expCoeff (seedEll α β) (r + 1) y * (dv M σ 0).1 y := by
      show f3even M σ 0 (r + 1) y / (dv M σ 0).1 y * (dv M σ 0).1 y = _
      rw [link3_zero_all hα hβ (r + 1) hy, f3even_zero_zero_apply hα hβ hy, div_mul_cancel₀ _ hd]
    have h1' : (kap hα hβ (r + 1) (dv M σ 0)).1 y -
        (Jsol xOp DOp Crat (Bop xOp (Hop (SigM M σ) (TauM M σ)) (0 : Polynomial ℝ) c3 (TauM M σ) G r)
          (dv M σ 0)).1 y = φ y * (dv M σ 0).1 y := h1
    rw [h3] at h1'
    field_simp
    linarith

end Main

